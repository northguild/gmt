{
  // `vitest bench` runs these; no plugin finds them. The browser twins and the worker are served
  // by name from vitest.browser.config.ts and loaded by URL, which no import graph shows. The
  // native vitest configs load nativeTemporal.ts through an alias of `@js-temporal/polyfill`, and
  // vitest loads the native-suite reporter by path.
  "entry": [
    "packages/gmt/src/test/nativeTemporal.ts",
    "scripts/lib/native-suite-reporter.mjs",
    // The weekly D23/D24 locale sweep (CORE-112), run by hand or from a workflow.
    "scripts/canary/weekYear.mjs",
    // The weekly D29 range sweep (CORE-112); it starts itself as a child process.
    "scripts/canary/rangeFields.mjs",
    "packages/gmt/bench/*.bench.ts",
    "packages/gmt/src/test/*.browser.ts",
    "packages/gmt/src/test/boundedWorker.ts",
  ],
  // The browser provider is a root devDependency used by packages/gmt/vitest.browser.config.ts.
  "ignoreDependencies": [
    "@tanstack/intent",
    "@northguild/gmt-oxlint",
    "@vitest/browser-playwright",
  ],
  // The behaviour-matrix runner has its own package.json and lockfile outside the workspace.
  "ignorePatterns": ["oxlint.config.js", "scripts/behaviour-matrix/**"],
  "ignoreUnresolvedImports": ["./packages/gmt-oxlint/dist/index.js"],
  "ignoreExports": [
    {
      "file": "packages/gmt-oxlint/src/utils/index.ts",
      "exports": ["isChainExpression", "isMemberExpression"],
    },
    {
      "file": "packages/gmt/src/internal/index.ts",
      "exports": ["isCalendarSystem", "temporalCalendarIds"],
    },
  ],
  "duplicates": {
    "mode": "mild",
    "minOccurrences": 2,
    "ignoreImports": true,
    "ignoredClones": [],
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "maxUnitSize": 60,
    "thresholdOverrides": [
      {
        "files": ["packages/gmt/src/internal/weekYearRange.ts"],
        "functions": [
          "farRange",
          "shiftYears",
          "digitsMatch",
          "computeShift",
          "movedLikeYear",
          "signOf",
        ],
        "maxCrap": 70,
        "reason": "D24 range verdict: cyclomatic and cognitive are inside the limits; the CRAP figure is estimated from export references because these helpers are not exported, and weekYearRange.test.ts covers every branch through rangeYearVerdict",
      },
      {
        "files": ["packages/gmt/src/internal/rangeDetector.ts"],
        "functions": [
          "judge",
          "rangeVerdict",
          "isAbsent",
          "probeKind",
          "<arrow>",
        ],
        "maxCyclomatic": 30,
        "maxCognitive": 30,
        "maxCrap": 150,
        "reason": "D29 range detector kernel: judge and the per-probe check branch once per field class (year, month, day, day period, hour, minute, era); rangeDetector.test.ts covers each verdict and its broken field class, and the three-engine sweep exercises every branch, while fallow estimates CRAP from export references because the helpers are not exported",
      },
      {
        "files": ["packages/gmt/src/internal/rangeFieldValues.ts"],
        "functions": ["rowsOf"],
        "maxCrap": 40,
        "reason": "D29 field-value rows (ECMA-402 Table 6): cyclomatic 11 and cognitive 8 are inside the limits, and the CRAP figure is estimated from export references because rowsOf is unexported; rangeFields.test.ts and yearPrinting.test.ts reach every row through rangeFieldsEqual",
      },
      {
        "files": ["packages/gmt/src/internal/weekYearSynth.ts"],
        "functions": ["textTwinOptions", "timeTwinOptions", "fits"],
        "maxCrap": 40,
        "reason": "D23 week-year parts synthesis: cyclomatic 10 and cognitive at most 13 are inside the limits, and the CRAP figure is estimated from export references because each helper is unexported; weekYearSingle.test.ts covers each branch through guardedDateTimeFormat",
      },
      {
        "files": [
          "packages/gmt/src/internal/yearPrinting.ts",
          "packages/gmt/src/zoned/format/formatZonedRange.ts",
        ],
        "functions": ["formatRange", "zonedRangeText", "twinParts"],
        "maxCrap": 70,
        "reason": "CORE-112 range repairs: cyclomatic (at most 11) and cognitive (at most 11) are inside the limits; the CRAP figure is estimated from export references because each is a closure or an unexported helper, and yearPrinting.test.ts, rangeFields.test.ts and formatZonedRange*.test.ts cover each branch through the public range functions",
      },
      {
        "files": ["packages/gmt/src/internal/patternToken.ts"],
        "functions": [
          "tokenizePattern",
          "resolvePatternFields",
          "compilePattern",
        ],
        "maxCyclomatic": 999,
        "maxCognitive": 999,
        "maxCrap": 999,
        "reason": "CRITICAL complexity in patternToken.ts — roadmap refactoring target, extraction deferred to separate PR",
      },
      {
        "files": ["packages/gmt/src/plain/interval/splitIntervalByUnitTime.ts"],
        "functions": ["splitIntervalByUnitTime"],
        "maxCyclomatic": 999,
        "maxCognitive": 999,
        "reason": "Cross-family clone with inherent Temporal type branching (rule #5); inherent complexity",
      },
      {
        "files": ["scripts/api-surface.mjs"],
        "functions": [
          "addPageRelativeLinks",
          "arity",
          "blockImports",
          "callReadsClock",
          "checkSiteLinks",
          "codeBlocks",
          "documentedResult",
          "isOneCall",
          "joinContinuedResult",
          "judgeDocumentedResults",
          "judgeExample",
          "judgeStatement",
          "publicSourceFiles",
          "siteLinksIn",
          "statementEnd",
          "unquoted",
        ],
        "maxCrap": 999,
        "reason": "Repo tooling outside the Vitest suite: with no coverage data CRAP is cyclomatic² + cyclomatic, so any function with 5+ branches exceeds 30 whatever its size. Cyclomatic and cognitive limits still apply, and `api-surface show` output is the regression check.",
      },
    ],
  },
}
