{
  // `vitest bench` runs these; no plugin finds them. The browser twins and the worker are served
  // by name from vitest.browser.config.ts and loaded by URL, which no import graph shows. The
  // native vitest configs load nativeTemporal.ts through an alias of `@js-temporal/polyfill`, and
  // vitest loads the native-suite reporter by path.
  "entry": [
    "packages/gmt/src/test/nativeTemporal.ts",
    "scripts/lib/native-suite-reporter.mjs",
    "packages/gmt/bench/*.bench.ts",
    "packages/gmt/src/test/*.browser.ts",
    "packages/gmt/src/test/boundedWorker.ts",
  ],
  // The browser provider is a root devDependency used by packages/gmt/vitest.browser.config.ts.
  "ignoreDependencies": [
    "@tanstack/intent",
    "@northguild/gmt-oxlint",
    "@vitest/browser-playwright",
  ],
  // The behaviour-matrix runner has its own package.json and lockfile outside the workspace.
  "ignorePatterns": ["oxlint.config.js", "scripts/behaviour-matrix/**"],
  "ignoreUnresolvedImports": ["./packages/gmt-oxlint/dist/index.js"],
  "ignoreExports": [
    {
      "file": "packages/gmt-oxlint/src/utils/index.ts",
      "exports": ["isChainExpression", "isMemberExpression"],
    },
    {
      "file": "packages/gmt/src/internal/index.ts",
      "exports": ["isCalendarSystem", "temporalCalendarIds"],
    },
  ],
  "duplicates": {
    "mode": "mild",
    "minOccurrences": 2,
    "ignoreImports": true,
    "ignoredClones": [],
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "maxUnitSize": 60,
    "thresholdOverrides": [
      {
        "files": ["packages/gmt/src/internal/patternToken.ts"],
        "functions": [
          "tokenizePattern",
          "resolvePatternFields",
          "compilePattern",
        ],
        "maxCyclomatic": 999,
        "maxCognitive": 999,
        "maxCrap": 999,
        "reason": "CRITICAL complexity in patternToken.ts — roadmap refactoring target, extraction deferred to separate PR",
      },
      {
        "files": ["packages/gmt/src/plain/interval/splitIntervalByUnitTime.ts"],
        "functions": ["splitIntervalByUnitTime"],
        "maxCyclomatic": 999,
        "maxCognitive": 999,
        "reason": "Cross-family clone with inherent Temporal type branching (rule #5); inherent complexity",
      },
      {
        "files": ["scripts/api-surface.mjs"],
        "functions": [
          "addPageRelativeLinks",
          "arity",
          "blockImports",
          "callReadsClock",
          "checkSiteLinks",
          "codeBlocks",
          "documentedResult",
          "isOneCall",
          "joinContinuedResult",
          "judgeDocumentedResults",
          "judgeExample",
          "judgeStatement",
          "publicSourceFiles",
          "siteLinksIn",
          "statementEnd",
          "unquoted",
        ],
        "maxCrap": 999,
        "reason": "Repo tooling outside the Vitest suite: with no coverage data CRAP is cyclomatic² + cyclomatic, so any function with 5+ branches exceeds 30 whatever its size. Cyclomatic and cognitive limits still apply, and `api-surface show` output is the regression check.",
      },
    ],
  },
}
