// Renovate (the Mend Renovate GitHub App) keeps dependencies current and raises security fixes.
// Use it instead of Dependabot version updates: running both opens two PRs for every bump. It reads GitHub's
// vulnerability alerts for the security fixes, so keep those alerts on.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    // One weekly PR for minor and patch updates outside the groups below. Majors get a PR each.
    "group:allNonMajor",
    "schedule:weekly",
    ":maintainLockFilesWeekly",
  ],
  dependencyDashboard: true,
  automerge: false,
  // pnpm refuses any release younger than its own minimumReleaseAge (1 day by default), so a
  // younger proposal would fail at install. Renovate adds a 30-minute buffer on top.
  minimumReleaseAge: "1 day",
  // Security fixes skip the weekly schedule and get a PR at once, but still wait out pnpm's age.
  vulnerabilityAlerts: {
    minimumReleaseAge: "1 day",
  },
  // `group:allNonMajor` sets `groupSlug: "all-minor-patch"`, and Renovate names a group's branch
  // after its slug. Each group below sets its own slug, or its minor and patch updates would land
  // on the weekly branch.
  packageRules: [
    {
      // The behaviour matrix pins the versions it measured; they move only with a re-run of the matrix.
      matchFileNames: ["scripts/behaviour-matrix/package.json"],
      enabled: false,
    },
    {
      groupName: "Astro",
      groupSlug: "astro",
      matchPackageNames: ["astro", "@astrojs/**"],
    },
    {
      groupName: "Vitest",
      groupSlug: "vitest",
      matchPackageNames: ["vitest", "@vitest/**"],
    },
    {
      groupName: "Playwright",
      groupSlug: "playwright",
      matchPackageNames: ["playwright", "@playwright/**"],
    },
    {
      groupName: "wrangler",
      groupSlug: "wrangler",
      matchPackageNames: ["wrangler"],
    },
    // These change what a published package ships, so the PR needs a changeset, which a
    // person adds. Kept apart so the weekly group passes CI on its own.
    {
      groupName: "published package dependencies",
      groupSlug: "published-deps",
      matchFileNames: [
        "packages/gmt/package.json",
        "packages/gmt-biome/package.json",
        "packages/gmt-eslint/package.json",
        "packages/gmt-oxlint/package.json",
      ],
      matchDepTypes: [
        "dependencies",
        "peerDependencies",
        "optionalDependencies",
      ],
    },
    // The supported Node versions are a product decision, made by hand.
    {
      matchDepTypes: ["engines"],
      enabled: false,
    },
    // @types/node follows the oldest supported Node, so its major moves with `engines`.
    {
      matchPackageNames: ["@types/node"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
  ],
}
