{
  "singleQuote": false,
  "printWidth": 80,
  "ignorePatterns": ["**/*.yaml", "**/*.md", "**/*.mdx"],
  "overrides": [
    {
      "files": ["packages/**/*.{ts,tsx,js,jsx,json,jsonc}"],
      "excludeFiles": [
        "**/node_modules/**",
        "**/dist/**",
        "**/.nx/**",
        "**/coverage/**",
        "**/*.tsbuildinfo",
        "**/out/**"
      ]
    },
    {
      "files": ["docs/**/*.{ts,tsx,js,jsx,md,mdx}"],
      "excludeFiles": [
        "**/node_modules/**",
        "**/dist/**",
        "**/.nx/**",
        "**/coverage/**",
        "**/*.tsbuildinfo",
        "**/out/**"
      ]
    },
    {
      "files": ["context/**/*.{ts,tsx,md}"],
      "excludeFiles": [
        "**/node_modules/**",
        "**/dist/**",
        "**/.nx/**",
        "**/coverage/**",
        "**/*.tsbuildinfo",
        "**/out/**"
      ]
    },
    {
      "files": ["scripts/**/*.{ts,tsx,js,mjs}"],
      "excludeFiles": [
        "**/node_modules/**",
        "**/dist/**",
        "**/.nx/**",
        "**/coverage/**",
        "**/*.tsbuildinfo",
        "**/out/**"
      ]
    },
    {
      "files": ["apps/**/*.{ts,tsx,js,jsx,mjs,json}"],
      "excludeFiles": [
        "**/node_modules/**",
        "**/dist/**",
        "**/.nx/**",
        "**/.astro/**",
        "**/coverage/**",
        "**/*.tsbuildinfo",
        "**/out/**",
        "apps/dox/src/generated/**"
      ]
    }
  ]
}
