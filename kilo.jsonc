{
  "$schema": "https://app.kilo.ai/config.json",
  "agent": {
    // The pipeline is the only orchestrator. It alone may `task` the specialists;
    // every specialist has `task` denied, so nothing spawns more than one level deep.
    // Models: planners, researcher and gmt-reviewer on Opus, workers on Sonnet (matches .agents/*.md frontmatter).
    "pipeline": {
      "description": "Pipeline — classifies a gmt or Dox request and dispatches the specialists in order",
      "mode": "primary",
      "prompt": "{file:.agents/skills/pipeline/SKILL.md}",
      "permission": {
        "task": {
          "*": "deny",
          "architect": "allow",
          "researcher": "allow",
          "tdd-dev": "allow",
          "tester": "allow",
          "gmt-reviewer": "allow",
          "finalizer": "allow",
          "dox-architect": "allow",
          "dox-builder": "allow",
          "dox-tester": "allow",
        },
      },
    },
    "architect": {
      "description": "Architect — planning and design for new GMT functions",
      "mode": "subagent",
      "model": "anthropic/claude-opus-5-5",
      "prompt": "{file:.agents/architect.md}",
      "permission": { "task": { "*": "deny" } },
    },
    "researcher": {
      "description": "Researcher — Temporal API docs lookup and legacy library comparisons",
      "mode": "subagent",
      "model": "anthropic/claude-opus-5-5",
      "prompt": "{file:.agents/researcher.md}",
      "permission": { "task": { "*": "deny" } },
    },
    "tdd-dev": {
      "description": "TDD Developer — test-first implementation cycle",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-5-5",
      "prompt": "{file:.agents/tdd-dev.md}",
      "permission": { "task": { "*": "deny" }, "mcp": "ask" },
    },
    "tester": {
      "description": "Tester — coverage audit and gap expansion",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-5-5",
      "prompt": "{file:.agents/tester.md}",
      "permission": { "task": { "*": "deny" }, "mcp": "ask" },
    },
    "gmt-reviewer": {
      "description": "GMT Reviewer — standards and domain-convention review, read-only",
      "mode": "subagent",
      "model": "anthropic/claude-opus-5-5",
      "prompt": "{file:.agents/gmt-reviewer.md}",
      "permission": { "task": { "*": "deny" }, "edit": "deny" },
    },
    "finalizer": {
      "description": "Finalizer — story closure, changesets, READMEs; drafts commit/PR text for the owner (never commits)",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-5-5",
      "prompt": "{file:.agents/finalizer.md}",
      "permission": { "task": { "*": "deny" } },
    },

    // Dox epic — the apps/dox documentation site. See context/dox/index.md.
    // Dox consumes @northguild/gmt, it does not change it. dox-architect returns
    // an execution spec; the pipeline then runs dox-builder and dox-tester.
    "dox-architect": {
      "description": "Dox Architect — plans Dox stories and writes the execution spec",
      "mode": "subagent",
      "model": "anthropic/claude-opus-5-5",
      "prompt": "{file:.agents/dox-architect.md}",
      "permission": { "task": { "*": "deny" } },
    },
    "dox-builder": {
      "description": "Dox Builder — executes a planned Dox story in apps/dox",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-5-5",
      "prompt": "{file:.agents/dox-builder.md}",
      "permission": { "task": { "*": "deny" } },
    },
    "dox-tester": {
      "description": "Dox Tester — verifies a Dox story against its Definition of Done",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-5-5",
      "prompt": "{file:.agents/dox-tester.md}",
      "permission": { "task": { "*": "deny" } },
    },
  },
}
