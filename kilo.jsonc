{
  "$schema": "https://app.kilo.ai/config.json",
  "agent": {
    "master": {
      "description": "Master Agent — single entry point, classifies requests and orchestrates the pipeline",
      "mode": "all",
      "prompt": "{file:.agents/master.md}",
      "permission": { "task": { "*": "deny", "driver": "allow" } },
    },
    "driver": {
      "description": "Driver — execution orchestrator, delegates to specialists",
      "mode": "all",
      "prompt": "{file:.agents/driver.md}",
      "permission": {
        "task": {
          "*": "deny",
          "architect": "allow",
          "researcher": "allow",
          "tdd-dev": "allow",
          "tester": "allow",
          "finalizer": "allow",
        },
      },
    },
    "architect": {
      "description": "Architect — planning and design for new GMT functions",
      "mode": "subagent",
      "prompt": "{file:.agents/architect.md}",
      "permission": { "task": { "*": "deny" } },
    },
    "researcher": {
      "description": "Researcher — Temporal API docs lookup and legacy library comparisons",
      "mode": "subagent",
      "prompt": "{file:.agents/researcher.md}",
      "permission": { "task": { "*": "deny" } },
    },
    "tdd-dev": {
      "description": "TDD Developer — test-first implementation cycle",
      "mode": "subagent",
      "prompt": "{file:.agents/tdd-dev.md}",
      "permission": { "task": { "*": "deny" }, "mcp": "ask" },
    },
    "tester": {
      "description": "Tester — coverage audit and gap expansion",
      "mode": "subagent",
      "prompt": "{file:.agents/tester.md}",
      "permission": { "task": { "*": "deny" }, "mcp": "ask" },
    },
    "finalizer": {
      "description": "Finalizer — story closure, changesets, READMEs, commits",
      "mode": "subagent",
      "prompt": "{file:.agents/finalizer.md}",
      "permission": { "task": { "*": "deny" } },
    },

    // Dox epic — the apps/dox documentation site. See context/dox/index.md.
    // Separate from the library pipeline above: Dox consumes @northguild/gmt,
    // it does not change it.
    "dox-architect": {
      "description": "Dox Architect — plans and orchestrates the documentation-site epic",
      "mode": "all",
      "prompt": "{file:.agents/dox-architect.md}",
      "permission": {
        "task": { "*": "deny", "dox-builder": "allow", "dox-tester": "allow" },
      },
    },
    "dox-builder": {
      "description": "Dox Builder — executes a planned Dox story in apps/dox",
      "mode": "subagent",
      "prompt": "{file:.agents/dox-builder.md}",
      "permission": { "task": { "*": "deny" } },
    },
    "dox-tester": {
      "description": "Dox Tester — verifies a Dox story against its Definition of Done",
      "mode": "subagent",
      "prompt": "{file:.agents/dox-tester.md}",
      "permission": { "task": { "*": "deny" } },
    },
  },
}
