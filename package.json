{
  "name": "root",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint:all": "pnpm -r --if-present run lint",
    "test:all": "pnpm -r --if-present run test",
    "verdict": "node scripts/verdict.mjs",
    "pr-status": "node scripts/pr-status.mjs",
    "validate": "node scripts/affected.mjs run",
    "validate:full": "node scripts/affected.mjs run --full",
    "affected:audit": "node scripts/affected.mjs audit",
    "deps": "node scripts/deps.mjs",
    "deps:sync": "node scripts/deps.mjs sync",
    "deps:ready": "node scripts/deps.mjs ready",
    "stats": "node scripts/stats.mjs",
    "stats:sync": "node scripts/stats.mjs sync",
    "upstream:sync": "node scripts/upstream.mjs sync",
    "api-surface": "node scripts/api-surface.mjs",
    "size": "node scripts/bundle-size.mjs",
    "bench": "pnpm --filter @northguild/gmt bench",
    "test:markers": "node scripts/test-markers.mjs check",
    "compat": "node scripts/temporal-compat.mjs check",
    "compat:snapshot": "node scripts/temporal-compat.mjs snapshot",
    "compat:oracle": "node scripts/temporal-compat.mjs oracle",
    "dox:dev": "pnpm --filter @gmt/dox dev",
    "dox:dev:site": "pnpm --filter @gmt/dox dev:site",
    "dox:build": "pnpm --filter @gmt/dox build",
    "dox:preview": "pnpm --filter @gmt/dox preview",
    "dox:generate": "pnpm --filter @gmt/dox generate",
    "dox:check": "pnpm --filter @gmt/dox check",
    "dox:test": "pnpm --filter @gmt/dox test",
    "dox:lint": "pnpm --filter @gmt/dox lint",
    "dox:export": "pnpm --filter @gmt/dox reference:export",
    "dox:docs-check": "pnpm --filter @gmt/dox docs-check",
    "format": "oxfmt",
    "format:fix": "oxfmt --write",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "oxlint",
    "check:fix": "oxlint --fix",
    "test": "vitest run",
    "test:gmt": "vitest run --config packages/gmt/vitest.config.ts",
    "native-suite": "node scripts/native-suite.mjs",
    "test:gmt:browser": "vitest run --config packages/gmt/vitest.browser.config.ts",
    "test:gmt:native": "vitest run --config packages/gmt/vitest.native.config.ts",
    "test:gmt:watch": "vitest --config packages/gmt/vitest.config.ts",
    "test:gmt-oxlint": "vitest run --config packages/gmt-oxlint/vitest.config.ts",
    "changeset": "changeset",
    "changeset:add": "changeset add",
    "changeset:status": "changeset status --since=origin/main",
    "changeset:version": "changeset version && node scripts/sync-intent-version.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@northguild/gmt-oxlint": "workspace:*",
    "@tanstack/intent": "^0.4.0",
    "@types/node": "^22.13.10",
    "@vitest/browser-playwright": "5.0.5",
    "esbuild": "^0.28.2",
    "fallow": "^3.35.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.78.0",
    "playwright": "1.63.0",
    "typescript": "^5.0.0",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.12.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.16.0 <25 || >=26 <27"
  },
  "packageManager": "pnpm@12.15.0"
}
