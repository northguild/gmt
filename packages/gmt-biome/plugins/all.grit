or {
  `new Date($args)` where {
    register_diagnostic(span=`new Date`, message="Avoid new Date(). Use @northguild/gmt getUtcNow(), getNow(), or getZonedNow(timezone) instead.", severity="error")
  },
  `Date.now()` where {
    register_diagnostic(span=`Date.now`, message="Avoid Date.now(). Use @northguild/gmt getUnixNow('milliseconds' | 'seconds') or getNow() instead.", severity="error")
  },
  `Date.parse($args)` where {
    register_diagnostic(span=`Date.parse`, message="Avoid Date.parse(). Use @northguild/gmt convertZonedToUnix(value) instead.", severity="error")
  },
  `Date.UTC($args)` where {
    register_diagnostic(span=`Date.UTC`, message="Avoid Date.UTC(). Use @northguild/gmt convertUtcDateTimeToUnix('YYYY-MM-DDTHH:mm:ss', 'milliseconds' | 'seconds') instead.", severity="error")
  },
  `$obj.getTimezoneOffset()` where {
    register_diagnostic(span=`getTimezoneOffset`, message="Avoid getTimezoneOffset(). Timezone offsets change throughout the year, so use @northguild/gmt zoned methods instead.", severity="error")
  }
}
