// Bans date libraries that wrap or pass native `Date` objects internally, which
// reintroduces the ambient-timezone and DST bugs GMT exists to prevent.
//
// `@js-joda/core` is deliberately NOT banned: it has its own value types and
// touches `Date` only at the boundary (reading the clock, host zone lookup,
// `toDate()` interop), so it does not carry the problems this rule targets.
//
// The regex is anchored to the whole node text, quotes included, hence the
// leading/trailing character class. Groups must be non-capturing — a capturing
// group in a Grit regex requires a metavariable binding list.
or {
  `import $_ from $source`,
  `import * as $_ from $source`,
  `import $source`,
  `require($source)`,
  `import($source)`
} where {
  or {
    and {
      $source <: r"[\"']moment(?:/.*)?[\"']",
      register_diagnostic(span=$source, message="Avoid moment: it wraps native Date. Use @northguild/gmt instead; https://northguild.dev/gmt/migrate/moment/ maps Moment.js calls to their gmt replacements.", severity="error")
    },
    and {
      $source <: r"[\"']moment-timezone(?:/.*)?[\"']",
      register_diagnostic(span=$source, message="Avoid moment-timezone: it wraps native Date. Use @northguild/gmt instead; https://northguild.dev/gmt/migrate/moment/ maps Moment.js calls to their gmt replacements.", severity="error")
    },
    and {
      $source <: r"[\"']dayjs(?:/.*)?[\"']",
      register_diagnostic(span=$source, message="Avoid dayjs: it wraps native Date. Use @northguild/gmt instead; https://northguild.dev/gmt/migrate/dayjs/ maps Day.js calls to their gmt replacements.", severity="error")
    },
    and {
      $source <: r"[\"']luxon(?:/.*)?[\"']",
      register_diagnostic(span=$source, message="Avoid luxon: it wraps native Date. Use @northguild/gmt instead; https://northguild.dev/gmt/migrate/luxon/ maps Luxon calls to their gmt replacements.", severity="error")
    },
    and {
      $source <: r"[\"']date-fns(?:/.*)?[\"']",
      register_diagnostic(span=$source, message="Avoid date-fns: it wraps native Date. Use @northguild/gmt instead; https://northguild.dev/gmt/migrate/date-fns/ maps date-fns calls to their gmt replacements.", severity="error")
    },
    and {
      $source <: r"[\"']date-fns-tz(?:/.*)?[\"']",
      register_diagnostic(span=$source, message="Avoid date-fns-tz: it wraps native Date. Use @northguild/gmt instead; https://northguild.dev/gmt/migrate/date-fns/ maps date-fns calls to their gmt replacements.", severity="error")
    },
    and {
      $source <: r"[\"']@date-fns/tz(?:/.*)?[\"']",
      register_diagnostic(span=$source, message="Avoid @date-fns/tz: it wraps native Date. Use @northguild/gmt instead; https://northguild.dev/gmt/migrate/date-fns/ maps date-fns calls to their gmt replacements.", severity="error")
    },
    and {
      $source <: r"[\"']spacetime(?:/.*)?[\"']",
      register_diagnostic(span=$source, message="Avoid spacetime: it wraps native Date. Use @northguild/gmt instead; https://northguild.dev/gmt/migrate/ lists the migration guides.", severity="error")
    }
  }
}
