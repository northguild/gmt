{
  "name": "@northguild/gmt-eslint",
  "version": "1.1.1",
  "description": "ESLint config that bans the JavaScript Date object and Date-based libraries, and names the Temporal-based @northguild/gmt function to use instead.",
  "keywords": [
    "date",
    "eslint",
    "eslint-config",
    "eslintconfig",
    "lint",
    "no-date",
    "tanstack-intent",
    "temporal"
  ],
  "homepage": "https://github.com/northguild/gmt#readme",
  "bugs": {
    "url": "https://github.com/northguild/gmt/issues"
  },
  "license": "MIT",
  "contributors": [
    {
      "name": "Baldur Páll Hólmgeirsson",
      "url": "https://github.com/baldurpan"
    },
    {
      "name": "Craig O. Curtis",
      "url": "https://github.com/craig-o-curtis"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/northguild/gmt.git",
    "directory": "packages/gmt-eslint"
  },
  "files": [
    "eslint",
    "LICENSE",
    "README.md",
    "skills"
  ],
  "type": "module",
  "main": "./eslint/index.mjs",
  "exports": {
    ".": "./eslint/index.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "pack": "npm pack --dry-run",
    "publish:dry-run": "npm publish --access public --dry-run"
  },
  "devDependencies": {
    "@tanstack/intent": "^0.4.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0"
  }
}
