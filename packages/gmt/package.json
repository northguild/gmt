{
  "name": "@northguild/gmt",
  "version": "1.15.0",
  "description": "Temporal-based date and time utilities with timezone support and polyfill integration",
  "keywords": [
    "date",
    "datetime",
    "polyfill",
    "tanstack-intent",
    "temporal",
    "time",
    "timezone"
  ],
  "homepage": "https://gmt-dox.northguild.workers.dev",
  "bugs": {
    "url": "https://github.com/northguild/gmt/issues"
  },
  "license": "MIT",
  "contributors": [
    {
      "name": "Baldur Páll Hólmgeirsson",
      "url": "https://github.com/baldurpan"
    },
    {
      "name": "Craig O. Curtis",
      "url": "https://github.com/craig-o-curtis"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/northguild/gmt.git",
    "directory": "packages/gmt"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "skills/gmt-basics",
    "skills/gmt-arithmetic",
    "skills/gmt-timezone",
    "skills/gmt-integration"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./calendar": {
      "types": "./dist/calendar/index.d.ts",
      "default": "./dist/calendar/index.js"
    },
    "./calendar/*": {
      "types": "./dist/calendar/*/index.d.ts",
      "default": "./dist/calendar/*/index.js"
    },
    "./calendar/*/*": null,
    "./instant": {
      "types": "./dist/instant/index.d.ts",
      "default": "./dist/instant/index.js"
    },
    "./instant/*": {
      "types": "./dist/instant/*/index.d.ts",
      "default": "./dist/instant/*/index.js"
    },
    "./instant/*/*": null,
    "./plain": {
      "types": "./dist/plain/index.d.ts",
      "default": "./dist/plain/index.js"
    },
    "./plain/*": {
      "types": "./dist/plain/*/index.d.ts",
      "default": "./dist/plain/*/index.js"
    },
    "./plain/*/*": null,
    "./precision": {
      "types": "./dist/precision/index.d.ts",
      "default": "./dist/precision/index.js"
    },
    "./precision/*": {
      "types": "./dist/precision/*/index.d.ts",
      "default": "./dist/precision/*/index.js"
    },
    "./precision/*/*": null,
    "./zoned": {
      "types": "./dist/zoned/index.d.ts",
      "default": "./dist/zoned/index.js"
    },
    "./zoned/*": {
      "types": "./dist/zoned/*/index.d.ts",
      "default": "./dist/zoned/*/index.js"
    },
    "./zoned/*/*": null,
    "./regex": {
      "types": "./dist/regex/index.d.ts",
      "default": "./dist/regex/index.js"
    },
    "./regex/*": {
      "types": "./dist/regex/*/index.d.ts",
      "default": "./dist/regex/*/index.js"
    },
    "./regex/*/*": null,
    "./span": {
      "types": "./dist/span/index.d.ts",
      "default": "./dist/span/index.js"
    },
    "./span/*": {
      "types": "./dist/span/*/index.d.ts",
      "default": "./dist/span/*/index.js"
    },
    "./span/*/*": null,
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./unix": {
      "types": "./dist/unix/index.d.ts",
      "default": "./dist/unix/index.js"
    },
    "./unix/*": {
      "types": "./dist/unix/*/index.d.ts",
      "default": "./dist/unix/*/index.js"
    },
    "./unix/*/*": null,
    "./utc": {
      "types": "./dist/utc/index.d.ts",
      "default": "./dist/utc/index.js"
    },
    "./utc/*": {
      "types": "./dist/utc/*/index.d.ts",
      "default": "./dist/utc/*/index.js"
    },
    "./utc/*/*": null,
    "./duration": {
      "types": "./dist/duration/index.d.ts",
      "default": "./dist/duration/index.js"
    },
    "./duration/*": {
      "types": "./dist/duration/*/index.d.ts",
      "default": "./dist/duration/*/index.js"
    },
    "./duration/*/*": null
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1"
  },
  "devDependencies": {
    "@northguild/gmt-oxlint": "workspace:*",
    "@tanstack/intent": "^0.3.8",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.0.0"
  }
}
