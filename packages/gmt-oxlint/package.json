{
  "name": "@burglekitt/gmt-oxlint",
  "version": "1.1.2",
  "description": "Oxlint JS plugin for banning Date APIs in Temporal-first projects",
  "keywords": [
    "date",
    "eslint-plugin",
    "lint",
    "oxlint",
    "tanstack-intent",
    "temporal"
  ],
  "homepage": "https://github.com/burglekitt/gmt#readme",
  "bugs": {
    "url": "https://github.com/burglekitt/gmt/issues"
  },
  "license": "MIT",
  "contributors": [
    {
      "name": "Baldur Páll Hólmgeirsson",
      "url": "https://github.com/baldurpan"
    },
    {
      "name": "Craig O. Curtis",
      "url": "https://github.com/craig-o-curtis"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/burglekitt/gmt.git",
    "directory": "packages/gmt-oxlint"
  },
  "files": [
    "dist",
    "config",
    "README.md",
    "LICENSE",
    "skills"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./recommended": {
      "types": "./config/recommended.d.ts",
      "default": "./config/recommended.json"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "prepack": "npm run build",
    "pack": "npm pack --dry-run",
    "publish:dry-run": "npm publish --access public --dry-run",
    "publish:public": "npm publish --access public"
  },
  "devDependencies": {
    "@tanstack/intent": "^0.3.6",
    "oxlint": "^1.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "oxlint": ">=1.0.0"
  },
  "oxlint": "./dist/index.js"
}
