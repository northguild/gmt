{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["node", "@webgpu/types", "@testing-library/jest-dom"],
    "paths": {
      "~/*": ["src/*"],
      "@northguild/gmt/*": ["../../packages/gmt/dist/*"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", ".astro", "node_modules"]
}
