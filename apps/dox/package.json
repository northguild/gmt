{
  "name": "@gmt/dox",
  "version": "0.1.1",
  "private": true,
  "description": "Documentation site for @northguild/gmt",
  "type": "module",
  "scripts": {
    "generate": "node ./scripts/generate-version-map.mjs && tsx ./scripts/build-reference.ts && node ./scripts/build-guides.mjs && node ./scripts/build-scenario-index.mjs && node ./scripts/ensure-sidebar-order.mjs",
    "predev": "pnpm --filter @northguild/gmt build",
    "dev": "pnpm run generate && node ./scripts/dev-all.mjs",
    "dev:site": "pnpm run generate && astro dev",
    "dev:chat": "pnpm run build && wrangler dev",
    "build": "pnpm run generate && astro build",
    "preview": "astro preview",
    "check": "pnpm run generate && astro sync && astro check",
    "typecheck": "pnpm run check",
    "test": "pnpm run generate && vitest run",
    "lint": "oxlint",
    "astro": "astro",
    "visual:before": "node scripts/visual-snapshot.mjs before",
    "visual:after": "node scripts/visual-snapshot.mjs after",
    "visual:diff": "node scripts/visual-snapshot.mjs diff"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.66",
    "@ai-sdk/react": "4.0.98",
    "@astrojs/react": "6.0.5",
    "@astrojs/starlight": "0.41.9",
    "@js-temporal/polyfill": "^0.5.1",
    "@northguild/gmt": "workspace:*",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/charts": "^0.16.0",
    "@tanstack/virtual-core": "^3.17.8",
    "ai": "^7.0.95",
    "astro": "7.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "d3-geo": "^3.1.1",
    "embla-carousel-react": "^8.6.0",
    "github-slugger": "2.0.0",
    "lucide-react": "^1.43.0",
    "minisearch": "7.2.0",
    "motion": "^13.2.0",
    "nanoid": "^6.0.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "^4.4.3",
    "streamdown": "^2.6.0",
    "tailwind-merge": "3.6.0",
    "topojson-client": "^3.1.0",
    "use-stick-to-bottom": "^1.1.6",
    "world-atlas": "^2.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.12",
    "@astrojs/check": "^0.9.10",
    "@northguild/gmt-oxlint": "workspace:*",
    "@open-wc/testing": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/topojson-client": "^3.1.5",
    "jsdom": "^30.0.1",
    "oxlint": "^1.78.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.0",
    "typescript": "5.9.3",
    "wrangler": "4.126.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
