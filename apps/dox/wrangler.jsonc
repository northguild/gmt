{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gmt-dox",
  "compatibility_date": "2026-08-26",
  "main": "./worker/index.ts",
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
  },
}
