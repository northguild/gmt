{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "dox",
  "projectType": "application",
  "sourceRoot": "apps/dox/src",
  "tags": [],
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/scripts/generate-version-map.mjs",
        "{projectRoot}/scripts/build-reference.ts",
        "{projectRoot}/scripts/build-guides.mjs",
        "{projectRoot}/scripts/build-scenario-index.mjs",
        "{workspaceRoot}/docs/dst-disambiguation.md",
        "{workspaceRoot}/packages/gmt/src/**/*.ts",
        "{workspaceRoot}/packages/*/package.json"
      ],
      "outputs": [
        "{projectRoot}/src/generated",
        "{projectRoot}/src/content/docs/reference",
        "{projectRoot}/src/content/docs/guides/concepts/dst-disambiguation.md",
        "{projectRoot}/src/content/docs/scenarios/index.mdx"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node ./scripts/generate-version-map.mjs && tsx ./scripts/build-reference.ts && node ./scripts/build-guides.mjs && node ./scripts/build-scenario-index.mjs",
        "forwardAllArgs": false
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "generate", "typecheck"],
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/packages/*/package.json"
      ],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "astro build",
        "forwardAllArgs": false
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "continuous": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "astro dev --force"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": false,
      "continuous": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "astro preview"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "generate"],
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/packages/*/package.json"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "astro sync && astro check",
        "forwardAllArgs": false
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "oxlint astro.config.mjs scripts src",
        "forwardAllArgs": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "vitest run --passWithNoTests",
        "forwardAllArgs": false
      }
    }
  }
}
