---
// The presenter view of Deck 0: the second window on the laptop while the deck runs on the
// projector (`lib/slides/presenter.ts`). Same slides as the deck, rendered as a hidden source the
// mount copies from. `noindex`, out of the search index, and out of the sitemap (the filter in
// `astro.config.mjs` drops every `/presenter/` page). The deck opens it with `T`.
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { KEY_TABLE } from "~/lib/slides/keys";
import { withBase } from "~/lib/site";
import { deckDialogs } from "~/widgets/builders/deck-controls";
import { presenterShell } from "~/widgets/builders/presenter";
import Deck0 from "~/slides/give-me-temporal/Deck0.astro";

const slug = "give-me-temporal";
---

<StarlightPage
  frontmatter={{
    title: "Presenter view: Give Me Temporal",
    description: "The presenter's window for the talk Give Me Temporal: notes, the next slide, the clock and a readiness check.",
    template: "splash",
    pagefind: false,
    head: [{ tag: "meta", attrs: { name: "robots", content: "noindex" } }],
  }}
>
  <Deck0 presenter />
  <div data-presenter-root data-deck-slug={slug} data-deck-url={withBase(`/slides/${slug}/`)} data-brains-url={withBase("/api/brains")}>
    <Fragment set:html={presenterShell().value} />
  </div>
  <Fragment set:html={deckDialogs(KEY_TABLE).value} />
</StarlightPage>

<script>
  import { mountPresenter } from "~/lib/slides/presenter";

  const root = document.querySelector<HTMLElement>("[data-presenter-root]");
  if (root)
    mountPresenter(root, {
      signal: new AbortController().signal,
      slug: root.dataset.deckSlug ?? "",
      deckUrl: new URL(root.dataset.deckUrl ?? "./", location.href).href,
      brainsUrl: new URL(root.dataset.brainsUrl ?? "", location.href).href,
    });
</script>
