---
// The `/dox` route — the only chat surface, full-bleed.
//
//  1. The route keeps the site header, the same one as every page (WCAG 2.2
//     SC 3.2.3 Consistent Navigation), and hides only the page `<h1>`. The page
//     itself never scrolls, and the chat fills the viewport below the header —
//     on this route the chat is the product.
//  2. The transcript is a hive diagram rather than an ordinary page frame.
//
// `<StarlightPage>` is still the wrapper even though none of its chrome is
// wanted: `customCss` (the whole 25-sheet design system) is injected only by
// Starlight's own Page.astro, which is reachable only through StarlightPage.
// Bypassing it would mean re-importing the entire stylesheet stack by hand.
// So the prose chrome (the `<h1>` and the page frame) is removed with CSS
// rather than by dropping the wrapper.
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import DoxPage from "~/components/ask/DoxPage";
---

<StarlightPage
  frontmatter={{
    // Kept for <title> and SEO — only the visual <h1> is hidden below.
    title: "Dox",
    description:
      "Ask GMT's assistant to run a tool, answer from the API reference, or explain a result.",
    template: "splash",
    pagefind: false,
    head: [
      {
        tag: "meta",
        attrs: { name: "robots", content: "noindex" },
      },
      {
        // Marks this document as the chat shell, in <head> before <body>
        // parses, so there's no flash of the page `<h1>` before it's hidden.
        // Every override below keys off this attribute, which is why
        // none of them can leak to another page: no other page's <head>
        // carries this script, so no other <html> ever has the attribute.
        //
        // JS-only is acceptable here specifically: the whole page is a
        // client:load island, so there is no no-JS experience to protect.
        tag: "script",
        content:
          "document.documentElement.setAttribute('data-dox-shell','')",
      },
    ],
  }}
>
  <DoxPage client:load />
</StarlightPage>

<style is:global>
  /* Scoped by the attribute above, not by Astro's component scoping, because
     every selector here targets Starlight-owned markup this file doesn't
     render itself. */

  /* The page never scrolls; the transcript is the only scroll container. */
  html[data-dox-shell],
  html[data-dox-shell] body {
    height: 100%;
    overflow: hidden;
  }

  /* Starlight's PageTitle renders <h1 id="_top"> on every page,
     splash included. The frontmatter title stays (for <title>/SEO); only the
     visual heading goes. */
  html[data-dox-shell] #_top {
    display: none;
  }

  /* Remove the sidebar and title padding meant for a prose page. The hive
     shell is fixed below the header, so this padding does not place it. */
  html[data-dox-shell] .main-frame {
    padding-top: 0;
    padding-inline-start: 0;
  }

  html[data-dox-shell] .page {
    min-height: 0;
    height: 100dvh;
  }

  html[data-dox-shell] main {
    padding: 0;
    height: 100%;
  }

  /* Starlight's content wrappers cap width and add vertical rhythm meant for
     prose — both fight a full-bleed app surface. */
  html[data-dox-shell] .content-panel {
    padding: 0;
    border: 0;
  }

  html[data-dox-shell] .sl-container {
    max-width: none;
    margin: 0;
  }

  html[data-dox-shell] .sl-container > * + * {
    margin-top: 0;
  }

  /* Starlight wraps page content in `.sl-markdown-content`, which applies
     prose rhythm (margins between siblings) to whatever it contains — the chat
     island included. Those margins are what offset the fixed shell's ancestor
     box and are meaningless around an app surface. */
  html[data-dox-shell] .sl-markdown-content > * + *,
  html[data-dox-shell] .sl-markdown-content {
    margin-top: 0;
    margin-block: 0;
  }
</style>
