  window.addEventListener("pagehide", () => stop.abort(), { once: true });
  const deck = document.querySelector<HTMLElement>("[data-deck-root]");
  if (deck?.querySelector("[data-deck-stage]")) mountBugVisuals(deck, { signal: stop.signal, win: window });
