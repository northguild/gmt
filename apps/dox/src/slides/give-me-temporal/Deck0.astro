  </Slide>

  <Slide id="spare-size" title="How big is it?" spare place="greenwich">
    <DeckTable
      caption={`Measured ${measuredOn} with Node ${bundleReport.node.replace(/^v/, "")} and esbuild ${bundleReport.esbuild}`}
      columns={["Name", ...BUNDLE_COLUMNS.slice(1, 3)]}
    >
      {sizeRows.map((r) => {
        const cells = bundleCells(r);
        return (
          <tr>
            <th scope="row">{sizeLabel(r.name)}</th>
            <td>{cells[1]}</td>
            <td>{cells[2]}</td>
          </tr>
        );
      })}
    </DeckTable>
    <p><Link href={pageHref("/bundle-size/")}>Every size, and how it was measured</Link></p>
