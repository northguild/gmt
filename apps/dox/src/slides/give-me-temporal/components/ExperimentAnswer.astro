---
/**
 * What an experiment slide shows once the question is answered: a bar per library with the wrong
 * count large, one example and the footnote. `ExperimentSlide.astro` places it, at build 1 when the
 * room is asked to guess first.
 */
import { probeFootnote, type ExperimentView } from "~/data/zone-probe";

interface Props {
  view: ExperimentView;
}
const { view } = Astro.props;
const example = view.example;
---

<ul class="gmt-exp-rows" aria-label="Wrong answers per library">
  {
    view.rows.map((row) => (
      <li class="gmt-exp-row" data-clean={String(row.wrong === 0)}>
        <span class="gmt-exp-name">{row.name}</span>
        <span class="gmt-exp-bar" aria-hidden="true">
          <span class="gmt-exp-fill" style={`--gmt-exp-share:${(row.share * 100).toFixed(2)}%`} />
        </span>
        <span class="gmt-exp-count">
          <span class="gmt-exp-wrong">{row.wrong.toLocaleString("en")}</span>
          <span class="gmt-exp-of">
            <span class="gmt-sr-only"> wrong </span>of {row.total.toLocaleString("en")}
          </span>
        </span>
      </li>
    ))
  }
</ul>
{
  example && (
    <p class="gmt-exp-example gmt-deck-panel">
      <span class="gmt-exp-example-input">{example.input}</span>
      <span class="gmt-exp-example-line">
        {example.name} says <code class="gmt-exp-wrong-answer">{example.answer}</code>, the right
        answer is <code class="gmt-exp-right-answer">{example.expected}</code>
      </span>
    </p>
  )
}
<p class="gmt-exp-foot">{probeFootnote()}</p>
