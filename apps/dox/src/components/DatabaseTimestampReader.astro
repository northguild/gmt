---
/**
 * Database Timestamp Reader widget.
 *
 * Pick a database and the form it hands back, type its fields, and see what the one library call
 * reads, with the call printed.
 *
 * **The markup and the wiring both live in `lib/database-timestamp-reader-mount.ts`**,
 * so the chat rail mounts the same widget this page server-renders.
 */
import { renderDatabaseTimestampReaderTemplate } from "../lib/database-timestamp-reader-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane`. Default `false`, the safe direction for a
 * reference page that embeds the widget.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderDatabaseTimestampReaderTemplate(
  "database-timestamp-reader",
  {},
).value;
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountDatabaseTimestampReader } from "../lib/database-timestamp-reader-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    const seed = seedFromLocation("dbstamp");
    document
      .querySelectorAll<HTMLElement>(
        '[data-widget="database-timestamp-reader"]',
      )
      .forEach((el) => {
        mountDatabaseTimestampReader(
          el,
          seed,
          new AbortController().signal,
        ).catch((error) => showUnavailable(el, error));
      });
  }
</script>
