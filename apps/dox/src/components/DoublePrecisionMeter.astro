---
/**
 * Double Precision Meter widget (SPA-49).
 *
 * How far a single JD, an MJD and seconds since J2000.0 drift from the instant they encode,
 * against the exact two-part JD, at the reader's year and measured across 1972 to 9999.
 *
 * **The markup and the wiring both live in `lib/double-precision-meter-mount.ts`**, so the chat
 * rail mounts the same widget this page server-renders.
 */
import { renderDoublePrecisionMeterTemplate } from "../lib/double-precision-meter-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane`. Default `false`, the safe direction for a
 * reference page that embeds the widget.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderDoublePrecisionMeterTemplate("double-precision-meter").value;
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountDoublePrecisionMeter } from "../lib/double-precision-meter-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    const seed = seedFromLocation("dpmeter");
    document
      .querySelectorAll<HTMLElement>('[data-widget="double-precision-meter"]')
      .forEach((el) => {
        mountDoublePrecisionMeter(el, seed, new AbortController().signal).catch(
          (error) => showUnavailable(el, error),
        );
      });
  }
</script>
