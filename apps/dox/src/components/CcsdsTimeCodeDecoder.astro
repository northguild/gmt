---
/**
 * CCSDS Time Code Decoder widget (SPA-52).
 *
 * A CCSDS 301.0-B-4 ASCII time code, read by `parseCcsdsAsciiA` and `parseCcsdsAsciiB`: which
 * code it is, the instant, whether a second 60 is an inserted leap second, the fraction digits it
 * keeps and whether a Z was sent. A second section writes one instant as both codes with
 * `formatCcsdsAsciiA` and `formatCcsdsAsciiB`.
 *
 * **The markup and the wiring both live in `lib/ccsds-time-code-decoder-mount.ts`**,
 * so the chat rail mounts the same widget this page server-renders.
 */

import { renderCcsdsTimeCodeDecoderTemplate } from "../lib/ccsds-time-code-decoder-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane`. The marker goes on a wrapper here rather than inside
 * `renderTemplate()` so the mount's markup stays byte-identical.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderCcsdsTimeCodeDecoderTemplate("ccsds-time-code-decoder", {}).value;
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountCcsdsTimeCodeDecoder } from "../lib/ccsds-time-code-decoder-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    /* A `?w=ccsds&wa=` permalink seeds the widget with the values it names;
       see lib/widget-permalink.ts. Absent or malformed, the widget opens on
       its first preset. */
    const seed = seedFromLocation("ccsds");
    document.querySelectorAll<HTMLElement>('[data-widget="ccsds-time-code-decoder"]').forEach((el) => {
      mountCcsdsTimeCodeDecoder(el, seed, new AbortController().signal).catch(
        (error) => showUnavailable(el, error),
      );
    });
  }
</script>
