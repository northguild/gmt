---
/**
 * Dwell Ledger widget (TRAN-8).
 *
 * A dwell drawn on a zone's real local-day grid: drag the entry and exit, or
 * type them, and watch `dwellTime` count elapsed hours and the local calendar
 * days the half-open dwell touched. An optional second zone is drawn on the
 * same canvas, so one pair of instants can be two days in one place and one in
 * another.
 *
 * **The markup and the wiring both live in `lib/dwell-ledger-mount.ts`**, so the
 * chat rail mounts the same widget this page server-renders.
 */

import { renderDwellLedgerTemplate } from "../lib/dwell-ledger-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane` and drop the max-width of every
 * `.sl-container` inside `main`. That is all the marker does: how the prose
 * around the widget is laid out is ToolLayout.astro's job, not this one's.
 *
 * Default `false`, which is the safe direction: this widget is embedded on
 * `reference/**` prose pages as well as its own `/tools/` page, and those pages
 * must keep their 50rem column. Only the tools page opts in. On a reference
 * page the section grid simply fits fewer columns, which is what `auto-fit` is
 * for. The marker goes on a wrapper here rather than inside `renderTemplate()`
 * so the mount's markup stays byte-identical and `scripts/html-diff.mjs` sees
 * the widget itself as unchanged.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderDwellLedgerTemplate();
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountDwellLedger } from "../lib/dwell-ledger-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    /* A `?w=dwell&wa=` permalink seeds the widget with the dwell it names; see
       lib/widget-permalink.ts. Absent or malformed, the widget opens on its
       first preset. */
    const seed = seedFromLocation("dwell");
    document.querySelectorAll<HTMLElement>(".gmt-dwell").forEach((el) => {
      mountDwellLedger(el, seed, new AbortController().signal).catch((error) =>
        showUnavailable(el, error),
      );
    });
  }
</script>
