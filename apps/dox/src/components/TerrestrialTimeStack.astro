---
/**
 * Terrestrial Time Stack widget (SPA-47).
 *
 * One instant on UTC, TAI, TT and TCG, drawn as a bar of the three offsets between UTC and TCG
 * with a drift lane for TCG minus TT across the years.
 *
 * **The markup and the wiring both live in `lib/terrestrial-time-stack-mount.ts`**, so the chat
 * rail mounts the same widget this page server-renders.
 */
import { renderTerrestrialTimeStackTemplate } from "../lib/terrestrial-time-stack-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane`. Default `false`, the safe direction for a
 * reference page that embeds the widget.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderTerrestrialTimeStackTemplate("terrestrial-time-stack").value;
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountTerrestrialTimeStack } from "../lib/terrestrial-time-stack-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    const seed = seedFromLocation("ttstack");
    document
      .querySelectorAll<HTMLElement>('[data-widget="terrestrial-time-stack"]')
      .forEach((el) => {
        mountTerrestrialTimeStack(el, seed, new AbortController().signal).catch(
          (error) => showUnavailable(el, error),
        );
      });
  }
</script>
