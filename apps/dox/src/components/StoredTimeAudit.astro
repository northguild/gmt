---
/**
 * Stored Time Audit widget (CORE-83).
 *
 * Stored RFC 9557 strings read under this browser's rules: each line's kind and
 * readings, and the selected line drawn against the clock change behind it.
 *
 * **The markup and the wiring both live in `lib/stored-time-audit-mount.ts`**,
 * so the chat rail mounts the same widget this page server-renders.
 */
import { renderStoredTimeAuditTemplate } from "../lib/stored-time-audit-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane`. Default `false`, the safe direction for a
 * reference page that embeds the widget.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderStoredTimeAuditTemplate();
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountStoredTimeAudit } from "../lib/stored-time-audit-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    const seed = seedFromLocation("storedaudit");
    document
      .querySelectorAll<HTMLElement>(".gmt-stored-time-audit")
      .forEach((el) => {
        mountStoredTimeAudit(el, seed, new AbortController().signal).catch(
          (error) => showUnavailable(el, error),
        );
      });
  }
</script>
