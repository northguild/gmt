---
/**
 * Live Playground (form).
 *
 * Auto-embedded on every reference page (and used by Scenario.astro /
 * Mistake.astro). Each argument is a real form control; the call re-evaluates
 * against the real gmt function on every edit. The markup comes from the kit
 * (`lib/playground-form-template.ts`); the behaviour is `lib/playground-form-mount.ts`.
 *
 * The generator (`buildPlaygroundFields` in scripts/build-reference.ts) decides
 * which functions get this and emits `fields` on the template:
 *   - scalar fields: string / number / bigint / boolean / enum / units
 *   - expr fields: an object or array literal, edited as source and passed
 *     through verbatim (a BusinessCalendar, an `{ start, end }` interval)
 *   - list fields (repeatable rows): arrays of strings, numbers, enum values,
 *     or object literals (`element: "expr"`)
 *   - intervals fields (repeatable start/end pairs): `{ start, end }[]`
 *   - `fields: []` — a no-arg function; just the call line + its live result
 *   - `objectArg` — `fn({ value1, value2 })`; fields are the object's keys
 * The result re-evaluates on every edit — there is no Run button. A trailing
 * options object is shown baked into the call and is not editable.
 *
 * Props:
 *   specId — key into LIVE_PLAYGROUND_TEMPLATES (generated).
 *   tone   — "wrong" | "right": Mistake.astro marks the result's border by side.
 */

import { renderPlaygroundFormTemplate, type PlaygroundTone } from "../lib/playground-form-template";
import { LIVE_PLAYGROUND_TEMPLATES } from "../lib/playground-spec";

interface Props {
  specId: string;
  tone?: PlaygroundTone;
}

const { specId, tone } = Astro.props;
const template = LIVE_PLAYGROUND_TEMPLATES[specId];

if (!template) {
  throw new Error(`<PlaygroundForm>: unknown specId "${specId}"`);
}
if (!template.fields) {
  throw new Error(`<PlaygroundForm>: template "${specId}" has no form fields`);
}

const markup = renderPlaygroundFormTemplate(specId, template, tone === undefined ? {} : { tone }).value;
---

<Fragment set:html={markup} />

<script>
  import { startPlaygroundForms } from "../lib/playground-form-mount";

  startPlaygroundForms();
</script>
