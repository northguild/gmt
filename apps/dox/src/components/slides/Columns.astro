---
/**
 * The same call, two answers: what an engine gave and what the report expects, side by side. The
 * words are a report's own lines.
 */
interface Props {
  call?: string;
  observedLabel: string;
  observed: string;
  expected: string;
}
const { call, observedLabel, observed, expected } = Astro.props;
---

<div class="gmt-columns">
  {call && <p class="gmt-columns-call">The same call: <code>{call}</code></p>}
  <div class="gmt-columns-pair">
    <div class="gmt-column" data-which="observed">
      <h3>{observedLabel}</h3>
      <p>{observed}</p>
    </div>
    <div class="gmt-column" data-which="expected">
      <h3>Expected</h3>
      <p>{expected}</p>
    </div>
  </div>
</div>
