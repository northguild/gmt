---
/**
 * A deck's table: a caption, one column-header row and the slot as the body rows. The rows stay with
 * the slide, because each deck decides what a cell holds (a typed code, a `Build`, a row header).
 * `visual="rows"` is the typed-rows variant the stage plays.
 */
interface Props {
  caption: string;
  columns: readonly string[];
  visual?: "rows";
}
const { caption, columns, visual } = Astro.props;
---

<table class="gmt-deck-table" data-visual={visual}>
  <caption>{caption}</caption>
  <thead>
    <tr>{columns.map((c) => <th scope="col">{c}</th>)}</tr>
  </thead>
  <tbody><slot /></tbody>
</table>
