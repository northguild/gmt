---
/**
 * One gmt call and what it gave, computed at build time: the code a slide shows and the value it
 * shows come from the same `module`, `name` and `args` (`lib/slides/gmt-call.ts`). A sentinel
 * (`""`, `null`, `false`, `[]`) renders as the signal-lost state in amber, and a result that is
 * only the empty list is still the sentinel here because the calls on stage ask for a value.
 * An unknown module or name throws at build time.
 */
import { callGmt, callText, isSentinel, valueText } from "~/lib/slides/gmt-call";
import { SENTINEL_TEXT } from "~/widgets/primitives/readout/readout";

interface Props {
  /** A key of `GMT_MODULES`. */
  module: string;
  name: string;
  /** The arguments, as a JSON array. */
  args: readonly unknown[];
}
const { module, name, args } = Astro.props;
const value = await callGmt(module, name, args);
const lost = isSentinel(value);
---

<div class="gmt-deck-panel gmt-result" data-signal={lost ? "lost" : "ok"}>
  <code class="gmt-result-call">{callText(name, args)}</code>
  <p class="gmt-result-value">
    <span class="gmt-result-arrow" aria-hidden="true">→</span>
    <output>{lost ? SENTINEL_TEXT : valueText(value)}</output>
  </p>
  <slot />
</div>
