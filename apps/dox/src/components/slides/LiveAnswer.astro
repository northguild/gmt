---
/**
 * `ask-dox`: the real Dox chat with the running question as a ready pill. The answer is live; if it is
 * slow or fails, the recording of the same question plays, labelled with its date and brain
 * (`lib/slides/deck-transport.ts`). The question is the owner's transcript
 * (`quotes/agent-answer.json`); the fallback text stands in until that file has one.
 * The presenter's copy of the slides gets a static placeholder, so no second chat mounts there.
 */
import DeckDox from "./DeckDox";
import { FALLBACK_RUNNING_QUESTION, RUNNING_QUESTION_ID } from "~/lib/slides/live-demos";
import { recordingsFor } from "~/lib/slides/recorded-files";
import answer from "~/slides/give-me-temporal/quotes/agent-answer.json";

const question = answer.question.trim() === "" ? FALLBACK_RUNNING_QUESTION : answer.question;
const id = RUNNING_QUESTION_ID;
const presenter = Astro.url.pathname.includes("/presenter/");
---

{
  presenter ? (
    <p class="gmt-deck-panel">Dox answers here in the live deck.</p>
  ) : (
    <DeckDox client:only="react" mode="answer" demoId={id} questions={[{ id, question }]} recordings={recordingsFor([id])} />
  )
}
