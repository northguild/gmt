---
/**
 * A bug slide's picture with its filings as receipts in the corner. The slot is the picture; one
 * receipt sits straight in the grid, two or more are wrapped in a row of their own. Each receipt is
 * a `filingKey` that `FilingReceipt` reads, so an unknown key fails the build; `show` picks what it
 * says beside the reference.
 */
import FilingReceipt, { type ReceiptShows } from "./FilingReceipt.astro";

interface Props {
  receipts?: readonly string[];
  show?: ReceiptShows;
  class?: string;
}
const { receipts = [], show = "tracker", class: extra } = Astro.props;
---

<div class:list={["gmt-visual", extra]}>
  <slot />
  {receipts.length === 1 && <FilingReceipt filing={receipts[0]!} show={show} />}
  {receipts.length > 1 && (
    <div class="gmt-receipts">
      {receipts.map((key) => <FilingReceipt filing={key} show={show} />)}
    </div>
  )}
</div>
