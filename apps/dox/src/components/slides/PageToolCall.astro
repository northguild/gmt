---
/**
 * `page-tools`: Moving Feasts' page tool called from this page for 2027, in the real Dox chat:
 * the call and both Easter Sundays, then the receipt and the month grids. It runs the tool's own `execute`, the
 * path an agent takes, so nothing is recorded and nothing goes over the network. It runs when the
 * slide shows.
 * The presenter's copy of the slides gets a static placeholder, so no second chat mounts there.
 */
import DeckDox from "./DeckDox";

const presenter = Astro.url.pathname.includes("/presenter/");
---

{
  presenter ? (
    <p class="gmt-deck-panel">The page tool runs here in the live deck.</p>
  ) : (
    <DeckDox client:only="react" mode="tools" demoId="page-tools" questions={[]} recordings={[]} />
  )
}
