---
/**
 * One upstream filing as a panel: its reference, the tracker's name, its title, its state as a
 * badge with words, and a link to it. Every part is read from `upstream-filings.json` through
 * `filingFacts`, so an unknown key throws at build time and a filing renamed or removed fails the
 * build rather than vanishing from the slide.
 */
import { filingFacts } from "~/lib/slides/filing";
import { badge } from "~/widgets/builders";

interface Props {
  /** A `filingKey`: `nodejs/node#67076` or `ICU-23609`. */
  filing: string;
}
const facts = filingFacts(Astro.props.filing);
const state = badge({
  text: facts.stateLabel,
  tone: facts.state === "open" ? "cyan" : facts.stateLabel === "Merged" ? "purple" : "neutral",
}).value;
---

<article class="gmt-deck-panel gmt-filing" data-state={facts.state}>
  <p class="gmt-filing-head">
    <a class="gmt-filing-ref" href={facts.url}>{facts.ref}</a>
    <span class="gmt-filing-group">{facts.group}</span>
    <Fragment set:html={state} />
  </p>
  <p class="gmt-filing-title">{facts.title}</p>
  <slot />
</article>
