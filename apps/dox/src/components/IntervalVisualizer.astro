---
/**
 * Interval Algebra Visualizer widget (DOX-B2c).
 *
 * Drag two intervals' endpoints on a shared 2024 timeline (or type them
 * directly) and watch intersection, union, difference, and xor update live
 * from the real zoned/interval functions — plus a mini result bar per
 * operation on the same timeline scale, so the shape of each answer is
 * visible, not just the JSON.
 *
 * Sentinel-aware: the library returns the same value (null / []) for
 * "invalid input" and "correctly, nothing overlaps" — this widget
 * pre-validates each interval with zoned/validate (the same gate the
 * interval functions use internally) so those two cases render visibly
 * differently, per context/dox/reference/visual-design.md "Widget chrome".
 *
 * Shares its card/section/codeframe/output chrome with DstInspector.astro —
 * see styles/gmt-widget.css, lib/widget-ui.ts, components/CodeFrame.astro.
 *
 * **The markup and the wiring both live in `lib/interval-visualizer-mount.ts`.**
 * DOX-C3b mounts this same widget into the chat rail, and a rail cannot
 * instantiate an Astro component — so one `renderIntervalTemplate()` serves
 * both surfaces, and this page still server-renders it.
 * `scripts/html-diff.mjs` asserts the built markup is unchanged by that move.
 */

import { renderIntervalTemplate } from "../lib/interval-visualizer-mount";
---

<Fragment set:html={renderIntervalTemplate()} />

<script>
  import { mountIntervalVisualizer } from "../lib/interval-visualizer-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  /* One mount per instance on the page. The rail passes a real AbortSignal;
     here nothing ever unmounts, so a never-aborted controller is honest about
     that rather than pretending there is a lifecycle to manage. */
  if (typeof window !== "undefined") {
    /* A `?w=&wa=` permalink seeds the widget with the state the link names —
       see lib/widget-permalink.ts. Absent or malformed, this is `{}` and the
       widget opens on its defaults, exactly as before. */
    const seed = seedFromLocation("interval");
    document.querySelectorAll<HTMLElement>(".gmt-interval").forEach((el) => {
      void mountIntervalVisualizer(el, seed, new AbortController().signal);
    });
  }
</script>
