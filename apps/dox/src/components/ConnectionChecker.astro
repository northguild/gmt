---
/**
 * Connection Checker widget (TRAN-9).
 *
 * One handoff — an arriving leg, a handling-time slider (the minimum connect
 * time) and a scheduled onward departure — checked by the real
 * `scheduleDelivery`, beside the naive check of the times as printed.
 *
 * **The markup and the wiring both live in `lib/connection-checker-mount.ts`**,
 * so the chat rail mounts the same widget this page server-renders.
 */

import { renderConnectionCheckerTemplate } from "../lib/connection-checker-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane` and drop the max-width of every
 * `.sl-container` inside `main`. That is all the marker does: how the prose
 * around the widget is laid out is ToolLayout.astro's job, not this one's.
 *
 * Default `false`, which is the safe direction: this widget is embedded on
 * `reference/**` prose pages as well as its own `/tools/` page, and those pages
 * must keep their 50rem column. Only the tools page opts in. On a reference
 * page the section grid simply fits fewer columns, which is what `auto-fit` is
 * for. The marker goes on a wrapper here rather than inside `renderTemplate()`
 * so the mount's markup stays byte-identical and `scripts/html-diff.mjs` sees
 * the widget itself as unchanged.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderConnectionCheckerTemplate();
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountConnectionChecker } from "../lib/connection-checker-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    const seed = seedFromLocation("connection");
    document.querySelectorAll<HTMLElement>(".gmt-connection").forEach((el) => {
      mountConnectionChecker(el, seed, new AbortController().signal).catch(
        (error) => showUnavailable(el, error),
      );
    });
  }
</script>
