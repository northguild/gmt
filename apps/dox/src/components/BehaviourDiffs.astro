---
/**
 * The cases where one library's result differs from Temporal's, taken from the behaviour matrix.
 *
 * One code pair per case: the library's call and result beside GMT's, under the input, the form
 * both are compared in and Temporal's result, then the clause that decides it, any open upstream
 * issue and a link to every library's result. A library that matches Temporal in every case prints
 * nothing. The Markdown twin is `renderBehaviourDiffs` in `src/lib/mdx-jsx.ts`.
 */
import CodePairs from "./CodePairs.astro";
import { libraryOf } from "../data/behaviour-matrix";
import { diffPairs, libraryProp } from "../lib/migrate-view";

interface Props {
  library: string;
}

const id = libraryProp(Astro.props.library, "BehaviourDiffs");
---

<CodePairs pairs={diffPairs(id)} label={`Where ${libraryOf(id).name} differs from Temporal`} />
