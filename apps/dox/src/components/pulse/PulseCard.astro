---
/** One workflow, or one unscheduled source, with its checks. The markup is built in `widgets/families/pulse/pulse-template.ts`. */
import { cards } from "../../data/pulse";
import { renderCard } from "../../widgets/families/pulse/pulse-template";
interface Props { file: string }
const card = cards.find((c) => c.file === Astro.props.file);
if (card === undefined) throw new Error(`pulse: no card for ${Astro.props.file}`);
const out = renderCard(card).value;
---

<Fragment set:html={out} />
