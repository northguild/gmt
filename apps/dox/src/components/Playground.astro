---
import { PLAYGROUND_SPECS } from "../lib/playground-spec";
import type { PlaygroundSpec } from "../lib/playground-spec";

interface Props {
  /** Key into PLAYGROUND_SPECS — e.g. "startOfZoned". */
  specId: string;
}

const { specId } = Astro.props;
const spec: PlaygroundSpec | undefined = PLAYGROUND_SPECS[specId];

if (!spec) {
  throw new Error(`<Playground>: unknown specId "${specId}"`);
}

const specJson = JSON.stringify(spec);
---

<h2>Playground</h2>

<gmt-playground
  class="gmt-playground"
  data-spec={specJson}
  data-module={spec.module}
  data-fn={spec.fn}
>
  <div class="gmt-playground-inputs">
    {spec.params[0] && (
      <label class="gmt-playground-field gmt-playground-field--full">
        <span class="gmt-playground-label">{spec.params[0].label ?? spec.params[0].name}</span>
        {spec.params[0].type === "enum" ? (
          <select class="gmt-playground-select" data-param={spec.params[0].name} data-kind="param">
            {spec.params[0].options?.map((opt) => (
              <option value={opt} selected={opt === spec.params[0].value}>{opt}</option>
            ))}
          </select>
        ) : (
          <input
            class="gmt-playground-input"
            type="text"
            data-param={spec.params[0].name}
            data-kind="param"
            value={spec.params[0].value}
          />
        )}
      </label>
    )}
    {spec.params.slice(1).map((p) => (
      <label class="gmt-playground-field">
        <span class="gmt-playground-label">{p.label ?? p.name}</span>
        {p.type === "enum" ? (
          <select class="gmt-playground-select" data-param={p.name} data-kind="param">
            {p.options?.map((opt) => (
              <option value={opt} selected={opt === p.value}>{opt}</option>
            ))}
          </select>
        ) : (
          <input
            class="gmt-playground-input"
            type="text"
            data-param={p.name}
            data-kind="param"
            value={p.value}
          />
        )}
      </label>
    ))}
    {spec.options?.map((o) => (
      <label class="gmt-playground-field">
        <span class="gmt-playground-label">{o.label ?? o.name}</span>
        <select class="gmt-playground-select" data-option={o.name} data-kind="option">
          {o.options?.map((opt) => (
            <option value={opt} selected={opt === o.value}>{opt}</option>
          ))}
        </select>
      </label>
    ))}
  </div>

  <div class="gmt-playground-call">
    <span class="gmt-playground-call-label">call</span>
    <div class="expressive-code">
      <figure class="frame not-content">
        <pre data-language="ts"><code class="gmt-playground-call-code"></code></pre>
        <div class="copy">
          <div aria-live="polite"></div>
          <button class="gmt-playground-copy" title="Copy to clipboard" data-copied="Copied!">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          </button>
        </div>
      </figure>
    </div>
  </div>

  <div class="gmt-playground-output">
    <span class="gmt-playground-output-label">result</span>
    <output class="gmt-playground-result" data-return-type={spec.returnType}>&nbsp;</output>
  </div>
</gmt-playground>

<script>
  import { registerPlayground } from "../lib/playground-register";
  registerPlayground();
</script>
