---
/**
 * Free Time Ledger widget (INT-12).
 *
 * A container's clock drawn on a terminal's real local-day grid, each day
 * coloured the way the tariff reads it: the uncounted event day, the free days,
 * the closed days a working-day tariff skips, and the chargeable days with
 * their tier bands. Drag the clock start and the gate-out, flip the start-day
 * convention and the basis, and watch `freeTimeExpiry` and `chargeableDays`
 * answer.
 *
 * **The markup and the wiring both live in `lib/free-time-ledger-mount.ts`**,
 * so the chat rail mounts the same widget this page server-renders.
 */

import { renderFreeTimeLedgerTemplate } from "../lib/free-time-ledger-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane` and drop the max-width of every
 * `.sl-container` inside `main`. That is all the marker does: how the prose
 * around the widget is laid out is ToolLayout.astro's job, not this one's.
 *
 * Default `false`, which is the safe direction: this widget is embedded on
 * `reference/**` prose pages as well as its own `/tools/` page, and those pages
 * must keep their 50rem column. Only the tools page opts in. On a reference
 * page the section grid simply fits fewer columns, which is what `auto-fit` is
 * for. The marker goes on a wrapper here rather than inside `renderTemplate()`
 * so the mount's markup stays byte-identical and `scripts/html-diff.mjs` sees
 * the widget itself as unchanged.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderFreeTimeLedgerTemplate();
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountFreeTimeLedger } from "../lib/free-time-ledger-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    /* A `?w=freetime&wa=` permalink seeds the widget with the clock it names;
       see lib/widget-permalink.ts. Absent or malformed, the widget opens on its
       first preset. */
    const seed = seedFromLocation("freetime");
    document.querySelectorAll<HTMLElement>(".gmt-freetime").forEach((el) => {
      mountFreeTimeLedger(el, seed, new AbortController().signal).catch((error) =>
        showUnavailable(el, error),
      );
    });
  }
</script>
