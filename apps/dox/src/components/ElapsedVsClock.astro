---
/**
 * Elapsed vs. Clock Difference widget (MAR-16).
 *
 * Two UTC readings subtracted two ways: the clock difference, which counts no
 * inserted second, and the seconds that passed, read through TAI. Two rulers
 * share one scale and the seconds between the two are listed.
 *
 * **The markup and the wiring both live in `lib/elapsed-vs-clock-mount.ts`**,
 * so the chat rail mounts the same widget this page server-renders.
 */
import { renderElapsedVsClockTemplate } from "../lib/elapsed-vs-clock-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane`. Default `false`, the safe direction for a
 * reference page that embeds the widget.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderElapsedVsClockTemplate("elapsed-vs-clock").value;
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountElapsedVsClock } from "../lib/elapsed-vs-clock-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    const seed = seedFromLocation("elapsed");
    document
      .querySelectorAll<HTMLElement>('[data-widget="elapsed-vs-clock"]')
      .forEach((el) => {
        mountElapsedVsClock(el, seed, new AbortController().signal).catch(
          (error) => showUnavailable(el, error),
        );
      });
  }
</script>
