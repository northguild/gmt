---
/**
 * Column Timestamp Bridge widget (CORE-56).
 *
 * One instant stored as a Parquet INT96, an Arrow Timestamp and a protobuf Timestamp,
 * and stored values read back.
 *
 * **The markup and the wiring both live in `lib/column-timestamp-bridge-mount.ts`**,
 * so the chat rail mounts the same widget this page server-renders.
 */
import { renderColumnTimestampBridgeTemplate } from "../lib/column-timestamp-bridge-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane`. Default `false`, the safe direction for a
 * reference page that embeds the widget.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderColumnTimestampBridgeTemplate("column-timestamp-bridge", {});
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountColumnTimestampBridge } from "../lib/column-timestamp-bridge-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    const seed = seedFromLocation("colbridge");
    document
      .querySelectorAll<HTMLElement>('[data-widget="column-timestamp-bridge"]')
      .forEach((el) => {
        mountColumnTimestampBridge(el, seed, new AbortController().signal).catch(
          (error) => showUnavailable(el, error),
        );
      });
  }
</script>
