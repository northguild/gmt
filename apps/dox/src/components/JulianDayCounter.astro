---
/**
 * Julian Day Counter widget (SPA-49).
 *
 * One instant as a two-part JD, a single JD, an MJD and seconds since J2000.0, on UTC, TAI, TT
 * or TCG, with a ruler that shows a JD day turning at noon.
 *
 * **The markup and the wiring both live in `lib/julian-day-counter-mount.ts`**, so the chat
 * rail mounts the same widget this page server-renders.
 */
import { renderJulianDayCounterTemplate } from "../lib/julian-day-counter-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane`. Default `false`, the safe direction for a
 * reference page that embeds the widget.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderJulianDayCounterTemplate("julian-day-counter").value;
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountJulianDayCounter } from "../lib/julian-day-counter-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    const seed = seedFromLocation("jdcount");
    document
      .querySelectorAll<HTMLElement>('[data-widget="julian-day-counter"]')
      .forEach((el) => {
        mountJulianDayCounter(el, seed, new AbortController().signal).catch(
          (error) => showUnavailable(el, error),
        );
      });
  }
</script>
