---
/**
 * TAI64N Log Reader widget.
 *
 * Log lines that start with a TAI64N label (daemontools, multilog, s6): the UTC instant each
 * label names, the TAI reading, and TAI minus UTC, with the selected line drawn large.
 *
 * **The markup and the wiring both live in `lib/tai64n-log-reader-mount.ts`**, so the chat
 * rail mounts the same widget this page server-renders.
 */
import { renderTai64nLogReaderTemplate } from "../lib/tai64n-log-reader-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane`. Default `false`, the safe direction for a
 * reference page that embeds the widget.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderTai64nLogReaderTemplate("tai64n-log-reader", {}).value;
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountTai64nLogReader } from "../lib/tai64n-log-reader-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    const seed = seedFromLocation("tai64n");
    document
      .querySelectorAll<HTMLElement>('[data-widget="tai64n-log-reader"]')
      .forEach((el) => {
        mountTai64nLogReader(el, seed, new AbortController().signal).catch(
          (error) => showUnavailable(el, error),
        );
      });
  }
</script>
