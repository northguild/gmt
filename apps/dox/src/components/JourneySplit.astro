---
/**
 * Journey Split widget (INT-14).
 *
 * A multi-leg journey's hours, sorted two ways on one scale: in the order they
 * happen, and gathered into moving and waiting. `multimodalETA` gives the
 * totals, `scheduleDelivery` the instants and `diffUtcAsDuration` each wait.
 * The Delivery Scheduler draws the legs; this tool draws the split.
 *
 * **The markup and the wiring both live in `lib/journey-split-mount.ts`**,
 * so the chat rail mounts the same widget this page server-renders.
 */

import { renderJourneySplitTemplate } from "../lib/journey-split-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane` and drop the max-width of every
 * `.sl-container` inside `main`. The marker goes on a wrapper here rather than
 * inside `renderTemplate()` so the mount's markup stays byte-identical and
 * `scripts/html-diff.mjs` sees the widget itself as unchanged.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderJourneySplitTemplate();
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountJourneySplit } from "../lib/journey-split-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    /* A `?w=journeysplit&wa=` permalink seeds the widget with the values it names;
       see lib/widget-permalink.ts. Absent or malformed, the widget opens on its
       first preset. */
    const seed = seedFromLocation("journeysplit");
    document
      .querySelectorAll<HTMLElement>(".gmt-journey-split")
      .forEach((el) => {
        mountJourneySplit(el, seed, new AbortController().signal).catch(
          (error) => showUnavailable(el, error),
        );
      });
  }
</script>
