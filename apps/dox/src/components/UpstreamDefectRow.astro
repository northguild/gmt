---
/**
 * One defect in the `/upstream/` table: what it breaks, whether GMT still works around it, and
 * what we sent about it.
 *
 * The "still needed" column is the canary's `state`, which `pnpm compat:snapshot` writes into
 * `temporal-compat.json` from the same probes `pnpm compat` runs. The row reads it and never works
 * it out again from the probe counts, so the column is a measurement rather than a sentence
 * anyone typed. A `guard` row passes its probes by design, so it says "Kept on purpose" and
 * prints the reason the snapshot recorded, with each GitHub reference as a short link.
 */
import type { CompatGroup } from "../data/temporal-compat";
import {
  groupLabel,
  groupWhatBreaks,
  reasonParts,
  shortRef,
  stateLine,
} from "../data/temporal-compat";
import type { UpstreamFiling } from "../data/upstream-filings";

interface Props {
  group: CompatGroup;
  /** The filings whose `gmtGuard` names one of this group's defects. */
  filings: readonly UpstreamFiling[];
}

// See `UpstreamFilingRow.astro`: `Astro.props` is untyped in this app, so `Props` is applied here.
const { group, filings } = Astro.props as Props;

const { badge, count } = stateLine(group);
---

<tr>
  <td class="gmt-defects-what">
    <strong>{groupLabel(group)}</strong>
    <p>{groupWhatBreaks(group)}</p>
  </td>
  <td class="gmt-defects-state">
    <span
      class:list={[
        "gmt-defects-badge",
        group.state === "still-needed" && "gmt-defects-badge--ok",
        group.state === "guard" && "gmt-defects-badge--guard",
      ]}
    >
      {badge}
    </span>
    <p>{count}</p>
    {group.state === "guard" && group.guard && (
      <p class="gmt-defects-reason">
        {reasonParts(group.guard.reason).map((part) =>
          "href" in part ? <a href={part.href}>{part.text}</a> : part.text,
        )}
      </p>
    )}
  </td>
  <td class="gmt-defects-sent">
    {filings.length === 0 ? (
      <p class="gmt-defects-none">—</p>
    ) : (
      <ul class="gmt-defects-refs">
        {filings.map((f) => (
          <li>
            <a href={f.contributionUrl ?? f.url}>{shortRef(f.repo, f.number)}</a>
          </li>
        ))}
      </ul>
    )}
  </td>
</tr>
