---
import Default from '@astrojs/starlight/components/Head.astro';
import { industrySidebarCss } from '~/lib/industry-tags';
import { VIEW_TRANSITION_OPT_IN, arrivalInlineSource } from '~/lib/arrival';

// Cloudflare Web Analytics. The site is registered in the NorthGuild Cloudflare account
// under its hostname, and this token only names that site entry: it is public by design
// and visible in every page's source. The beacon sets no cookie and does not identify
// visitors. Production builds only, so `astro dev` never reports localhost page views.
const CF_BEACON = JSON.stringify({ token: '94af68f89d8c4c8eac46ce6c17609d5f' });
---

<Default />

{/* Before the first paint: holds the landing page's entrance pieces and notes a view-transition arrival. See src/lib/arrival.ts. */}
<script is:inline set:html={arrivalInlineSource(import.meta.env.BASE_URL)} />

{/* The opt-in to cross-document view transitions; a rule in a linked sheet is missed on the landing. See src/lib/arrival.ts. */}
<style is:inline set:html={VIEW_TRANSITION_OPT_IN}></style>

{/* The sidebar icon of each industry group: one custom property per layer, read by the rule in gmt-shell.css. */}
<style is:inline set:html={industrySidebarCss()}></style>

<script>
	// Shared sonar focus-ring re-trigger — see src/lib/sonar.ts.
	import '~/lib/sonar';
	// A generated Options or Members table that scrolls sideways gets a tab stop, a name and a
	// scroll cue — see src/lib/ref-table.ts.
	import { mountRefTables } from '~/lib/ref-table';
	mountRefTables(document);
	// A code block or widget table that scrolls gets a tab stop, a name and a focus ring — see
	// src/lib/scroll-regions.ts.
	import { mountScrollRegions } from '~/lib/scroll-regions';
	mountScrollRegions(document);
</script>

{
	import.meta.env.PROD && (
		<script
			is:inline
			type="module"
			src="https://static.cloudflareinsights.com/beacon.min.js"
			data-cf-beacon={CF_BEACON}
		/>
	)
}
