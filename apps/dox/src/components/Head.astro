---
import Default from '@astrojs/starlight/components/Head.astro';

// Cloudflare Web Analytics. The site is registered in the NorthGuild Cloudflare account
// under its hostname, and this token only names that site entry: it is public by design
// and visible in every page's source. The beacon sets no cookie and does not identify
// visitors. Production builds only, so `astro dev` never reports localhost page views.
const CF_BEACON = JSON.stringify({ token: '94af68f89d8c4c8eac46ce6c17609d5f' });
---

<Default />

<script is:inline>
	// Hold the numbered tool cards invisible from the first paint, so a server-rendered card is
	// never painted and then hidden for its entrance (a blink). Inline, because a module script
	// runs after the first paint is possible. Only with script and motion allowed, so a reader
	// without JS, or who asked for less motion, sees the page as served; src/lib/widget-enter.ts
	// releases the hold in the task that starts the entrances, and a timer releases it anyway.
	(function () {
		var root = document.documentElement;
		if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		root.classList.add('gmt-enter-hold');
		setTimeout(function () {
			root.classList.remove('gmt-enter-hold');
		}, 2000);
	})();
</script>

<script>
	// Shared sonar focus-ring re-trigger — see src/lib/sonar.ts.
	import '~/lib/sonar';
	// Wraps each tool widget's result sections so height changes ease — see
	// src/lib/smooth-height.ts. Runs before any widget mount renders.
	import { smoothHeights } from '~/lib/smooth-height';
	smoothHeights(document);
	// Each numbered card arrives with the site's shared gesture — see
	// src/lib/widget-enter.ts. After smoothHeights, so a card that is about to
	// become a .gmt-grow host is already wrapped when it enters.
	import { enterWidgetSections, releaseEntranceHold } from '~/lib/widget-enter';
	enterWidgetSections(document);
	releaseEntranceHold();
	// A generated Options or Members table that scrolls sideways gets a tab stop, a name and a
	// scroll cue — see src/lib/ref-table.ts.
	import { mountRefTables } from '~/lib/ref-table';
	mountRefTables(document);
</script>

{
	import.meta.env.PROD && (
		<script
			is:inline
			type="module"
			src="https://static.cloudflareinsights.com/beacon.min.js"
			data-cf-beacon={CF_BEACON}
		/>
	)
}
