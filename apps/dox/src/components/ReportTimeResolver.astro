---
/**
 * Report Time Resolver widget (AV-98).
 *
 * A METAR, SPECI or TAF time group (`302350Z`) read against a reference the reader states, drawn
 * on a strip of candidate months, and NOTAM items B) and C) read in a window the reader states.
 *
 * **The markup and the wiring both live in `lib/report-time-resolver-mount.ts`**, so the chat rail
 * mounts the same widget this page server-renders.
 */
import { renderReportTimeResolverTemplate } from "../lib/report-time-resolver-mount";

/** `fullbleed` lets the page use the whole main pane (see ObservanceComparator). */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderReportTimeResolverTemplate("report-time-resolver", {}).value;
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountReportTimeResolver } from "../lib/report-time-resolver-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    const seed = seedFromLocation("reporttime");
    document
      .querySelectorAll<HTMLElement>('[data-widget="report-time-resolver"]')
      .forEach((el) => {
        mountReportTimeResolver(el, seed, new AbortController().signal).catch(
          (error) => showUnavailable(el, error),
        );
      });
  }
</script>
