---
/**
 * X12 Time Reader widget (INT-15).
 *
 * An X12 date (373), time (337) and time code (623), read together by
 * `parseX12DateTime`: whether the offset is stated, a zone is named with no
 * offset, or nothing is stated, and the instant once a stated offset or a zone
 * you pick fixes it. A second section reads a `DTP` value with
 * `parseX12DateTimePeriod`.
 *
 * **The markup and the wiring both live in `lib/x12-time-reader-mount.ts`**,
 * so the chat rail mounts the same widget this page server-renders.
 */

import { renderX12TimeReaderTemplate } from "../lib/x12-time-reader-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane` and drop the max-width of every
 * `.sl-container` inside `main`. That is all the marker does: how the prose
 * around the widget is laid out is ToolLayout.astro's job, not this one's.
 *
 * Default `false`, which is the safe direction: a page that embeds the widget
 * in prose keeps its 50rem column. Only the tools page opts in. The marker goes
 * on a wrapper here rather than inside `renderTemplate()`
 * so the mount's markup stays byte-identical and `scripts/html-diff.mjs` sees
 * the widget itself as unchanged.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderX12TimeReaderTemplate();
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountX12TimeReader } from "../lib/x12-time-reader-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    /* A `?w=xtime&wa=` permalink seeds the widget with the values it names;
       see lib/widget-permalink.ts. Absent or malformed, the widget opens on
       its first preset. */
    const seed = seedFromLocation("xtime");
    document.querySelectorAll<HTMLElement>(".gmt-x12-time-reader").forEach((el) => {
      mountX12TimeReader(el, seed, new AbortController().signal).catch(
        (error) => showUnavailable(el, error),
      );
    });
  }
</script>
