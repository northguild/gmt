---
/**
 * Code B Day Ruler widget (SPA-52).
 *
 * One CCSDS Code B day of the year, read in two years: its Code B and Code A text and the date in
 * words, with each year's twelve months on one scale of 366 day columns. Every figure is a return
 * of `parseCcsdsAsciiB`, `formatCcsdsAsciiA` or `formatCcsdsAsciiB`.
 *
 * **The markup and the wiring both live in `lib/code-b-day-ruler-mount.ts`**,
 * so the chat rail mounts the same widget this page server-renders.
 */

import { renderCodeBDayRulerTemplate } from "../lib/code-b-day-ruler-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane`. The marker goes on a wrapper here rather than inside
 * `renderTemplate()` so the mount's markup stays byte-identical.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderCodeBDayRulerTemplate("code-b-day-ruler", {}).value;
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountCodeBDayRuler } from "../lib/code-b-day-ruler-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    /* A `?w=dayruler&wa=` permalink seeds the widget with the values it names;
       see lib/widget-permalink.ts. Absent or malformed, the widget opens on
       its first preset. */
    const seed = seedFromLocation("dayruler");
    document.querySelectorAll<HTMLElement>('[data-widget="code-b-day-ruler"]').forEach((el) => {
      mountCodeBDayRuler(el, seed, new AbortController().signal).catch(
        (error) => showUnavailable(el, error),
      );
    });
  }
</script>
