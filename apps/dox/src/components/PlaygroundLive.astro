---
/**
 * Live Playground — textarea editor for Intl format functions.
 *
 * Props: specId — key into LIVE_PLAYGROUND_TEMPLATES (generated).
 */

import { LIVE_PLAYGROUND_TEMPLATES } from "../lib/playground-spec";

interface Props {
  specId: string;
}

const { specId } = Astro.props;
const template = LIVE_PLAYGROUND_TEMPLATES[specId];

if (!template) {
  throw new Error(`<PlaygroundLive>: unknown specId "${specId}"`);
}

const { module: mod, fn, template: tpl, returnType, allowEmptyArray } = template;

// Split template into fn name + args string
const parenIndex = tpl.indexOf("(");
const closeParenIndex = tpl.lastIndexOf(")");
const fnName = parenIndex >= 0 ? tpl.slice(0, parenIndex) : tpl;
const argsString =
  parenIndex >= 0 && closeParenIndex > parenIndex
    ? tpl.slice(parenIndex + 1, closeParenIndex)
    : "";
---

<div class="gmt-live-playground">
  <div class="gmt-live-playground-field">
    <span class="gmt-live-playground-label">input</span>
    <div class="">
      <div class="gmt-live-playground-top-row">
        <code class="gmt-live-playground-fn">{fnName}</code>
        <span class="gmt-live-playground-paren">(</span>
        <button class="gmt-live-playground-run" type="button" title="Run">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" stroke="none">
            <polygon points="6,3 20,12 6,21" />
          </svg>
        </button>
      </div>
      <div class="gmt-live-playground-call">
        <textarea
          class="gmt-live-playground-textarea"
          data-module={mod}
          data-fn={fn}
          data-return-type={returnType}
          spellcheck="false"
        >{argsString}</textarea>
      </div>
      <div class="gmt-live-playground-bottom-row">
        <span class="gmt-live-playground-paren">)</span>
      </div>
    </div>
  </div>
  <div class="gmt-live-playground-field">
    <span class="gmt-live-playground-label">output</span>
    <output class="gmt-live-playground-result" data-return-type={returnType} data-allow-empty-array={allowEmptyArray ? "true" : ""}>&nbsp;</output>
  </div>
</div>

<script>
  import { GMT_MODULES } from "../lib/gmt-modules";
  import { parseCallArgs } from "../lib/playground-parsers";
  import { evaluateArg, renderResult, sentinelFor } from "../lib/playground-client";

  async function run(): Promise<void> {
    const container = document.querySelector(".gmt-live-playground");
    if (!container) return;
    const textarea = container.querySelector(".gmt-live-playground-textarea") as HTMLTextAreaElement | null;
    const outputEl = container.querySelector(".gmt-live-playground-result") as HTMLElement | null;
    if (!textarea || !outputEl) return;

    const modKey = textarea.dataset.module;
    const fnName = textarea.dataset.fn;
    const returnType = textarea.dataset.returnType;
    const allowEmptyArray = outputEl.dataset.allowEmptyArray === "true";
    if (!modKey || !fnName || !returnType) return;

    renderResult(outputEl, "", false);

    try {
      const mod = await GMT_MODULES[modKey]?.();
      if (!mod) throw new Error("module not found: " + modKey);
      const fn = mod[fnName];
      if (typeof fn !== "function") throw new Error("export not found: " + fnName);

      // Reconstruct full call from fnName + textarea args
      const call = fnName + "(" + textarea.value + ")";
      const args = parseCallArgs(call).map(evaluateArg);
      const result = fn(...args);

      const sentinel = sentinelFor(returnType, allowEmptyArray);
      const isSentinel =
        result === sentinel &&
        result !== 0 &&
        result !== false;
      renderResult(outputEl, result, isSentinel);
    } catch {
      renderResult(outputEl, "", true);
    }
  }

  if (typeof window !== "undefined") {
    const container = document.querySelector(".gmt-live-playground");
    if (container) {
      const runBtn = container.querySelector(".gmt-live-playground-run");
      if (runBtn) {
        runBtn.addEventListener("click", run);
      }
      run();
    }
  }
</script>
