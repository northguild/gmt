---
// Override of Starlight's Footer that appends the site's licence note and an empty end-of-page
// marker. The licence note matches apps/LICENSE. The
// `<link rel="expect" href="#gmt-page-end" blocking="render">` in astro.config
// holds the first paint of each page until the parser reaches this element.
// Without it, Chrome paints a reference page (~200 KB, most of it sidebar) in
// pieces as it streams in — header first, then sidebar, then content — which
// reads as the sidebar and content flashing on every route change.
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default />
<p class="gmt-licence-note">
	Code examples: MIT-0. Packages: MIT. Third-party data and components: their own licences,
	credited where they appear. Everything else:
	<a href="https://github.com/northguild/gmt/blob/main/apps/LICENSE">© 2026 NorthGuild, all rights reserved</a>.
</p>
<div id="gmt-page-end" hidden></div>

<style>
	.gmt-licence-note {
		margin-block-start: 1.5rem;
		font-size: var(--sl-text-xs);
		color: var(--gmt-ice-dim);
	}

	/* Starlight's last-updated date, above the previous/next links. */
	:global(footer .meta) {
		gap: var(--gmt-space-2) var(--gmt-space-4);
		font-size: var(--sl-text-xs);
		color: var(--gmt-ice-dim);
		padding-block-end: var(--gmt-space-3);
		border-block-end: 1px solid var(--gmt-hairline);
	}

	.gmt-licence-note a {
		color: inherit;
		text-decoration: underline;
	}
</style>
