---
/**
 * Leap Second Timeline widget (MAR-16).
 *
 * Every second UTC has inserted, on one axis, with TAI - UTC as a step line,
 * a date's offset, the leap seconds between two dates and a check of a written
 * second 60.
 *
 * **The markup and the wiring both live in `lib/leap-second-timeline-mount.ts`**,
 * so the chat rail mounts the same widget this page server-renders.
 */
import { renderLeapSecondTimelineTemplate } from "../lib/leap-second-timeline-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane`. Default `false`, the safe direction for a
 * reference page that embeds the widget.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderLeapSecondTimelineTemplate();
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountLeapSecondTimeline } from "../lib/leap-second-timeline-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    const seed = seedFromLocation("leapline");
    document
      .querySelectorAll<HTMLElement>(".gmt-leap-second-timeline")
      .forEach((el) => {
        mountLeapSecondTimeline(el, seed, new AbortController().signal).catch(
          (error) => showUnavailable(el, error),
        );
      });
  }
</script>
