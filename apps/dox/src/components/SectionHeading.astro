---
/** Section heading for the homepage grid — consistent styling and bracket alignment
 * across MDX and component-rendered sections. */
interface Props {
  /** The heading's anchor, for a link that targets the section. */
  id?: string;
}

const { id } = Astro.props;
---

<h2 class="gmt-section-heading" id={id}>
  <slot />
</h2>

<style>
  .gmt-section-heading {
    margin: 0;
    padding-block-end: var(--gmt-space-2);
    border-block-end: 1px solid var(--gmt-hairline);
    color: var(--gmt-cyan-ink);
    font-size: 1.3rem;
    letter-spacing: var(--gmt-tracking-wide);
  }
</style>
