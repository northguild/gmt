---
/**
 * DOX-E1b — multi-zone time scrubber island.
 *
 * Static heading + caption render immediately; the widget itself lazy-loads
 * (d3-geo coordinate table + @js-temporal polyfill via lib/multi-zone-scrubber)
 * once it scrolls into view. Entry point `initScrubber(host)` matches the widget
 * mount pattern for DOX-C3a's `/dox` rail.
 */
interface Props {
  heading?: string;
  caption?: string;
}
const {
  heading = "Plan across zones",
  caption = "Pin the zones you care about and drag the slider — every clock moves together. When the slider crosses a daylight-saving boundary, the affected zone's offset changes and is flagged, not silently reflowed. Copy the link to share a proposed time.",
} = Astro.props;
---

<div class="gmt-scrubber-block">
  <h2 class="gmt-chart-title">{heading}</h2>
  <div id="scrubber-host"></div>
  <p class="gmt-globe-caption">{caption}</p>
</div>

<script>
  const host = document.getElementById("scrubber-host");
  if (host) {
    let started = false;
    const start = async () => {
      if (started) return;
      started = true;
      const { initScrubber } = await import("../lib/multi-zone-scrubber");
      await initScrubber(host);
    };

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            observer.disconnect();
            void start();
          }
        },
        { rootMargin: "200px" },
      );
      observer.observe(host);
    } else {
      void start();
    }
  }
</script>
