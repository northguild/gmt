---
/**
 * DOX-E1b — multi-zone time scrubber island.
 *
 * The heading, the caption and the planner's chrome render on the server (the chrome is the
 * kit's `renderScrubberTemplate`, the same markup the `/dox` rail draws). The wiring lazy-loads
 * (d3-geo coordinate table + @js-temporal polyfill via lib/multi-zone-scrubber) once the
 * planner scrolls into view. Entry point `initScrubber(root, options)` matches the widget
 * mount pattern for the `/dox` rail.
 */
interface Props {
  heading?: string;
  caption?: string;
}
import { renderScrubberTemplate } from "../widgets/families/zones/zone-planner-template";
import styles from "../widgets/tools/zone-planner-shell.module.css";

const {
  heading = "Plan across zones",
  caption = "Pin the zones you care about and drag the slider — every clock moves together. When the slider crosses a daylight-saving boundary, the affected zone's offset changes and is flagged, not silently reflowed. Copy the link to share a proposed time.",
} = Astro.props;
const markup = renderScrubberTemplate("zone-planner").value;
---

<div class={styles.block} data-tools-fullbleed>
  <h2 class:list={["gmt-chart-title", styles.title]}>{heading}</h2>
  <Fragment set:html={markup} />
  <p class={styles.caption}>{caption}</p>
</div>

<script>
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";
  import { seededZones, type ZonePlannerArgs } from "../lib/zone-planner";

  const host = document.querySelector<HTMLElement>(
    '[data-widget="multi-zone-scrubber"]',
  );
  if (host) {
    let started = false;
    const start = async () => {
      if (started) return;
      started = true;
      try {
        const { initScrubber } = await import("../lib/multi-zone-scrubber");
        /* A link copied out of the chat names the planner as `?w=planner&wa=…`;
           the planner's own `?tz=&t=` links still work: with no seed,
           `initScrubber` reads them itself. */
        const seed = seedFromLocation("planner") as ZonePlannerArgs;
        await initScrubber(host, {
          pinned: seededZones(seed),
          ...(typeof seed.time === "string" ? { time: seed.time } : {}),
        });
      } catch (error) {
        showUnavailable(host, error);
      }
    };

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            observer.disconnect();
            void start();
          }
        },
        { rootMargin: "200px" },
      );
      observer.observe(host);
    } else {
      void start();
    }
  }
</script>
