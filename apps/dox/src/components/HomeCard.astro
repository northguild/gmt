---
/**
 * A home-page tile: a diamond icon, a title and one line of text.
 *
 * Starlight's `Card` colours itself by its position in the grid (by counting its siblings), so a card that
 * moves, or a grid that gains one, changes colour. This one is told its `tone`, so the page says
 * what each tile looks like and the style needs no counting. Tiles sit in `HomeCards`, which is the
 * list that holds them.
 */
import { Icon } from "@astrojs/starlight/components";
import type { ComponentProps } from "astro/types";
import styles from "./HomeCard.module.css";

type Tone = "orange" | "purple" | "green" | "red" | "blue" | "ice";

interface Props {
  /** The heading line. May hold inline HTML (a `<code>` span). Required. */
  title: string;
  icon: ComponentProps<typeof Icon>["name"];
  tone: Tone;
}

const { title, icon, tone } = Astro.props;
---

<li class={styles.root} data-tone={tone}>
  <span class={styles.diamond} aria-hidden="true">
    <Icon name={icon} class={styles.icon} size="1rem" />
  </span>
  <div class={styles.text}>
    <p class={styles.title} set:html={title} />
    <div class={styles.body} data-card-body><slot /></div>
  </div>
</li>
