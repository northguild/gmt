---
/**
 * A home-page card: a heading line with an icon, then the card's text.
 *
 * Starlight's `Card` colours itself by its position in the grid (by counting its siblings), so a card that
 * moves, or a grid that gains one, changes colour. This one is told its `tone`, so the page says
 * what each card looks like and the style needs no counting. `span="full"` stretches a card across
 * a two-column grid, for the closing pointer card.
 */
import { Icon } from "@astrojs/starlight/components";
import type { ComponentProps } from "astro/types";
import styles from "./HomeCard.module.css";

type Tone = "orange" | "purple" | "green" | "red" | "blue" | "ice";

interface Props {
  /** The heading line. May hold inline HTML (a `<code>` span). Required. */
  title: string;
  icon: ComponentProps<typeof Icon>["name"];
  tone: Tone;
  span?: "full";
}

const { title, icon, tone, span } = Astro.props;
---

<article class={styles.root} data-tone={tone} data-span={span}>
  <p class={styles.title}>
    <Icon name={icon} class={styles.icon} size="1.333em" />
    <span set:html={title} />
  </p>
  <div class={styles.body}><slot /></div>
</article>
