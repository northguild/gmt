---
/**
 * Punctuality Board widget (TRAN-57).
 *
 * `scheduleDeviation`, `classifyPunctuality` and `punctualityRate` judging a
 * set of arrivals against a tolerance the reader drags.
 *
 * **The markup and the wiring both live in `lib/punctuality-board-mount.ts`**,
 * so the chat rail mounts the same widget this page server-renders.
 */
import { renderPunctualityBoardTemplate } from "../lib/punctuality-board-mount";
---

<Fragment set:html={renderPunctualityBoardTemplate()} />

<script>
  import { mountPunctualityBoard } from "../lib/punctuality-board-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    const seed = seedFromLocation("punctuality");
    document
      .querySelectorAll<HTMLElement>(".gmt-punctuality-board")
      .forEach((el) => {
        mountPunctualityBoard(el, seed, new AbortController().signal).catch(
          (error) => showUnavailable(el, error),
        );
      });
  }
</script>
