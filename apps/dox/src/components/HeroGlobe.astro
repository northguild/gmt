---
/**
 * Homepage-only merged hero: @northguild/gmt title/tagline/CTAs on the left,
 * the interactive globe on the right, both filling one full-viewport-height
 * section. Replaces the separate auto-injected Hero + standalone <Globe />
 * that used to stack on this page — see Hero.astro's isHome guard, which
 * skips Starlight's own Hero render on the route this component covers.
 *
 * The section is a dark island (`gmt-theme-dark`, see gmt-tokens.css): it keeps
 * the dark theme in both, and in the light theme sits on a full-width dark band.
 * That is what lets the light theme show the Earth imagery here — a dark
 * photograph straight on the pale page read as a hole — while every other page
 * keeps the light theme's flat globe.
 */
import Globe from './Globe.astro';
import HeroCopy from './HeroCopy.astro';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<div class="gmt-herostage gmt-brackets gmt-theme-dark">
	<div class="gmt-herostage-copy">
		<HeroCopy data={{ title, tagline, actions }} />
	</div>
	<Globe embedded />
</div>

<style>
	@layer starlight.core {
		.gmt-herostage {
			display: grid;
			grid-template-columns: 100%;
			gap: 2rem;
			/* Named so the bracket spacing below can add to it. */
			--gmt-herostage-pad: 1rem;
			padding-block: var(--gmt-herostage-pad);
		}

		/* The band. Painted with a border-image outset 100vmax to either side,
		   so it runs the full width of the window from inside the content column
		   without adding to the page's scrollable width. The tokens resolve on
		   this element, which is the island, so they are the dark values. In the
		   dark theme the page is already dark and no band is needed. */
		:global([data-theme='light']) .gmt-herostage {
			border-image: linear-gradient(
					180deg,
					var(--gmt-void),
					color-mix(in srgb, var(--gmt-cyan) 6%, var(--gmt-void))
				)
				fill 0 / / 0 100vmax;
		}

		.gmt-herostage-copy {
			display: flex;
			align-items: center;
			padding-left: 1rem;
		}

		@media (min-width: 80rem) {
			.gmt-herostage {
				grid-template-columns: minmax(0, auto) minmax(40rem, 1fr);
				align-items: stretch;
				gap: 3rem;
				/* Fixed height (not min-height): the plan calls for the first
				   section to cap at one screen, not grow past it. */
				height: calc(100dvh - var(--sl-nav-height));
				--gmt-herostage-pad: clamp(1rem, 4vh, 3rem);
			}

			/* min-height: 0 overrides the grid-item default of min-height:
			   auto, which would otherwise let either column grow past the
			   fixed row height above to fit its content (the zone list in
			   particular). */
			.gmt-herostage > * {
				min-height: 0;
			}

			.gmt-herostage-copy {
				height: 100%;
				overflow-y: auto;
			}
		}
	}

	/* The corner brackets (.gmt-brackets) sit inside the hero's edges rather
	   than on them, in both themes: the top-left one away from the top, the
	   bottom-right one away from the bottom — in the light theme, the band's
	   edges. Outside the layer above on purpose: the bracket recipe in
	   gmt-primitives.css is unlayered, and an unlayered rule beats any
	   layered one whatever its specificity. */
	.gmt-herostage::before {
		top: var(--gmt-space-6);
	}

	.gmt-herostage::after {
		bottom: var(--gmt-space-6);
	}

	/* The bottom-right bracket now stands that far above the hero's bottom
	   edge, so the hero grows by the inset plus the bracket's own 12px
	   (gmt-primitives.css), and the zone list ends clear of it. The top one
	   needs no room of its own: it sits beside the copy, never over it. */
	.gmt-herostage {
		padding-bottom: calc(var(--gmt-herostage-pad) + var(--gmt-space-6) + 12px);
	}

	/* On a wide screen the hero is one screen tall, so growing it would only
	   take height from the zone list. Each bracket sits in the middle of the
	   hero's own padding instead: clear of the edge and of the content alike. */
	@media (min-width: 80rem) {
		.gmt-herostage {
			padding-bottom: var(--gmt-herostage-pad);
		}

		.gmt-herostage::before {
			top: calc((var(--gmt-herostage-pad) - 12px) / 2);
		}

		.gmt-herostage::after {
			bottom: calc((var(--gmt-herostage-pad) - 12px) / 2);
		}
	}
</style>
