---
/**
 * Homepage-only merged hero: @northguild/gmt title/tagline/CTAs on the left and the
 * interactive Earth, frameless, in the sky beside them. Replaces the separate auto-injected
 * Hero + standalone <Globe /> that used to stack on this page — see Hero.astro's isHome
 * guard, which skips Starlight's own Hero render on the route this component covers.
 *
 * The section is a full-bleed dark island (`gmt-theme-dark`, see gmt-tokens.css): it keeps
 * the dark theme in both, which is what lets the light theme show the Earth imagery here
 * while every other page keeps the light theme's flat globe. The Earth is drawn by a layer
 * that covers the whole section (see lib/globe-mount.ts and widgets/tools/globe.module.css),
 * so the copy sits over it with no panel; a void halo on the letters keeps them readable.
 *
 * The copy column holds the pages of the landing's carousel: the intro (the title and the
 * tagline) and the pages the landing passes as children, each marked `data-page="<name>"`. Under
 * them are the hero's buttons, and under the buttons the pager: the previous arrow, a dot per
 * page (lib/home-carousel.ts fills them) and the next arrow. Without the script the pager is not
 * shown and every page reads in order (gmt-home-carousel.css).
 */
import Globe from './Globe.astro';
import HeroActions from './HeroActions.astro';
import HeroCopy from './HeroCopy.astro';
import HeroSpace from './HeroSpace.astro';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<div class="gmt-herostage gmt-theme-dark" data-gate="hero-stage">
	<HeroSpace />
	<div class="gmt-herostage-copy" data-gate="hero-copy">
		<div class="gmt-herostage-intro" data-page="Intro">
			<HeroCopy eyebrow="@northguild/gmt" data={{ title, tagline }} />
		</div>
		<slot />
		<div class="gmt-hero-nav" data-hero-nav>
			<HeroActions {actions} />
			<div class="gmt-hero-pager">
				<button type="button" class="gmt-hero-step gmt-sonar-focus" data-hero-step="-1" aria-label="Previous page">
					<svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"
						><path d="M12.5 4 6.5 10l6 6" fill="none" stroke="currentColor" stroke-width="2"
							stroke-linecap="round" stroke-linejoin="round"/></svg
					>
				</button>
				<div class="gmt-hero-dots" data-hero-dots></div>
				<button type="button" class="gmt-hero-step gmt-sonar-focus" data-hero-step="1" aria-label="Next page">
					<svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"
						><path d="m7.5 4 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2"
							stroke-linecap="round" stroke-linejoin="round"/></svg
					>
				</button>
			</div>
			<p class="gmt-hero-live" data-hero-live aria-live="polite" aria-atomic="true"></p>
		</div>
	</div>
	<Globe space />
</div>

<style>
	@layer starlight.core {
		.gmt-herostage {
			/* The stacking context for the layers inside: the globe layer, the scrim, the hit
			   area, the copy and the drawer. Full-bleed: the content panel's gutters are
			   given back, and the void is painted here so nothing pale shows at the edges. */
			position: relative;
			isolation: isolate;
			display: grid;
			grid-template-columns: 100%;
			margin-inline: calc(-1 * var(--sl-content-pad-x));

			/* The stage starts at the top of the page, under the fixed header (the margin is
			   below, in a later layer), so the sky and the Earth show through the header's glass. The
			   padding gives the header's height back to the copy, the Earth's frame and the
			   drawer; the sky and the globe layer fill the padding box. */
			padding-block-start: var(--sl-nav-height);
			overflow: clip;
			background-color: var(--gmt-void);

			/* The room the zone drawer takes under the Earth while the hero stacks
			   (globe.module.css). */
			--gmt-hero-bay: 30rem;
		}

		/* Stacked: the copy, then the Earth's area, which takes the rest of the first screen
		   and the drawer's bay under it. */
		@media (width < 64rem) or (orientation: portrait) {
			.gmt-herostage {
				grid-template-rows: auto 1fr;
				min-block-size: calc(100dvh + var(--gmt-hero-bay));
			}
		}

		/* No panel behind the copy: the Earth, the stars, the Moon and the Sun show through it.
		   The letters carry their own tight void halo instead (HeroCopy.astro). A reader who
		   asks for more contrast gets a void wash behind the column, anchored at the top while
		   the copy is above the Earth and at the left edge beside it. */
		.gmt-herostage::before {
			content: '';
			position: absolute;
			inset: 0;
			z-index: var(--gmt-z-raised);
			pointer-events: none;
		}

		/* The intro: the hero copy. It takes no pointer, as the
		   cell does; the text takes its own back. */
		.gmt-herostage-intro {
			display: flex;
			flex-direction: column;
			gap: var(--gmt-space-4);
			min-inline-size: 0;
		}

		@media (prefers-contrast: more) {
			.gmt-herostage::before {
				background: linear-gradient(
					to bottom,
					rgb(from var(--gmt-void) r g b / 88%) 0,
					rgb(from var(--gmt-void) r g b / 70%) 14rem,
					transparent 26rem
				);
			}
		}

		@media (prefers-contrast: more) and (width >= 64rem) and (orientation: landscape) {
			.gmt-herostage::before {
				background: radial-gradient(
					ellipse 60% 90% at 0% 50%,
					rgb(from var(--gmt-void) r g b / 88%) 0,
					rgb(from var(--gmt-void) r g b / 70%) 45%,
					transparent 100%
				);
			}
		}

		/* The pages, then the row of buttons, one under the other in the middle of the cell. */
		.gmt-herostage-copy {
			position: relative;
			z-index: var(--gmt-z-float);
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: flex-start;
			gap: var(--gmt-space-6);
			padding: var(--gmt-space-4) var(--sl-content-pad-x) 0 clamp(1rem, 5vw, 5rem);

			/* The cell is only a place to put the copy: it takes no pointer, so a drag that
			   starts on the Earth beside the text reaches the Earth. The text and the buttons
			   take theirs back (HeroCopy.astro). */
			pointer-events: none;
		}

		@media (width >= 64rem) and (orientation: landscape) {
			.gmt-herostage {
				grid-template-columns: minmax(0, auto) minmax(24rem, 1fr);
				align-items: stretch;

				/* Fixed height (not min-height): the first section is one screen, the part
				   under the header included. */
				block-size: 100dvh;
			}

			/* min-height: 0 overrides the grid-item default of min-height: auto, which would
			   let either column grow past the fixed row height to fit its content. */
			.gmt-herostage > * {
				min-block-size: 0;
			}

			/* The copy scrolls down on a short screen, never sideways. The column is sized to
			   its content, and the tagline's first line is exactly its own 50ch cap, so the
			   text sits flush with the edge. `overflow-y: auto` alone makes `overflow-x` auto
			   too, and a browser that measures the line a fraction of a pixel wider then shows
			   a horizontal scrollbar. The stable gutter keeps room for an always-visible
			   vertical scrollbar, so the bar never covers the text when it appears. */
			.gmt-herostage-copy {
				block-size: 100%;

				/* Equal padding above and below: the block sits in the middle of the stage. */
				padding-block: var(--gmt-space-6);
				padding-inline-end: var(--gmt-space-6);
				overflow: hidden auto;
				scrollbar-gutter: stable;
			}
		}
	}

	/* Pulled up under the header. In the site's shell layer, because Starlight's markdown
	   spacing (a later layer than its core) gives every block after the first a top margin,
	   which left a strip of page between the header and the stage. The landing's one-screen
	   layout sets its own (gmt-home-carousel.css). */
	@layer gmt.shell {
		.gmt-herostage {
			margin-block-start: calc(-1 * var(--sl-nav-height));
		}
	}
</style>

<style is:global>
	/* The buttons' sizes on a narrower landscape screen, beside the Earth. Unlayered, as the shared
	   button rules in HeroActions.astro are, and more specific, so these win. */
	.gmt-hero-nav .gmt-hero-actions {
		margin: 0;
	}

	@media (64rem <= width < 80rem) and (orientation: landscape) {
		.gmt-hero-nav .gmt-hero-actions {
			gap: 0.5rem;
		}

		.gmt-hero-nav .gmt-hero-actions .sl-link-button {
			gap: 0.4rem;
			padding: 0.6rem 0.8rem;
			font-size: 0.875rem;
		}

		.gmt-hero-nav .gmt-hero-actions .sl-link-button svg {
			inline-size: 1.125rem;
			block-size: 1.125rem;
		}
	}
</style>
