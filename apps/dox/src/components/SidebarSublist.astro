---
/**
 * Starlight's `SidebarSublist`, with two additions: dividers, and an icon on an industry's link.
 *
 * Starlight's sidebar holds only links and groups, so a generated sidebar marks a divider as
 * a link entry with `data-gmt-divider`: the API Reference's "By industry"
 * (`scripts/build-reference.ts`) and the Tools section's one divider per industry
 * (`scripts/build-utils/tools-sidebar.ts`). Here a divider is not drawn as a link. It is a
 * label, and the entries up to the next divider are their own list named by it
 * (`aria-labelledby`), so it is plain text for everyone: nothing to open, click or focus, and
 * a screen reader hears "Intermodal, list" before that industry's tools. A divider that also
 * carries `data-gmt-industry` shows that industry's tag icon before its label.
 *
 * A link entry that carries `data-gmt-industry-link` (the Industries group: one link per
 * industry hub, `scripts/build-utils/industry-pages.ts`) shows the same glyph before its
 * label, as an inline `aria-hidden` SVG in the label's own colour. Its attribute is not
 * `data-gmt-industry`, because the stylesheet's group-icon rule would then paint the
 * Industries group's own summary.
 *
 * Everything else is Starlight's own markup, so current-page highlighting, a page opening only
 * its ancestors, the `sl-sidebar-state` persistence and the mobile menu behave as they do
 * there.
 * Keep it in step with `@astrojs/starlight/components/SidebarSublist.astro` on a Starlight
 * upgrade.
 */
import { Badge, Icon } from '@astrojs/starlight/components';
import type { StarlightRouteData } from '@astrojs/starlight/route-data';
import SidebarRestorePoint from '@astrojs/starlight/components/SidebarRestorePoint.astro';
import { INDUSTRY_ICON_PATHS, industryTag } from '~/lib/industry-tags';

type SidebarEntry = StarlightRouteData['sidebar'][number];

/** Every link under `entries`, groups flattened (Starlight's `flattenSidebar`). */
function flattenSidebar(entries: SidebarEntry[]): Extract<SidebarEntry, { type: 'link' }>[] {
	return entries.flatMap((entry) => (entry.type === 'group' ? flattenSidebar(entry.entries) : entry));
}

interface Props {
	sublist: SidebarEntry[];
	nested?: boolean;
	/** The id of the divider that names this list. */
	labelledby?: string;
}

const { sublist, nested, labelledby } = Astro.props;

type LinkEntry = Extract<SidebarEntry, { type: 'link' }>;
const isDivider = (entry: SidebarEntry): entry is LinkEntry =>
	entry.type === 'link' && entry.attrs['data-gmt-divider'] !== undefined;

/** The entries before the first divider, then each divider with the entries up to the next. */
const firstAt = sublist.findIndex(isDivider);
const before = firstAt < 0 ? sublist : sublist.slice(0, firstAt);
const sections: { divider: LinkEntry; entries: SidebarEntry[] }[] = [];
for (const entry of firstAt < 0 ? [] : sublist.slice(firstAt)) {
	if (isDivider(entry)) sections.push({ divider: entry, entries: [] });
	else sections.at(-1)!.entries.push(entry);
}

/** A page-unique id from the divider's link (`#tools-intermodal` → `gmt-sidebar-divider-tools-intermodal`). */
const dividerId = (divider: LinkEntry) =>
	`gmt-sidebar-divider-${divider.href.replace(/[^a-z0-9]+/gi, '-').replace(/^-+|-+$/g, '').toLowerCase()}`;

/** An industry's icon, as SVG inner markup, or undefined for a plain divider or link. */
const industryIcon = (id: unknown): string | undefined => {
	const icon = typeof id === 'string' ? industryTag(id)?.icon : undefined;
	return icon ? INDUSTRY_ICON_PATHS[icon] : undefined;
};
---

<ul class:list={{ 'top-level': !nested, 'gmt-sidebar-named-list': labelledby }} aria-labelledby={labelledby}>
	{
		before.map((entry) => (
			<li>
				{entry.type === 'link' ? (
					<a
						href={entry.href}
						aria-current={entry.isCurrent ? 'page' : undefined}
						class:list={[{ large: !nested }, entry.attrs.class]}
						{...entry.attrs}
					>
						{industryIcon(entry.attrs['data-gmt-industry-link']) && (
							<svg
								class="gmt-sidebar-link-icon"
								viewBox="0 0 24 24"
								aria-hidden="true"
								focusable="false"
								set:html={industryIcon(entry.attrs['data-gmt-industry-link'])}
							/>
						)}
						<span>{entry.label}</span>
						{entry.badge && (
							<Badge
								variant={entry.badge.variant}
								class={entry.badge.class}
								text={entry.badge.text}
							/>
						)}
					</a>
				) : (
					<details
						open={flattenSidebar(entry.entries).some((i) => i.isCurrent) || !entry.collapsed}
					>
						<summary>
							<span class="group-label">
								<span class="large">{entry.label}</span>
								{entry.badge && (
									<Badge
										variant={entry.badge.variant}
										class={entry.badge.class}
										text={entry.badge.text}
									/>
								)}
							</span>
							<Icon name="right-caret" class="caret" size="1.25rem" />
						</summary>
						<SidebarRestorePoint />
						<Astro.self sublist={entry.entries} nested />
					</details>
				)}
			</li>
		))
	}
	{
		sections.map(({ divider, entries }) => (
			<li class="gmt-sidebar-divider-item">
				<span id={dividerId(divider)} class="gmt-sidebar-divider">
					{industryIcon(divider.attrs['data-gmt-industry']) && (
						<svg
							class="gmt-sidebar-divider-icon"
							viewBox="0 0 24 24"
							aria-hidden="true"
							focusable="false"
							set:html={industryIcon(divider.attrs['data-gmt-industry'])}
						/>
					)}
					{divider.label}
				</span>
				<Astro.self sublist={entries} nested labelledby={dividerId(divider)} />
			</li>
		))
	}
</ul>

<style>
	@layer starlight.core {
		ul {
			--sl-sidebar-item-padding-inline: 0.5rem;
			list-style: none;
			padding: 0;
		}

		li {
			overflow-wrap: anywhere;
		}

		ul ul li {
			margin-inline-start: var(--sl-sidebar-item-padding-inline);
			border-inline-start: 1px solid var(--sl-color-hairline-light);
			padding-inline-start: var(--sl-sidebar-item-padding-inline);
		}

		.large {
			font-size: var(--sl-text-lg);
			font-weight: 600;
			color: var(--sl-color-white);
		}

		.top-level > li + li {
			margin-top: 0.75rem;
		}

		summary {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 0.2em var(--sl-sidebar-item-padding-inline);
			line-height: 1.4;
			cursor: pointer;
			user-select: none;
		}
		summary::marker,
		summary::-webkit-details-marker {
			display: none;
		}

		.caret {
			transition: transform 0.2s ease-in-out;
			flex-shrink: 0;
		}
		:global([dir='rtl']) .caret {
			transform: rotateZ(180deg);
		}
		[open] > summary .caret {
			transform: rotateZ(90deg);
		}

		a {
			display: block;
			border-radius: 0.25rem;
			text-decoration: none;
			color: var(--sl-color-gray-2);
			padding: 0.3em var(--sl-sidebar-item-padding-inline);
			line-height: 1.4;
		}

		a:hover,
		a:focus {
			color: var(--sl-color-white);
		}

		[aria-current='page'],
		[aria-current='page']:hover,
		[aria-current='page']:focus {
			font-weight: 600;
			color: var(--sl-color-text-invert);
			background-color: var(--sl-color-text-accent);
		}

		a > *:not(:last-child),
		.group-label > *:not(:last-child) {
			margin-inline-end: 0.25em;
		}

		@media (min-width: 50rem) {
			.top-level > li + li {
				margin-top: 0.5rem;
			}
			.large {
				font-size: var(--sl-text-base);
			}
			a {
				font-size: var(--sl-text-sm);
			}
		}
	}
</style>
