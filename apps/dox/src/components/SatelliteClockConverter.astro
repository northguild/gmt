---
/**
 * Satellite Clock Converter widget (MAR-16).
 *
 * A time read on any of eight clocks (UTC, TAI and six satellite systems), shown
 * on all the others. `gnssToUtc` or `fromTAI` reads it, `utcToGnss` and `toTAI`
 * give every other clock; the tool draws them.
 *
 * **The markup and the wiring both live in `lib/satellite-clock-converter-mount.ts`**,
 * so the chat rail mounts the same widget this page server-renders.
 */

import { renderSatelliteClockConverterTemplate } from "../lib/satellite-clock-converter-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane` and drop the max-width of every
 * `.sl-container` inside `main`. The marker goes on a wrapper here rather than
 * inside `renderTemplate()` so the mount's markup stays byte-identical and
 * `scripts/html-diff.mjs` sees the widget itself as unchanged.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderSatelliteClockConverterTemplate();
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountSatelliteClockConverter } from "../lib/satellite-clock-converter-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    /* A `?w=satclock&wa=` permalink seeds the widget with the values it names;
       see lib/widget-permalink.ts. Absent or malformed, the widget opens on its
       first preset. */
    const seed = seedFromLocation("satclock");
    document
      .querySelectorAll<HTMLElement>(".gmt-satellite-clock-converter")
      .forEach((el) => {
        mountSatelliteClockConverter(
          el,
          seed,
          new AbortController().signal,
        ).catch((error) => showUnavailable(el, error));
      });
  }
</script>
