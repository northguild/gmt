---
/**
 * The /upstream/ tracker: one table per repository or tracker, built from `upstream-filings.ts` — the live
 * refresh when GitHub is reachable, the committed snapshot otherwise. Nothing is fetched in the
 * browser. Sentences come from `lib/upstream-summary.ts`, styles in `gmt-content-tables.css`.
 */
import { filingGroups, filingsForGroup } from "../data/upstream-filings";
import { UPSTREAM_COLUMNS as COLUMNS } from "../lib/upstream-status";
import { asDate } from "../lib/upstream-summary";
import UpstreamFilingRow from "./UpstreamFilingRow.astro";
import UpstreamTrackerLegend from "./UpstreamTrackerLegend.astro";
import UpstreamTrackerSummary from "./UpstreamTrackerSummary.astro";

---

<UpstreamTrackerSummary />

{
  filingGroups.map((group) => (
    <section class="gmt-upstream-repo">
      <h3>
        <a href={group.href}>{group.name}</a>
      </h3>
      <div class="gmt-ref-table" data-kind="content" data-layout="entries" data-label={`Filings: ${group.name}`}>
      <table class="gmt-upstream-table">
        <thead>
          <tr>{COLUMNS.map((column) => <th>{column}</th>)}</tr>
        </thead>
        <tbody>
          {filingsForGroup(group.id).map((f) => (
            <UpstreamFilingRow filing={f} formatDate={asDate} />
          ))}
        </tbody>
      </table>
      </div>
    </section>
  ))
}

<UpstreamTrackerLegend />
