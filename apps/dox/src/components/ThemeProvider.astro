{/* This is intentionally inlined to avoid FOUC. */}
<script is:inline>
  (() => {
    const storageKey = 'starlight-theme';
    const stored =
      typeof localStorage !== 'undefined' && localStorage.getItem(storageKey);
    const theme =
      stored === 'light' || stored === 'dark'
        ? stored
        : window.matchMedia('(prefers-color-scheme: light)').matches
          ? 'light'
          : 'dark';
    document.documentElement.dataset.theme = theme;
    /* The page's look (src/lib/look.ts): the same key, applied here so the first frame is right. */
    try {
      if (localStorage.getItem('dox:look') === 'natural') {
        document.documentElement.dataset.look = 'natural';
      }
    } catch (_) {}
    /* The sound choice (src/lib/sound/settings.ts): the same rule, applied here so the settings
       panel's speaker paints right on the first frame. Sound is opt-in: it is on only when a
       record of this version says unmuted; anything else reads as muted. */
    var soundMuted = true;
    try {
      var soundSaved = JSON.parse(localStorage.getItem('dox:sound'));
      if (soundSaved && soundSaved.v === 1 && soundSaved.muted === false) soundMuted = false;
    } catch (_) {}
    document.documentElement.dataset.sound = soundMuted ? 'off' : 'on';
  })();
</script>
