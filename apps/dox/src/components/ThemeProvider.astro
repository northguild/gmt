{/* This is intentionally inlined to avoid FOUC. */}
<script is:inline>
  window.StarlightThemeProvider = (() => {
    const storageKey = 'starlight-theme';
    const stored =
      typeof localStorage !== 'undefined' && localStorage.getItem(storageKey);
    const theme =
      stored === 'light' || stored === 'dark'
        ? stored
        : window.matchMedia('(prefers-color-scheme: light)').matches
          ? 'light'
          : 'dark';
    document.documentElement.dataset.theme = theme;
    return {
      updatePickers() {
        document.querySelectorAll('starlight-theme-select').forEach((picker) => {
          const btn = picker.querySelector('button.theme-toggle');
          if (!btn) return;
          const currentTheme = document.documentElement.dataset.theme;
          const icon = btn.querySelector('.theme-icon');
          if (icon) {
            icon.innerHTML = currentTheme === 'light'
              ? '<path d="M5 12a1 1 0 0 0-1-1H3a1 1 0 0 0 0 2h1a1 1 0 0 0 1-1Zm.64 5-.71.71a1 1 0 0 0 0 1.41 1 1 0 0 0 1.41 0l.71-.71A1 1 0 0 0 5.64 17ZM12 5a1 1 0 0 0 1-1V3a1 1 0 0 0-2 0v1a1 1 0 0 0 1 1Zm5.66 2.34a1 1 0 0 0 .7-.29l.71-.71a1 1 0 1 0-1.41-1.41l-.66.71a1 1 0 0 0 0 1.41 1 1 0 0 0 .66.29Zm-12-.29a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.71-.71a1.004 1.004 0 1 0-1.43 1.41l.73.71ZM21 11h-1a1 1 0 0 0 0 2h1a1 1 0 0 0 0-2Zm-2.64 6A1 1 0 0 0 17 18.36l.71.71a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.76-.66ZM12 6.5a5.5 5.5 0 1 0 5.5 5.5A5.51 5.51 0 0 0 12 6.5Zm0 9a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Zm0 3.5a1 1 0 0 0-1 1v1a1 1 0 0 0 2 0v-1a1 1 0 0 0-1-1Z"/>'
              : '<path d="M21.64 13a1 1 0 0 0-1.05-.14 8.049 8.049 0 0 1-3.37.73 8.15 8.15 0 0 1-8.14-8.1 8.59 8.59 0 0 1 .25-2A1 1 0 0 0 8 2.36a10.14 10.14 0 1 0 14 11.69 1 1 0 0 0-.36-1.05Zm-9.5 6.69A8.14 8.14 0 0 1 7.08 5.22v.27a10.15 10.15 0 0 0 10.14 10.14 9.784 9.784 0 0 0 2.1-.22 8.11 8.11 0 0 1-7.18 4.32v-.04Z"/>';
          }
        });
      },
    };
  })();

  /* DOX-D2 boot sequence — the shell frame animates in once per session.
     Gated here (before <body> paints) so a returning reader, or anyone with
     reduced motion, never sees it and content is never withheld. The CSS
     (:root.dox-boot header / .sidebar-pane, gmt-motion.css) does the rest. */
  (() => {
    try {
      if (sessionStorage.getItem('dox-booted') === 'true') return;
      sessionStorage.setItem('dox-booted', 'true');
    } catch (e) {
      return;
    }
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const root = document.documentElement;
    root.classList.add('dox-boot');
    addEventListener(
      'load',
      () => setTimeout(() => root.classList.remove('dox-boot'), 1200),
      { once: true },
    );
  })();
</script>

{/* Bundled (module) — Astro resolves the import and defers it past DOM parse,
   so the observer finds its targets. Every navigation is a full load, so a
   one-time init is all it needs. */}
<script>
  import { initRevealPrimitive } from '../lib/reveal-primitive';

  initRevealPrimitive();

  // DOX-D2: a link to the page you're already on still "navigates", and with
  // @view-transition that flashes the whole document. Neutralise the site
  // title link when it points at the current path.
  const title = document.querySelector<HTMLAnchorElement>('a.site-title');
  if (title) {
    const dest = new URL(title.href).pathname.replace(/\/$/, '');
    const here = location.pathname.replace(/\/$/, '');
    if (dest === here) {
      title.addEventListener('click', (e) => e.preventDefault());
      title.setAttribute('aria-disabled', 'true');
    }
  }
</script>
