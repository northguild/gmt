{/* This is intentionally inlined to avoid FOUC. */}
<script is:inline>
  (() => {
    const storageKey = 'starlight-theme';
    const stored =
      typeof localStorage !== 'undefined' && localStorage.getItem(storageKey);
    const theme =
      stored === 'light' || stored === 'dark'
        ? stored
        : window.matchMedia('(prefers-color-scheme: light)').matches
          ? 'light'
          : 'dark';
    document.documentElement.dataset.theme = theme;
    /* The Earth's look (src/lib/earth-look.ts): the same key, applied here so the first frame is right. */
    try {
      if (localStorage.getItem('dox:earth') === 'natural') {
        document.documentElement.dataset.earth = 'natural';
      }
    } catch (_) {}
    /* The sound choice (src/lib/sound/settings.ts): the same rule, applied here so the settings
       panel's speaker paints right on the first frame. A saved `muted` wins; otherwise reduced motion mutes. */
    var soundMuted;
    try {
      var soundSaved = JSON.parse(localStorage.getItem('dox:sound'));
      if (soundSaved && typeof soundSaved.muted === 'boolean') soundMuted = soundSaved.muted;
    } catch (_) {}
    if (soundMuted === undefined) {
      try {
        soundMuted = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      } catch (_) {
        soundMuted = false;
      }
    }
    document.documentElement.dataset.sound = soundMuted ? 'off' : 'on';
  })();
</script>
