---
/**
 * B/L Date Stamp widget (INT-14).
 *
 * One moment has a different calendar date in each place, and a bill of lading
 * carries the local one. `bolTimestamp` is called for the place, for UTC and for
 * up to three other calendars, and the widget draws the dates as lanes of local
 * days on one time axis, with a slider that moves the moment.
 *
 * **The markup and the wiring both live in `lib/bl-date-stamp-mount.ts`**,
 * so the chat rail mounts the same widget this page server-renders.
 */

import { renderBlDateStampTemplate } from "../lib/bl-date-stamp-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane` and drop the max-width of every
 * `.sl-container` inside `main`. The marker goes on a wrapper here rather than
 * inside `renderTemplate()` so the mount's markup stays byte-identical and
 * `scripts/html-diff.mjs` sees the widget itself as unchanged.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderBlDateStampTemplate("bl-date-stamp", {}).value;
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountBlDateStamp } from "../lib/bl-date-stamp-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    /* A `?w=bldate&wa=` permalink seeds the widget with the values it names;
       see lib/widget-permalink.ts. Absent or malformed, the widget opens on its
       first preset. */
    const seed = seedFromLocation("bldate");
    document
      .querySelectorAll<HTMLElement>('[data-widget="bl-date-stamp"]')
      .forEach((el) => {
        mountBlDateStamp(el, seed, new AbortController().signal).catch(
          (error) => showUnavailable(el, error),
        );
      });
  }
</script>
