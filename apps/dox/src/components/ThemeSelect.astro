---
// Override of Starlight's ThemeSelect for 2-state theme toggle.
---

<starlight-theme-select>
  <button
    type="button"
    class="theme-toggle gmt-icon-button"
    aria-label="Toggle color theme"
  >
    <svg
      class="theme-icon"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    ></svg>
  </button>
</starlight-theme-select>

{/* Inlined to avoid FOUC. Uses global scope from `ThemeProvider.astro`. */}
<script is:inline>
  StarlightThemeProvider.updatePickers();
</script>

<script>
  declare const StarlightThemeProvider: {
    updatePickers(): void;
  };

  const storageKey = 'starlight-theme';

  function loadTheme(): string {
    const stored =
      typeof localStorage !== 'undefined' && localStorage.getItem(storageKey);
    return stored === 'light' || stored === 'dark' ? stored : '';
  }

  function getSystemPref(): string {
    return window.matchMedia('(prefers-color-scheme: light)').matches
      ? 'light'
      : 'dark';
  }

  function applyTheme(theme: string) {
    document.documentElement.dataset.theme = theme || getSystemPref();
    StarlightThemeProvider.updatePickers();
  }

  // DOX-D2: cross-fade the light/dark swap via a view transition. One guarded
  // call site — `busy` is the debounce the spec asks for, so a double-click
  // can't stack startViewTransition() calls. Falls back to an instant apply
  // where the API is missing or motion is reduced.
  let busy = false;
  function transitionTheme(theme: string) {
    const start = (
      document as Document & {
        startViewTransition?: (cb: () => void) => { finished: Promise<unknown> };
      }
    ).startViewTransition?.bind(document);
    if (
      !start ||
      busy ||
      window.matchMedia('(prefers-reduced-motion: reduce)').matches
    ) {
      applyTheme(theme);
      return;
    }
    busy = true;
    start(() => applyTheme(theme)).finished.finally(() => {
      busy = false;
    });
  }

  class StarlightThemeSelect extends HTMLElement {
    constructor() {
      super();
      const btn = this.querySelector('button.theme-toggle');
      if (btn) {
        btn.addEventListener('click', () => {
          const stored = loadTheme();
          const systemPref = getSystemPref();
          if (stored === 'light' || stored === 'dark') {
            localStorage.removeItem(storageKey);
            transitionTheme(systemPref);
          } else {
            const opposite = systemPref === 'light' ? 'dark' : 'light';
            localStorage.setItem(storageKey, opposite);
            transitionTheme(opposite);
          }
        });
      }

      matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
        const stored = loadTheme();
        if (!stored) {
          applyTheme(getSystemPref());
        }
      });

      applyTheme(loadTheme());
    }
  }

  customElements.define('starlight-theme-select', StarlightThemeSelect);
</script>

{/* Size, chip, and icon color come entirely from `.gmt-icon-button`
   (gmt-primitives.css) — this override adds no styles of its own. */}
