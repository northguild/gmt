---
/**
 * The full behaviour matrix: one section per case, one table per section.
 *
 * Every figure comes from `data/behaviour-matrix.json`, which `scripts/behaviour-matrix/run.mjs`
 * writes. Each library row carries the anchor `m1-date-fns` so the `/migrate/` pages can link to
 * it. The verdict is a word, never colour alone. The Markdown twin is `renderBehaviourMatrix` in
 * `src/lib/mdx-jsx.ts`. Styles live in `src/styles/gmt-migrate.css`.
 */
import { codeBreakClass, codeBreakHtml } from "../lib/code-break";
import { codeSpans, matrixView } from "../lib/migrate-view";

const cases = matrixView();
const columns = (reference: string): string[] => [
  "Library",
  "Call",
  "Returns",
  `Compared with ${reference}`,
  "Upstream issue",
];
---

{
  cases.map((c) => (
    <section class="gmt-matrix-case">
      <h2 id={c.anchor}>
        {c.id}. {c.title}
      </h2>
      <p class="gmt-matrix-meta">
        Input: {c.input}. Compared as: {c.compare}. Specification:{" "}
        {c.clauses.map((clause, index) => (
          <>
            {index > 0 && ", "}
            <a href={clause.url}>{clause.label}</a>
          </>
        ))}
        .
      </p>
      {c.expectedNote && <p>{c.expectedNote}</p>}
      {c.note && <p set:html={codeSpans(c.note)} />}
      <div
        class="gmt-ref-table"
        data-kind="content"
        data-layout="entries"
        data-label={`${c.id} results`}
      >
        <table class="gmt-migrate-table gmt-matrix-table">
          <thead>
            <tr>
              {columns(c.reference).map((label) => <th>{label}</th>)}
            </tr>
          </thead>
          <tbody>
            {c.rows.map((row) => (
              <tr id={row.anchor ?? undefined}>
                <td data-col={columns(c.reference)[0]}>{row.who}</td>
                <td data-col={columns(c.reference)[1]}>
                  <code class={codeBreakClass(row.call)} set:html={codeBreakHtml(row.call)} />
                </td>
                <td data-col={columns(c.reference)[2]}>
                  {row.returns.map((line) => (
                    <span class="gmt-matrix-line">
                      <code class={codeBreakClass(line)} set:html={codeBreakHtml(line)} />
                    </span>
                  ))}
                </td>
                <td data-col={columns(c.reference)[3]}>{row.verdict}</td>
                <td data-col={columns(c.reference)[4]}>
                  {row.issues.length === 0
                    ? "none"
                    : row.issues.map((issue, index) => (
                        <>
                          {index > 0 && ", "}
                          <a href={issue.url}>{issue.text}</a>
                        </>
                      ))}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))
}
