---
/**
 * The full behaviour matrix: one section per case. Each case opens with its facts (the input, the
 * form results are compared in, Temporal's result and the clause), then lists GMT's result and
 * each library's as a short code frame: the call, and what it gave as a comment.
 *
 * Every figure comes from `data/behaviour-matrix.json`, which `scripts/behaviour-matrix/run.mjs`
 * writes. Each library entry carries the anchor `m1-date-fns` so the `/migrate/` pages can link to
 * it. The verdict is a badge whose word names it; the icon and tone only repeat it. The Markdown
 * twin is `renderBehaviourMatrix` in `src/lib/mdx-jsx.ts`.
 */
import { Code } from "@astrojs/starlight/components";
import { VERDICT_BADGE, codeSpans, matrixView } from "../lib/migrate-view";
import { badge } from "../widgets/builders/badge";

const cases = matrixView();
---

{
  cases.map((c) => (
    <section class="gmt-matrix-case">
      <h2 id={c.anchor}>
        {c.id}. {c.title}
      </h2>
      <dl class="gmt-matrix-facts">
        {c.facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd set:html={codeSpans(fact.text)} />
          </div>
        ))}
        <div>
          <dt>Specification</dt>
          <dd>
            {c.clauses.map((clause, index) => (
              <>
                {index > 0 && ", "}
                <a href={clause.url}>{clause.label}</a>
              </>
            ))}
          </dd>
        </div>
      </dl>
      {c.notes.map((note) => (
        <p set:html={codeSpans(note)} />
      ))}
      <ul class="gmt-matrix-entries" aria-label={`${c.id} results`}>
        {c.entries.map((entry) => (
          <li class="gmt-matrix-entry" id={entry.anchor ?? undefined}>
            <p class="gmt-matrix-head">
              <span class="gmt-matrix-name">{entry.name}</span>
              <span set:html={String(badge(VERDICT_BADGE[entry.verdict]))} />
            </p>
            <Code code={entry.code} lang="js" wrap />
            {entry.issues.length > 0 && (
              <p class="gmt-matrix-issues">
                <span class="gmt-matrix-label">Upstream</span>{" "}
                {entry.issues.map((issue, index) => (
                  <>
                    {index > 0 && ", "}
                    <a href={issue.url}>{issue.text}</a>
                  </>
                ))}
              </p>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))
}

<style is:global>
/* ---- Behaviour matrix ---- */

/* The facts sit in one bordered box; the code frames under it are frames of their own. */
.gmt-matrix-facts {
  display: grid;
  gap: 0.35rem;
  padding: 0.75rem 1rem;
  border: 1px solid var(--gmt-border);
  border-radius: var(--gmt-radius-sm, 0.25rem);
  font-size: var(--sl-text-sm);
}

/* Starlight's prose rules space every sibling and indent a `dd`; the box sets its own. */
.gmt-matrix-facts > div {
  margin: 0;
  display: grid;
  grid-template-columns: 9.5rem minmax(0, 1fr);
  gap: 0.75rem;
}

.gmt-matrix-facts dt {
  font-weight: 600;
  color: var(--gmt-ice);
}

.gmt-matrix-facts dd {
  margin: 0;
  padding: 0;
  overflow-wrap: anywhere;
}

.gmt-matrix-case {
  container: gmt-matrix / inline-size;
}

.gmt-matrix-entries {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 1rem 1.25rem;
  list-style: none;
  padding: 0;
}

.gmt-matrix-entry {
  margin: 0;
  scroll-margin-block-start: calc(var(--sl-nav-height, 3.5rem) + 1rem);
}

.gmt-matrix-entry > * {
  margin: 0;
}

/* A link from a /migrate/ page lands on one entry; a full outline shows which. */
.gmt-matrix-entry:target {
  border-radius: var(--gmt-radius-sm, 0.25rem);
  outline: 2px solid var(--gmt-cyan);
  outline-offset: 0.4rem;
}

.gmt-matrix-head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.35rem 0.6rem;
  margin-block-end: 0.4rem;
  font-size: var(--sl-text-sm);
}

.gmt-matrix-issues {
  margin-block-start: 0.4rem;
  font-size: var(--sl-text-sm);
}

.gmt-matrix-name,
.gmt-matrix-label {
  font-weight: 600;
  color: var(--gmt-ice);
}

@container gmt-matrix (width > 40rem) {
  .gmt-matrix-entries {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (width <= 30rem) {
  .gmt-matrix-facts > div {
    grid-template-columns: minmax(0, 1fr);
    gap: 0.1rem;
  }
}
</style>
