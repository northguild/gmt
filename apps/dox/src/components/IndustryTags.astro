---
/**
 * The industry tags under a tool page's title: an icon and a word each, linking
 * to that industry's group on the tools index.
 *
 * One style for every industry. The word carries the meaning and the icon backs
 * it up; no industry has a colour of its own, because colour never says anything
 * alone here and there will be more industries than accents. Core is the quiet
 * variant, since it is the absence of an industry rather than one more of them.
 */
import { CORE_INDUSTRY, toolIndustry, toolIndustryHref } from "../lib/tool-industries";
import Icon from "./Icon.astro";

interface Props {
  industries: readonly string[];
}

const tags = Astro.props.industries.flatMap((id) => toolIndustry(id) ?? []);
---

{
  tags.length > 0 && (
    <ul class="gmt-industry-tags not-content" aria-label="Industry">
      {tags.map((tag) => (
        <li>
          <a
            class:list={[
              "gmt-industry-tag",
              "gmt-sonar-focus",
              tag.id === CORE_INDUSTRY && "gmt-industry-tag--core",
            ]}
            href={toolIndustryHref(tag.id)}
            title={tag.definition}
          >
            <Icon name={tag.icon} size="14px" />
            <span>{tag.label}</span>
          </a>
        </li>
      ))}
    </ul>
  )
}
