---
import { renderDataCreditsHtml, TZ_BOUNDARIES } from "../lib/data-credits";
import { TIMEZONES } from "../lib/timezones";
import { zoneMapShell } from "../widgets/families/zones/zone-map-shell";

interface Props {
  title?: string;
  caption?: string;
}

const { title, caption } = Astro.props;
/* The map draws the time-zone boundaries, so its credit sits in the drawing's corner. */
const markup = zoneMapShell({
  idPrefix: "timezone-map",
  zones: TIMEZONES,
  title,
  caption,
  credits: renderDataCreditsHtml([TZ_BOUNDARIES], {
    id: "tz-map-data-credits",
    placement: "corner",
  }),
}).value;
---

<Fragment set:html={markup} />

<script>
  import { watchDataCredits } from "../lib/data-credits";
  import { mountTimezoneMap } from "../lib/timezone-map";
  import { showUnavailable } from "../lib/widget-mount";

  watchDataCredits();

  document
    .querySelectorAll<HTMLElement>('[data-widget="timezone-map"]')
    .forEach((el) => {
      mountTimezoneMap(el, new AbortController().signal).catch((error) =>
        showUnavailable(el, error),
      );
    });
</script>
