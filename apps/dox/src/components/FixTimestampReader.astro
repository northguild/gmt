---
/**
 * FIX Timestamp Reader widget (FIN-95).
 *
 * A FIX `UTCTimestamp`, read by `parseFixUtcTimestamp` and `isValidFixUtcTimestamp`: the
 * instant, the precision its digit count states, whether a second 60 is an inserted leap second
 * and the picosecond digits apart from the instant. A second section writes one instant at the
 * five precisions with `formatFixUtcTimestamp`.
 *
 * **The markup and the wiring both live in `lib/fix-timestamp-reader-mount.ts`**,
 * so the chat rail mounts the same widget this page server-renders.
 */

import { renderFixTimestampReaderTemplate } from "../lib/fix-timestamp-reader-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane` and drop the max-width of every
 * `.sl-container` inside `main`. That is all the marker does: how the prose
 * around the widget is laid out is ToolLayout.astro's job, not this one's.
 *
 * Default `false`, which is the safe direction: a page that embeds the widget
 * in prose keeps the prose column. Only the tools page opts in. The marker goes
 * on a wrapper here rather than inside `renderTemplate()`
 * so the mount's markup stays byte-identical and `scripts/html-diff.mjs` sees
 * the widget itself as unchanged.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderFixTimestampReaderTemplate("fix-timestamp-reader", {}).value;
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountFixTimestampReader } from "../lib/fix-timestamp-reader-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    /* A `?w=fixstamp&wa=` permalink seeds the widget with the values it names;
       see lib/widget-permalink.ts. Absent or malformed, the widget opens on
       its first preset. */
    const seed = seedFromLocation("fixstamp");
    document.querySelectorAll<HTMLElement>('[data-widget="fix-timestamp-reader"]').forEach((el) => {
      mountFixTimestampReader(el, seed, new AbortController().signal).catch(
        (error) => showUnavailable(el, error),
      );
    });
  }
</script>
