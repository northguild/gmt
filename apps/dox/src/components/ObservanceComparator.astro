---
/**
 * Observance Comparator widget (CORE-54).
 *
 * One to three holidays under two to four policies, as one matrix of observed dates.
 *
 * **The markup and the wiring both live in `lib/observance-comparator-mount.ts`**,
 * so the chat rail mounts the same widget this page server-renders.
 */
import { renderObservanceComparatorTemplate } from "../lib/observance-comparator-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane`. Default `false`, the safe direction for a
 * reference page that embeds the widget.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderObservanceComparatorTemplate("observance-comparator", {}).value;
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountObservanceComparator } from "../lib/observance-comparator-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    const seed = seedFromLocation("observance");
    document
      .querySelectorAll<HTMLElement>('[data-widget="observance-comparator"]')
      .forEach((el) => {
        mountObservanceComparator(el, seed, new AbortController().signal).catch(
          (error) => showUnavailable(el, error),
        );
      });
  }
</script>
