---
/**
 * Holiday Rule Builder widget (CORE-54).
 *
 * An ordered list of holiday rules, a weekend, a zone and a year, drawn on 12
 * month grids, with the printed `buildBusinessCalendar` call and the calendar
 * it returns.
 *
 * **The markup and the wiring both live in `lib/holiday-rule-builder-mount.ts`**,
 * so the chat rail mounts the same widget this page server-renders.
 */
import { renderHolidayRuleBuilderTemplate } from "../lib/holiday-rule-builder-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane`. Default `false`, the safe direction for a
 * reference page that embeds the widget.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderHolidayRuleBuilderTemplate("holiday-rule-builder", {});
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountHolidayRuleBuilder } from "../lib/holiday-rule-builder-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    const seed = seedFromLocation("holidays");
    document
      .querySelectorAll<HTMLElement>(`[data-widget="holiday-rule-builder"]`)
      .forEach((el) => {
        mountHolidayRuleBuilder(el, seed, new AbortController().signal).catch(
          (error) => showUnavailable(el, error),
        );
      });
  }
</script>
