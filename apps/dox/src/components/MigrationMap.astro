---
/**
 * One library's calls as code pairs: their call beside the GMT code that replaces it, with the
 * imports and the first example from each function's reference page, then a note and links.
 *
 * The rows are `data/migration-maps.ts`; `part="more"` prints the shorter list of further calls.
 * The Markdown twin is `renderMigrationMap` in `src/lib/mdx-jsx.ts`.
 */
import CodePairs from "./CodePairs.astro";
import { libraryOf } from "../data/behaviour-matrix";
import { libraryProp, mapPairs } from "../lib/migrate-view";

interface Props {
  library: string;
  part?: "rows" | "more";
}

const { library, part = "rows" } = Astro.props;
const id = libraryProp(library, "MigrationMap");
---

<CodePairs pairs={mapPairs(id, part)} label={`${libraryOf(id).name} calls and their GMT code`} />
