---
/**
 * GTFS Service Day Clock widget (RAI-100).
 *
 * A service date, a stop time and the agency's zone, read by `gtfsToInstant` next to what a
 * midnight anchor gives, drawn on one day rail with the clock change marked.
 *
 * **The markup and the wiring both live in `lib/gtfs-service-day-clock-mount.ts`**,
 * so the chat rail mounts the same widget this page server-renders.
 */

import { renderGtfsServiceDayClockTemplate } from "../lib/gtfs-service-day-clock-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane` and drop the max-width of every
 * `.sl-container` inside `main`. That is all the marker does: how the prose
 * around the widget is laid out is ToolLayout.astro's job, not this one's.
 *
 * Default `false`, which is the safe direction: a page that embeds the widget
 * in prose keeps the prose column. Only the tools page opts in. The marker goes
 * on a wrapper here rather than inside `renderTemplate()`
 * so the mount's markup stays byte-identical and `scripts/html-diff.mjs` sees
 * the widget itself as unchanged.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderGtfsServiceDayClockTemplate("gtfs-service-day-clock", {}).value;
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountGtfsServiceDayClock } from "../lib/gtfs-service-day-clock-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";
  import { offerPageTool } from "../lib/webmcp/offer";

  if (typeof window !== "undefined") {
    /* A `?w=gtfsday&wa=` permalink seeds the widget with the preset or the values it names;
       see lib/widget-permalink.ts. Absent or malformed, the widget opens on its first preset. */
    const seed = seedFromLocation("gtfsday");
    document
      .querySelectorAll<HTMLElement>('[data-widget="gtfs-service-day-clock"]')
      .forEach((el) => {
        mountGtfsServiceDayClock(el, seed, new AbortController().signal).catch(
          (error) => showUnavailable(el, error),
        );
      });
    void offerPageTool(
      "gtfs-service-day-clock",
      () => import("../lib/webmcp/tools/gtfs-service-day-clock"),
    );
  }
</script>
