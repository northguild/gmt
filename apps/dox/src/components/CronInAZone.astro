---
/**
 * Cron in a Zone widget (CORE-84).
 *
 * A cron line read in a zone: the night of a clock change under both of
 * `cronRuns`' rules, the next twelve runs under each, and the calls made.
 *
 * **The markup and the wiring both live in `lib/cron-in-a-zone-mount.ts`**,
 * so the chat rail mounts the same widget this page server-renders.
 */
import { renderCronInAZoneTemplate } from "../lib/cron-in-a-zone-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane`. Default `false`, the safe direction for a
 * reference page that embeds the widget.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderCronInAZoneTemplate();
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountCronInAZone } from "../lib/cron-in-a-zone-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    const seed = seedFromLocation("cronzone");
    document
      .querySelectorAll<HTMLElement>(".gmt-cron-zone")
      .forEach((el) => {
        mountCronInAZone(el, seed, new AbortController().signal).catch(
          (error) => showUnavailable(el, error),
        );
      });
  }
</script>
