---
import { alternativesStack as stack } from "../data/date-alternatives";
import SectionHeading from "./SectionHeading.astro";

/**
 * Homepage grid section: why the popular Date alternatives either inherit
 * its flaws (they wrap Date under the hood) or step off the TC39 standard.
 * Split from the former WhyNotDate.astro so this and WhyDateBug.astro can
 * sit in separate homepage grid cells instead of one combined block.
 *
 * Static — no hydration. Scoped `<style>` only; every value goes through a
 * `--gmt-*` token. No `backdrop-filter`, so no transparency/contrast gate is
 * needed beyond what the tokens already carry.
 *
 * The rows come from apps/dox/src/data/date-alternatives.ts, which the text
 * surfaces read too.
 */

interface Props {
  /** `home`: one line per library, name then foundation. `full`: with each library's detail. */
  variant: "home" | "full";
}

const { variant } = Astro.props;
---

{
  variant === "home" ? (
    <ul class="why-date-rows">
      {stack.map((l) => (
        <li class:list={["why-date-row", `why-date-row--${l.kind}`]}>
          <code class="why-date-layer-name">{l.name}</code>
          <span class="why-date-arrow" aria-hidden="true">
            →
          </span>
          <span class="why-date-layer-foundation">{l.foundation}</span>
        </li>
      ))}
    </ul>
  ) : (
<section class="why-date-block">
  <SectionHeading id="the-alternatives-inherit-it">The alternatives inherit it, or deviate from the standard</SectionHeading>
  <p class="why-date-lede">
    The popular libraries do not replace <code>Date</code>; they decorate it,
    so the faults come along — our gmt lint packages ban the Date wrappers
    below outright. The one library that fixes the model does it with a
    non-standard API you will migrate off. GMT is Temporal — the standard —
    with the ergonomics added on top.
  </p>

  <ol class="why-date-layers" data-reveal-group>
    {
      stack.map((l) => (
        <li class:list={["why-date-layer", `why-date-layer--${l.kind}`]}>
          <span class="why-date-layer-name">{l.name}</span>
          <span class="why-date-layer-detail">{l.detail}</span>
          <span class="why-date-layer-foundation">{l.foundation}</span>
        </li>
      ))
    }
  </ol>
</section>
  )
}

<style>
  .why-date-block {
    display: flex;
    flex-direction: column;
    gap: var(--gmt-space-4);
  }



  .why-date-lede {
    margin: 0;
    max-inline-size: 68ch;
    color: var(--gmt-ice-dim);
    line-height: 1.6;
  }

  .why-date-block code,
  .why-date-rows code {
    font-family: var(--gmt-font-mono);
    font-size: max(0.85em, var(--gmt-text-xs));
    background: var(--gmt-code-bg);
    border: 1px solid var(--gmt-code-border);
    border-radius: var(--gmt-radius-sm);
    corner-shape: bevel;
    padding: 0.1em 0.35em;
  }

  .why-date-layers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gmt-space-2);
  }

  .why-date-layer {
    display: grid;
    grid-template-columns: minmax(8rem, 12rem) 1fr auto;
    gap: var(--gmt-space-3) var(--gmt-space-4);
    align-items: baseline;
    padding: var(--gmt-space-3) var(--gmt-space-4);
    background: var(--gmt-fill-subtle);
    border: 1px solid var(--gmt-hairline);
    border-radius: var(--gmt-radius-lg);
    corner-shape: bevel;
  }

  /* The landing page's short list. The kind sets the colour of the whole row's border and of
     the foundation, in the same three colours as the full list. */
  .why-date-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  .why-date-row {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) auto minmax(0, 1fr);
    gap: 0.7rem;
    align-items: center;
    margin: 0;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--gmt-hairline);
    border-radius: var(--gmt-bevel-sm);
    corner-shape: bevel;
    background: var(--gmt-fill-subtle);
    font-size: 0.7813rem;
  }

  /* A landing pane wide enough for two short rows side by side shows the list in two columns,
     so the page fits without scrolling. A name keeps its full width; an odd last row spans both.
     The pane is the `gmt-grid-section` container (dox.css). */
  @container gmt-grid-section (inline-size >= 34rem) {
    .why-date-rows {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .why-date-row {
      grid-template-columns: auto auto minmax(0, 1fr);
      gap: 0.4rem;
      padding-inline: 0.6rem;
    }

    /* stylelint-disable-next-line selector-pseudo-class-disallowed-list -- an odd row out is a position; the markup carries no state to select it by */
    .why-date-row:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  .why-date-row > .why-date-layer-name {
    justify-self: start;
    max-inline-size: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--gmt-ice);
    font-weight: 500;
  }

  .why-date-row > .why-date-layer-foundation {
    justify-self: start;
    font-family: inherit;
    font-size: inherit;
    letter-spacing: normal;
    text-transform: none;
    white-space: normal;
    color: var(--gmt-signal-ink);
  }

  .why-date-arrow {
    color: var(--gmt-ice-dim);
  }

  .why-date-row--date,
  .why-date-row--wraps,
  .why-date-row--nonstandard {
    border-color: var(--gmt-signal-border);
  }

  .why-date-row--standard,
  .why-date-row--gmt {
    border-color: color(from var(--gmt-spring) srgb r g b / 35%);
  }

  .why-date-row--standard > .why-date-layer-foundation,
  .why-date-row--gmt > .why-date-layer-foundation {
    color: var(--gmt-spring-ink);
  }

  .why-date-layer-name {
    font-family: var(--gmt-font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--gmt-signal-ink);
    overflow-wrap: anywhere;
  }

  .why-date-layer-detail {
    color: var(--gmt-ice);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .why-date-layer-foundation {
    justify-self: end;
    font-family: var(--gmt-font-mono);
    font-size: var(--gmt-text-xs);
    letter-spacing: var(--gmt-tracking-wide);
    text-transform: uppercase;
    color: var(--gmt-ice-dim);
    white-space: nowrap;
  }

  /* Everything that is not the standard shares the fault colour (orange):
     Date, its wrappers, and @internationalized/date. The wrappers are indented
     to read as branching off Date. Temporal and GMT are green (the standard
     path). */
  .why-date-layer--date,
  .why-date-layer--wraps,
  .why-date-layer--nonstandard {
    border-color: var(--gmt-signal-border);
  }

  .why-date-layer--date .why-date-layer-name,
  .why-date-layer--date .why-date-layer-foundation,
  .why-date-layer--nonstandard .why-date-layer-name,
  .why-date-layer--nonstandard .why-date-layer-foundation,
  .why-date-layer--wraps .why-date-layer-foundation {
    color: var(--gmt-signal-ink);
  }

  .why-date-layer--wraps,
  .why-date-layer--gmt {
    margin-inline-start: var(--gmt-space-6);
  }

  .why-date-layer--standard,
  .why-date-layer--gmt {
    border-color: color(from var(--gmt-spring) srgb r g b / 35%);
  }

  .why-date-layer--standard .why-date-layer-name,
  .why-date-layer--standard .why-date-layer-foundation,
  .why-date-layer--gmt .why-date-layer-name,
  .why-date-layer--gmt .why-date-layer-foundation {
    color: var(--gmt-spring-ink);
  }

  /* Container query (not @media): this section can be squeezed into one of
     several columns in the homepage's GridSection grid at any viewport
     width, leaving the fixed minmax(8rem,12rem) name + auto foundation
     columns almost nothing for the 1fr detail column — the text was
     wrapping one word per line instead of flowing naturally. Stack to a
     single column whenever the section itself is narrow, not just on a
     narrow viewport. .gmt-grid-section (dox.css) is the named container;
     45rem matches the threshold used for the fault grid's own 3-column
     switch in WhyDateBug.astro. */
  @container gmt-grid-section (max-width: 45rem) {
    .why-date-layer {
      grid-template-columns: 1fr;
      gap: var(--gmt-space-1);
    }

    .why-date-layer-foundation {
      justify-self: start;
    }

    .why-date-layer--wraps,
    .why-date-layer--gmt {
      margin-inline-start: var(--gmt-space-4);
    }
  }
</style>
