---
import { Image } from 'astro:assets';
import LinkButton from './LinkButton.astro';

// Mirrors Starlight's internal PAGE_TITLE_ID — not exported publicly.
const PAGE_TITLE_ID = '_top';

interface Action {
	attrs?: { class?: string; [key: string]: unknown };
	icon?: { name?: string; html?: string };
	link: string;
	text: string;
	variant?: 'primary' | 'secondary' | 'minimal';
}

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero || {};

const imageAttrs = {
	loading: 'eager' as const,
	decoding: 'async' as const,
	width: 400,
	height: 400,
	alt: image?.alt || '',
};

let darkImage: ImageMetadata | undefined;
let lightImage: ImageMetadata | undefined;
let rawHtml: string | undefined;
if (image) {
	if ('file' in image) {
		darkImage = image.file;
	} else if ('dark' in image) {
		darkImage = image.dark;
		lightImage = image.light;
	} else {
		rawHtml = image.html;
	}
}

function isExternal(href: string) {
	return href.startsWith('http://') || href.startsWith('https://');
}
---

<div class="hero">
	{
		darkImage && (
			<Image
				src={darkImage}
				{...imageAttrs}
				class:list={{ 'light:sl-hidden': Boolean(lightImage) }}
			/>
		)
	}
	{lightImage && <Image src={lightImage} {...imageAttrs} class="dark:sl-hidden" />}
	{rawHtml && <div class="hero-html sl-flex" set:html={rawHtml} />}
	<div class="sl-flex stack">
		<div class="sl-flex copy">
			<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
			{tagline && <div class="tagline" set:html={tagline} />}
		</div>
		{
			actions.length > 0 && (
				<div class="sl-flex actions">
					{(actions as Action[]).map(
						({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => {
							const external = isExternal(href);
							if (attrs['data-copy-prompt']) {
								return (
									<LinkButton
										as="button"
										type="button"
										variant="ghost"
										icon="copy"
										class:list={[className]}
										{...attrs}
									>
										<span data-copy-label data-copy-idle={text}>
											{text}
										</span>
									</LinkButton>
								);
							}
							return (
								<LinkButton
									{href}
									{variant}
									icon={icon?.name}
									class:list={[className]}
									{...attrs}
									target={external ? '_blank' : undefined}
									rel={external ? 'noopener noreferrer' : undefined}
								>
									{text}
									{icon?.html && <Fragment set:html={icon.html} />}
								</LinkButton>
							);
						}
					)}
				</div>
			)
		}
	</div>
</div>

<script>
	import { AGENT_PROMPT } from '~/lib/agent-prompt';

	const RESET_MS = 2000;

	function wire() {
		const buttons = document.querySelectorAll<HTMLElement>('[data-copy-prompt]');
		for (const btn of buttons) {
			if (btn.dataset.copyBound === 'true') continue;
			btn.dataset.copyBound = 'true';
			btn.addEventListener('click', async () => {
				const label = btn.querySelector<HTMLElement>('[data-copy-label]');
				try {
					await navigator.clipboard.writeText(AGENT_PROMPT);
					if (label) label.textContent = 'Copied!';
					btn.classList.add('is-copied');
				} catch {
					if (label) label.textContent = 'Copy failed';
				}
				window.setTimeout(() => {
					if (label) label.textContent = label.dataset.copyIdle ?? 'Copy GMT prompt';
					btn.classList.remove('is-copied');
				}, RESET_MS);
			});
		}
	}

	wire();
	document.addEventListener('astro:page-load', wire);
</script>

<style>
	@layer starlight.core {
		.hero {
			display: grid;
			grid-template-columns: 100%;
			align-items: center;
			gap: 1rem;
			padding-bottom: 1rem;
		}

		.hero > img,
		.hero > .hero-html {
			object-fit: contain;
			width: min(70%, 20rem);
			height: auto;
			margin-inline: auto;
		}

		.stack {
			flex-direction: column;
			gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
			text-align: center;
		}

		.copy {
			flex-direction: column;
			gap: 1rem;
			align-items: center;
		}

		.copy > * {
			max-width: 50ch;
		}

		h1 {
			font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-6xl));
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}

		.tagline {
			font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
			color: var(--sl-color-gray-2);
		}

		.actions {
			gap: 1rem 2rem;
			flex-wrap: wrap;
			justify-content: center;
		}

		@media (min-width: 50rem) {
			.hero {
				grid-template-columns: 7fr 4fr;
				gap: 3%;
				padding-block: clamp(0.75rem, calc(0.25rem + 2vmin), 1.5rem);
			}

			.hero > img,
			.hero > .hero-html {
				order: 2;
				width: min(100%, 25rem);
			}

			.stack {
				text-align: start;
			}

			.copy {
				align-items: flex-start;
			}

			.actions {
				justify-content: flex-start;
			}
		}
	}
</style>
