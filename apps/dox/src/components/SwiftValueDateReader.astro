---
/**
 * SWIFT Value Date Reader widget (FIN-96).
 *
 * A SWIFT value date (`YYMMDD`), read by `parseSwiftDate` and `isValidSwiftDate`: the date, the
 * century SWIFT's rule gives it, and the T50 refusal. A table states the century as the library
 * reads it, and a last section writes an ISO date back with `formatSwiftDate`.
 *
 * **The markup and the wiring both live in `lib/swift-value-date-reader-mount.ts`**,
 * so the chat rail mounts the same widget this page server-renders.
 */

import { renderSwiftValueDateReaderTemplate } from "../lib/swift-value-date-reader-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane` and drop the max-width of every
 * `.sl-container` inside `main`. That is all the marker does: how the prose
 * around the widget is laid out is ToolLayout.astro's job, not this one's.
 *
 * Default `false`, which is the safe direction: a page that embeds the widget
 * in prose keeps the prose column. Only the tools page opts in. The marker goes
 * on a wrapper here rather than inside `renderTemplate()`
 * so the mount's markup stays byte-identical and `scripts/html-diff.mjs` sees
 * the widget itself as unchanged.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderSwiftValueDateReaderTemplate("swift-value-date-reader", {}).value;
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountSwiftValueDateReader } from "../lib/swift-value-date-reader-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    /* A `?w=swiftdate&wa=` permalink seeds the widget with the values it names;
       see lib/widget-permalink.ts. Absent or malformed, the widget opens on
       its first preset. */
    const seed = seedFromLocation("swiftdate");
    document.querySelectorAll<HTMLElement>('[data-widget="swift-value-date-reader"]').forEach((el) => {
      mountSwiftValueDateReader(el, seed, new AbortController().signal).catch(
        (error) => showUnavailable(el, error),
      );
    });
  }
</script>
