---
// Override of Starlight's Sidebar: the same tree, drawn by our SidebarSublist so the
// API Reference can carry the "By industry" divider (a label, not a group or a link).
// The sidebar is trimmed to the page's namespace, and the previous/next links are moved off the
// divider, in the route middleware (`src/route-data.ts`, `src/lib/lean-sidebar.ts`).
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from './SidebarSublist.astro';

const { sidebar } = Astro.locals.starlightRoute;
---

<SidebarPersister>
	<SidebarSublist sublist={sidebar} />
</SidebarPersister>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>
