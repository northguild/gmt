---
import { Code } from "@astrojs/starlight/components";
import styles from "../widgets/tools/mistake.module.css";
import PlaygroundForm from "./PlaygroundForm.astro";

interface Props {
  severity: "critical" | "high" | "medium";
  title: string;
  description?: string;
  wrongCode: string;
  wrongSpecId?: string;
  rightCode: string;
  rightSpecId?: string;
}

const { severity, title, description, wrongCode, wrongSpecId, rightCode, rightSpecId } = Astro.props;
---

<div class={styles.root}>
  <div class={styles.header}>
    <span class:list={[styles.badge, styles[severity]]}>{severity.toUpperCase()}</span>
    <h3 class={styles.title}>{title}</h3>
  </div>

  {description && <p class={styles.description}>{description}</p>}

  <div class={styles.pair}>
    <div class={styles.side}>
      <h4 class:list={[styles.sideTitle, styles.wrongTitle]}>Wrong</h4>
      <Code code={wrongCode} lang="js" />
      {wrongSpecId && <PlaygroundForm specId={wrongSpecId} tone="wrong" />}
    </div>

    <div class={styles.side}>
      <h4 class:list={[styles.sideTitle, styles.rightTitle]}>Right</h4>
      <Code code={rightCode} lang="js" />
      {rightSpecId && <PlaygroundForm specId={rightSpecId} tone="right" />}
    </div>
  </div>
</div>
