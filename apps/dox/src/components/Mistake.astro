---
import { Code } from "@astrojs/starlight/components";
import PlaygroundForm from "./PlaygroundForm.astro";

interface Props {
  severity: "critical" | "high" | "medium";
  title: string;
  description?: string;
  wrongCode: string;
  wrongSpecId?: string;
  rightCode: string;
  rightSpecId?: string;
  disableCopy?: boolean;
}

const { severity, title, description, wrongCode, wrongSpecId, rightCode, rightSpecId, disableCopy } = Astro.props;
---

<div class="gmt-mistake">
  <div class="gmt-mistake-header">
    <span class={`gmt-mistake-badge gmt-mistake-badge--${severity}`}>{severity.toUpperCase()}</span>
    <h3>{title}</h3>
  </div>

  {description && <p>{description}</p>}

  <div class="gmt-mistake-pair">
    <div class="gmt-mistake-side gmt-mistake-side--wrong">
      <h4>Wrong</h4>
      <Code code={wrongCode} lang="js" class={disableCopy ? "gmt-mistake-code--no-copy" : ""} />
      {wrongSpecId && (
        <PlaygroundForm specId={wrongSpecId} />
      )}
    </div>

    <div class="gmt-mistake-side gmt-mistake-side--right">
      <h4>Right</h4>
      <Code code={rightCode} lang="js" />
      {rightSpecId && (
        <PlaygroundForm specId={rightSpecId} />
      )}
    </div>
  </div>
</div>
