---
/**
 * One card of the `/upstream/` tracker, laid out like a row on GitHub: a state icon, the title and
 * `repo#number` on top with the state badge at the end, then the summary, the chips, and a meta
 * line of icons.
 *
 * Everything that varies per filing is decided in `lib/upstream-badges.ts` from the filing's own
 * fields, so no status is typed by hand. The cells carry no `data-col`: the card is a header, a
 * body and a meta line, not label/value pairs.
 */
import { shortRef } from "../data/temporal-compat";
import type { UpstreamFiling } from "../data/upstream-filings";
import { inlineCodeHtml } from "../lib/inline-code-html";
import { octicon } from "../lib/octicons";
import {
  chip,
  gmtBadge,
  reviewBadge,
  roleBadge,
  stateBadge,
  stateNote,
  workBadge,
} from "../lib/upstream-badges";
import { countLabel, countNoun } from "../lib/upstream-status";
import UpstreamFilingRefs from "./UpstreamFilingRefs.astro";

interface Props {
  filing: UpstreamFiling;
  /** Formats an ISO stamp for display; passed in so the whole table shares one formatter. */
  formatDate: (iso: string) => string;
}

// Asserted rather than left to Astro's own `Props` inference: this app's `tsconfig.json` sets
// `jsx: "react-jsx"` for its React islands, which turns that inference off, so `Astro.props` is
// `Record<string, any>` in every `.astro` file here.
const { filing, formatDate } = Astro.props as Props;

const state = stateBadge(filing);
const secondary = [reviewBadge(filing), workBadge(filing.work), roleBadge(filing)].filter(
  (b) => b !== null,
);
const inGmt = gmtBadge(filing);
const note = stateNote(filing);

/** The `Polyfill: ` prefix is noise in a table whose rows are already grouped by repository. */
const title = filing.title.replace(/^Polyfill: /, "");

/** Shown only when no workaround covers the defect, so the two never contradict each other. */
const gmtNote = filing.gmtGuard ? null : filing.gmtNote;
---

<tr data-tone={state.tone}>
  <td class="gmt-upstream-head">
    <span class="gmt-upstream-state" set:html={octicon(state.icon)} />
    <span class="gmt-sr-only">{filing.kind === "pr" ? "Pull request:" : "Issue:"}</span>
    <strong class="gmt-upstream-title" set:html={inlineCodeHtml(title)} />
    <a class="gmt-upstream-ref" href={filing.url}>{shortRef(filing.repo, filing.number)}</a>
    <span class="gmt-upstream-status" set:html={chip(state, { fill: true })} />
  </td>
  <td class="gmt-upstream-body">
    {filing.summary && <p class="gmt-upstream-summary" set:html={inlineCodeHtml(filing.summary)} />}
    {note && <p class="gmt-upstream-muted">{note}</p>}
    {filing.outcome && <p class="gmt-upstream-muted">{filing.outcome}</p>}
    <div class="gmt-upstream-chips">
      {secondary.map((b) => <span set:html={chip(b)} />)}
      <span class="gmt-upstream-ingmt">
        <span class="gmt-upstream-muted">In GMT</span>
        <span set:html={chip(inGmt)} />
      </span>
    </div>
    {gmtNote && <p class="gmt-upstream-links" set:html={inlineCodeHtml(gmtNote)} />}
    <UpstreamFilingRefs filing={filing} />
  </td>
  <td class="gmt-upstream-meta">
    <span class="gmt-upstream-fact">
      <span set:html={octicon("comment")} />
      <span class="gmt-sr-only">{countLabel(filing.maintainerComments, "maintainer reply", "maintainer replies")}</span>
      <span aria-hidden="true">{filing.maintainerComments}<span class="gmt-upstream-long"> {countNoun(filing.maintainerComments, "maintainer reply", "maintainer replies")}</span></span>
    </span>
    <span class="gmt-upstream-fact">
      <span set:html={octicon("clock")} />
      <span class="gmt-sr-only">Last activity: </span>
      <time datetime={filing.updatedAt}>{formatDate(filing.updatedAt)}</time>
    </span>
    {filing.role === "contributor" && (
      <span class="gmt-upstream-fact">
        <span set:html={octicon("link")} />
        <a href={filing.contributionUrl ?? filing.url}>we added evidence</a>
      </span>
    )}
  </td>
</tr>
