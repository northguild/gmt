---
/**
 * DST Transition Inspector widget (DOX-B2b).
 *
 * Visualises DST gap and overlap transitions for a chosen IANA zone + year
 * (via getDstTransitions) and lets the reader scrub a local wall-clock time
 * into startOfZoned, showing how disambiguation/offset options resolve (or
 * reject) the result.
 *
 * Shares its card/section/codeframe/output chrome with IntervalVisualizer.astro
 * — see styles/gmt-widget.css, lib/widget-ui.ts, components/CodeFrame.astro.
 *
 * **The markup and the wiring both live in `lib/dst-inspector-mount.ts`.**
 * DOX-C3b mounts this same widget into the chat rail, and a rail cannot
 * instantiate an Astro component — so one `renderDstTemplate()` serves both
 * surfaces, and this page still server-renders it. `scripts/html-diff.mjs`
 * asserts the built markup is unchanged by that move.
 */

import { renderDstTemplate } from "../lib/dst-inspector-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane` and drop `.sl-container`'s max-width, and
 * that the same sheet's prose rule reads to leave the widget out of the reading
 * measure it keeps everything else at.
 *
 * Default `false`, which is the safe direction: this widget is embedded on
 * `reference/**` prose pages as well as its own `/tools/` page, and those pages
 * must keep their 50rem column. Only the tools page opts in. On a reference
 * page the section grid simply fits fewer columns, which is what `auto-fit` is
 * for. The marker goes on a wrapper here rather than inside `renderTemplate()`
 * so the mount's markup stays byte-identical and `scripts/html-diff.mjs` sees
 * the widget itself as unchanged.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderDstTemplate();
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountDstInspector } from "../lib/dst-inspector-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  /* One mount per instance on the page. The rail passes a real AbortSignal;
     here nothing ever unmounts, so a never-aborted controller is honest about
     that rather than pretending there is a lifecycle to manage. */
  if (typeof window !== "undefined") {
    /* A `?w=&wa=` permalink seeds the widget with the state the link names —
       see lib/widget-permalink.ts. Absent or malformed, this is `{}` and the
       widget opens on its defaults, exactly as before. */
    const seed = seedFromLocation("dst");
    document.querySelectorAll<HTMLElement>(".gmt-dst").forEach((el) => {
      mountDstInspector(el, seed, new AbortController().signal).catch((error) =>
        showUnavailable(el, error),
      );
    });
  }
</script>
