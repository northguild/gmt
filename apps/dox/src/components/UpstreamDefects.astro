---
/**
 * The defect table: what GMT works around, and whether it still has to.
 *
 * One row per canary group, rendered by `UpstreamDefectRow.astro`. The filings for each row are
 * joined by `gmtGuard`, so a defect's paper trail follows it without anyone maintaining a second
 * list. The table sits in the site's table box (`.gmt-ref-table`), which scrolls it sideways on a
 * narrow screen; `src/lib/ref-table.ts` makes the box a focusable, named region while it
 * overflows, so the arrow keys reach the columns that are off screen. Styles are in its `<style>` block.
 */
import { compatGroups } from "../data/temporal-compat";
import { filings } from "../data/upstream-filings";
import UpstreamDefectRow from "./UpstreamDefectRow.astro";

/** The filings that name any of a group's canary ids, in the order the tracker lists them. */
const filingsFor = (defects: readonly string[]) =>
  filings.filter((f) => f.gmtGuard && defects.includes(f.gmtGuard));
---

<div class="gmt-ref-table" data-kind="content" data-label="Bugs GMT works around">
  <table class="gmt-defects">
    <thead>
      <tr>
        <th class="gmt-defects-what">What GMT works around</th>
        <th class="gmt-defects-state">Still needed?</th>
        <th class="gmt-defects-sent">What we sent</th>
      </tr>
    </thead>
    <tbody>
      {
        compatGroups.map((group) => (
          <UpstreamDefectRow group={group} filings={filingsFor(group.defects)} />
        ))
      }
    </tbody>
  </table>
</div>

<style is:global>
/* ---- The defect table: what GMT works around ---- */

/*
 * The table sits in the site's table box (`.gmt-ref-table`, gmt-content.css), which draws the
 * border and scrolls it sideways. Its first column is prose rather than a short label, so the
 * columns share the width in fixed proportions instead of sizing to their content. The selector
 * names the box so it outranks the box's own `table-layout: auto`.
 */
.sl-markdown-content .gmt-ref-table > .gmt-defects {
  min-inline-size: 34rem;
  table-layout: fixed;
  font-size: var(--sl-text-sm);
}

.sl-markdown-content .gmt-defects :is(th, td) {
  vertical-align: top;
  text-align: start;
  overflow-wrap: break-word;
}

.sl-markdown-content .gmt-defects .gmt-defects-what {
  inline-size: 50%;
  white-space: normal;
}

.sl-markdown-content .gmt-defects .gmt-defects-state {
  inline-size: 24%;
}

.sl-markdown-content .gmt-defects .gmt-defects-sent {
  inline-size: 26%;
}

/*
 * `--gmt-ice-dim` is the muted text tier that holds the 7:1 floor. `--sl-color-gray-3` measured
 * 4.39:1 on the dark page and 2.49:1 in the light cell, so every line here (the description and the
 * check count) used to sit under it.
 */
.sl-markdown-content .gmt-defects td p {
  margin-block-start: 0.25rem;
  color: var(--gmt-ice-dim);
  font-size: var(--sl-text-xs);
}

/* The state column is a share of a fixed table, and "✓ Yes, on Firefox" is wider than its
   content box at the table's 34rem minimum, so the badge wraps between words in its cell. */
.gmt-defects-badge {
  font-weight: 600;
}

/*
 * `--gmt-cyan-ink`, the house accent for text. Starlight's `--sl-color-green` measured 1.69:1 in
 * the light cell, far under the 7:1 floor; cyan-ink clears it in both themes. The `✓` carries the
 * meaning, so the badge does not rely on its colour.
 */
.gmt-defects-badge--ok {
  color: var(--gmt-cyan-ink);
}

.sl-markdown-content .gmt-defects-refs {
  margin: 0;
  padding: 0;
  list-style: none;
}

/*
 * `gmt-content.css` gives every list item in the content area an indent and a small bar for a
 * bullet. Both go here: a reference like `polyfill #369` is already close to the width of its
 * column, and the indent alone was enough to clip it. `padding-inline-start` is named as well as
 * `padding-left`, because the site sets the logical property and the physical one does not
 * override it on its own. A reference may wrap at its space: at 390 px `fullcalendar #126` is
 * wider than the column.
 */
.sl-markdown-content .gmt-defects-refs li {
  margin: 0 0 0.15rem;
  padding-inline-start: 0;
}

.sl-markdown-content .gmt-defects-refs li::before {
  display: none;
  content: none;
}

.gmt-defects-none {
  color: var(--sl-color-gray-4);
}

.gmt-upstream-links,
.gmt-upstream-muted {
  color: var(--gmt-ice-dim);
  font-size: var(--sl-text-xs);
}
</style>
