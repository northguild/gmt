---
/**
 * Title / tagline / CTA-actions block shared by the normal splash-page Hero
 * and the homepage's merged HeroGlobe. Extracted from Hero.astro so both
 * render identical copy markup and a11y wiring (data-page-title). The buttons
 * are HeroActions.astro; the landing passes none here and renders them in its
 * own row.
 */
import HeroActions, { type Action } from './HeroActions.astro';

// Mirrors Starlight's internal PAGE_TITLE_ID — not exported publicly.
const PAGE_TITLE_ID = '_top';

interface Props {
	/**
	 * A small line above the title. Starlight's hero schema has no such field, so the one page
	 * that wants it (the homepage hero) passes it here; its presence also selects that hero's
	 * left-aligned type and button recipe. Splash pages that do not pass it render as before.
	 */
	eyebrow?: string;
	data: {
		title: string;
		tagline?: string;
		actions?: Action[];
	};
}

const {
	eyebrow,
	data: { title, tagline, actions = [] },
} = Astro.props;
---

<div class:list={['sl-flex stack', { 'gmt-hero-lead': eyebrow }]}>
	<div class="sl-flex copy">
		{eyebrow && <p class="gmt-hero-eyebrow">{eyebrow}</p>}
		<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
		{tagline && <div class="tagline gmt-hero-tagline" set:html={tagline} />}
	</div>
	{actions.length > 0 && <HeroActions {actions} />}
</div>

<style>
	@layer starlight.core {
		.stack {
			flex-direction: column;
			gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
			text-align: center;
		}

		.copy {
			flex-direction: column;
			gap: 1rem;
			align-items: center;
		}

		.copy > * {
			max-inline-size: 50ch;
		}

		.tagline {
			font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
			color: var(--sl-color-gray-2);
		}

		@media (width >= 50rem) {
			.stack {
				text-align: start;
			}

			.copy {
				align-items: flex-start;
			}
		}
	}
</style>

<style>
	/* The homepage hero's copy column (the eyebrow variant). Unlayered, so it beats Starlight's
	   `.sl-markdown-content h1` (a layered rule) at any width; and it ships in this page's own
	   head, so the first paint already has the final sizes and nothing re-flows when a global
	   sheet arrives. Every size, gap and font the copy uses is set here and nowhere else; the
	   buttons' look is HeroActions.astro's. Every box here hugs its text and takes no pointer; only
	   the words do, so the Earth behind the gaps stays draggable. The 2rem gap is the space above
	   the buttons, so a hero that renders them elsewhere has none. */
	.gmt-hero-lead {
		align-items: flex-start;
		gap: 2rem;
		inline-size: fit-content;
		max-inline-size: 36rem;
		text-align: start;
		pointer-events: none;
	}

	.gmt-hero-lead .copy {
		align-items: flex-start;
		gap: 0;
		pointer-events: none;
	}

	.gmt-hero-lead :is(.gmt-hero-eyebrow, h1[data-page-title], .gmt-hero-tagline) {
		pointer-events: auto;
	}

	/* The copy has no panel behind it (HeroGlobe.astro), so each letter carries a tight dark
	   halo: readable over the Earth's day side or the Sun's glare, invisible over open space. */
	.gmt-hero-lead :is(.gmt-hero-eyebrow, h1[data-page-title], .gmt-hero-tagline) {
		text-shadow: var(--gmt-shadow-halo);
	}

	.gmt-hero-eyebrow {
		margin: 0 0 0.9rem;
		font-family: var(--gmt-font-display);
		font-size: 0.75rem;
		font-weight: 400;
		line-height: 1;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--gmt-cyan);
	}

	.gmt-hero-lead h1[data-page-title] {
		/* Narrower than the column, so the title breaks after "Give Me" at every width. */
		max-inline-size: 9em;
		margin: 0 0 0.9rem;
		font-family: var(--gmt-font-display);
		font-size: clamp(1.75rem, 2.8vw, 2.5rem);
		font-weight: 400;
		line-height: 1.15;
		letter-spacing: 0.02em;
		color: var(--gmt-ice);
	}

	.gmt-hero-lead .gmt-hero-tagline {
		max-inline-size: 32rem;
		margin: 0;
		font-family: var(--gmt-font-display);
		font-size: 1rem;
		font-weight: 400;
		line-height: 1.6;
		color: var(--gmt-ice);
	}
</style>
