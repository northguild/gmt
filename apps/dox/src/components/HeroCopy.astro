---
/**
 * Title / tagline / CTA-actions block shared by the normal splash-page Hero
 * and the homepage's merged HeroGlobe. Extracted from Hero.astro so both
 * render identical copy/actions markup, a11y wiring (data-page-title), and
 * clipboard-copy behavior without duplicating the LinkButton mapping logic.
 */
import LinkButton from './LinkButton.astro';

// Mirrors Starlight's internal PAGE_TITLE_ID — not exported publicly.
const PAGE_TITLE_ID = '_top';

interface Action {
	attrs?: { class?: string; [key: string]: unknown };
	icon?: { name?: string; html?: string };
	link: string;
	text: string;
	variant?: 'primary' | 'secondary' | 'minimal';
}

interface Props {
	data: {
		title: string;
		tagline?: string;
		actions?: Action[];
	};
}

const {
	data: { title, tagline, actions = [] },
} = Astro.props;

function isExternal(href: string) {
	return href.startsWith('http://') || href.startsWith('https://');
}
---

<div class="sl-flex stack">
	<div class="sl-flex copy">
		<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
		{tagline && <div class="tagline" set:html={tagline} />}
	</div>
	{
		actions.length > 0 && (
			<div class="sl-flex actions">
				{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => {
					const external = isExternal(href);
					if (attrs['data-copy-prompt']) {
						return (
							<LinkButton
								as="button"
								type="button"
								variant="ghost"
								icon="copy"
								class:list={[className]}
								{...attrs}
							>
								<span data-copy-label data-copy-idle={text}>
									{text}
								</span>
							</LinkButton>
						);
					}
					return (
						<LinkButton
							{href}
							{variant}
							icon={icon?.name}
							class:list={[className]}
							{...attrs}
							target={external ? '_blank' : undefined}
							rel={external ? 'noopener noreferrer' : undefined}
						>
							{text}
							{icon?.html && <Fragment set:html={icon.html} />}
						</LinkButton>
					);
				})}
			</div>
		)
	}
</div>

<script>
	import { AGENT_PROMPT } from '~/lib/agent-prompt';

	const RESET_MS = 2000;

	function wire() {
		const buttons = document.querySelectorAll<HTMLElement>('[data-copy-prompt]');
		for (const btn of buttons) {
			if (btn.dataset.copyBound === 'true') continue;
			btn.dataset.copyBound = 'true';
			btn.addEventListener('click', async () => {
				const label = btn.querySelector<HTMLElement>('[data-copy-label]');
				try {
					await navigator.clipboard.writeText(AGENT_PROMPT);
					if (label) label.textContent = 'Copied!';
					btn.classList.add('is-copied');
				} catch {
					if (label) label.textContent = 'Copy failed';
				}
				window.setTimeout(() => {
					if (label) label.textContent = label.dataset.copyIdle ?? 'Copy GMT prompt';
					btn.classList.remove('is-copied');
				}, RESET_MS);
			});
		}
	}

	wire();
	document.addEventListener('astro:page-load', wire);
</script>

<style>
	@layer starlight.core {
		.stack {
			flex-direction: column;
			gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
			text-align: center;
		}

		.copy {
			flex-direction: column;
			gap: 1rem;
			align-items: center;
		}

		.copy > * {
			max-width: 50ch;
		}

		h1 {
			font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-6xl));
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}

		.tagline {
			font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
			color: var(--sl-color-gray-2);
		}

		.actions {
			gap: 1rem 2rem;
			flex-wrap: wrap;
			justify-content: center;
		}

		@media (min-width: 50rem) {
			.stack {
				text-align: start;
			}

			.copy {
				align-items: flex-start;
			}

			.actions {
				justify-content: flex-start;
			}
		}
	}
</style>
