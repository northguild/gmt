---
// Override of Starlight's SiteTitle. After the NorthGuild link the header reads
// "/ gmt v1.21.0", the same pattern every NorthGuild app uses: a slash and the app's
// name in its theme colour, then the released version, small and dim.
// Starlight's `title` config stays "@northguild/gmt", so every <title>,
// og:site_name and social card keeps the name people search for and install.
// The slash is decoration, so the link's name is "gmt", the visible word
// (WCAG 2.2 SC 2.5.3). The styles live in gmt-shell.css.
// `.gmt-app-title` puts the name and the smaller version on one text baseline;
// side by side in the header's centred row, the version would float above it.
import { gmtVersion } from "~/generated/versions";

const { siteTitleHref } = Astro.locals.starlightRoute;
---

<span class="gmt-app-title">
  <a href={siteTitleHref} class="site-title sl-flex" translate="no">
    <span class="gmt-app-slash" aria-hidden="true">/</span>
    <span>gmt</span>
  </a>
  <span class="gmt-app-version" translate="no">v{gmtVersion}</span>
</span>

<style>
  @layer starlight.core {
    .site-title {
      align-items: center;
      text-decoration: none;
      white-space: nowrap;
      min-inline-size: 0;
    }
  }
</style>
