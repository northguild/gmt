---
// Override of Starlight's mobile menu footer. Below `md` the header's right-hand group is
// hidden, so the Dox chat link would be unreachable; it sits here, before the social icons
// and the theme select. Same link, label and current-page state as the header button.
import LanguageSelect from "virtual:starlight/components/LanguageSelect";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
import ButtonLink from "./ButtonLink.astro";
import DoxMark from "./DoxMark.astro";
import { stripBase, withBase } from "~/lib/site";

const onDox = stripBase(Astro.url.pathname).replace(/\/$/, "") === "/dox";
---

<div class="mobile-preferences sl-flex">
  <div class="social-icons">
    <ButtonLink
      href={withBase("/dox/")}
      class="gmt-ask-dox-link"
      label="Chat with Dox"
      title="Chat with Dox"
      aria-current={onDox ? "page" : undefined}
    >
      <DoxMark id="menu" />
    </ButtonLink>
    <SocialIcons />
  </div>
  <ThemeSelect />
  <LanguageSelect />
</div>

<style>
  @layer starlight.core {
    .social-icons {
      display: flex;
      margin-inline-end: auto;
      gap: 1rem;
      align-items: center;
      padding-block: 1rem;
    }

    .mobile-preferences {
      justify-content: space-between;
      flex-wrap: wrap;
      border-block-start: 1px solid var(--sl-color-gray-6);
      column-gap: 1rem;
      padding: 0.5rem 0;
    }
  }
</style>
