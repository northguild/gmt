---
/**
 * ID Timestamp Decoder widget (CORE-56).
 *
 * One identifier read by all five decoders: the hero names the format that reads it,
 * and the table shows every call and what it returned.
 *
 * **The markup and the wiring both live in `lib/id-timestamp-decoder-mount.ts`**,
 * so the chat rail mounts the same widget this page server-renders.
 */
import { renderIdTimestampDecoderTemplate } from "../lib/id-timestamp-decoder-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane`. Default `false`, the safe direction for a
 * reference page that embeds the widget.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderIdTimestampDecoderTemplate();
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountIdTimestampDecoder } from "../lib/id-timestamp-decoder-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    const seed = seedFromLocation("iddecode");
    document
      .querySelectorAll<HTMLElement>(".gmt-id-timestamp-decoder")
      .forEach((el) => {
        mountIdTimestampDecoder(el, seed, new AbortController().signal).catch(
          (error) => showUnavailable(el, error),
        );
      });
  }
</script>
