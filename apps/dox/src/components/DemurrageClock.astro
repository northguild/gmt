---
/**
 * Demurrage Clock widget (INT-14).
 *
 * A container's events, and the four clocks that run between them: demurrage,
 * detention, storage and the merged clock. `demurrageClock` is called once for
 * each clock, and the widget draws the four intervals under one rail of events,
 * over the terminal's local days. The terminal clock is a display zone, not an
 * argument.
 *
 * **The markup and the wiring both live in `lib/demurrage-clock-mount.ts`**,
 * so the chat rail mounts the same widget this page server-renders.
 */

import { renderDemurrageClockTemplate } from "../lib/demurrage-clock-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane` and drop the max-width of every
 * `.sl-container` inside `main`. The marker goes on a wrapper here rather than
 * inside `renderTemplate()` so the mount's markup stays byte-identical and
 * `scripts/html-diff.mjs` sees the widget itself as unchanged.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderDemurrageClockTemplate("demurrage-clock");
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountDemurrageClock } from "../lib/demurrage-clock-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    /* A `?w=demclock&wa=` permalink seeds the widget with the values it names;
       see lib/widget-permalink.ts. Absent or malformed, the widget opens on its
       first preset. */
    const seed = seedFromLocation("demclock");
    document
      .querySelectorAll<HTMLElement>('[data-widget="demurrage-clock"]')
      .forEach((el) => {
        mountDemurrageClock(el, seed, new AbortController().signal).catch(
          (error) => showUnavailable(el, error),
        );
      });
  }
</script>
