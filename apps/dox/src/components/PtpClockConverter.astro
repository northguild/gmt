---
/**
 * PTP Clock Converter widget (IOT-101).
 *
 * A PTP timestamp (TAI seconds and nanoseconds) read as UTC by `ptpToUtc` with the announced
 * `currentUtcOffset`, checked against the leap-second table with `taiMinusUtc`, and written back
 * by `utcToPtp`.
 *
 * **The markup and the wiring both live in `lib/ptp-clock-converter-mount.ts`**,
 * so the chat rail mounts the same widget this page server-renders.
 */

import { renderPtpClockConverterTemplate } from "../lib/ptp-clock-converter-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane`. Default `false`: a page that embeds the widget
 * in prose keeps the prose column. Only the tools page opts in. The marker goes
 * on a wrapper so the mount's markup stays byte-identical.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderPtpClockConverterTemplate("ptp-clock-converter", {}).value;
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountPtpClockConverter } from "../lib/ptp-clock-converter-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    /* A `?w=ptpclock&wa=` permalink seeds the widget with the values it names;
       see lib/widget-permalink.ts. Absent or malformed, the widget opens on
       its first preset. */
    const seed = seedFromLocation("ptpclock");
    document.querySelectorAll<HTMLElement>('[data-widget="ptp-clock-converter"]').forEach((el) => {
      mountPtpClockConverter(el, seed, new AbortController().signal).catch(
        (error) => showUnavailable(el, error),
      );
    });
  }
</script>
