---
/**
 * The NorthGuild mark, inlined.
 *
 * The paint lives in `gmt-primitives.css`, so the tokens reach the paths (an `<img>` is a
 * separate document). Each copy on a page takes its own gradient ids. `aria-hidden`: every
 * consumer supplies the accessible name (the header link labels itself "NorthGuild home").
 */
import { MARK_VIEW_BOX, markInner, nextMarkInstance } from "~/lib/ng-mark";

const instance = nextMarkInstance(Astro.request);
---

<svg
  class="gmt-ng-mark"
  viewBox={MARK_VIEW_BOX}
  aria-hidden="true"
  focusable="false"
  set:html={markInner(instance)}
/>
