---
/**
 * Duration Parser Bench widget (CORE-85).
 *
 * A duration string people write, read under GMT's published grammar: which
 * parser reads it, the ten duration fields, the compact form and the locale
 * words, then a minute-or-month table and a laytime table.
 *
 * **The markup and the wiring both live in `lib/duration-parser-bench-mount.ts`**,
 * so the chat rail mounts the same widget this page server-renders.
 */
import { renderDurationParserBenchTemplate } from "../lib/duration-parser-bench-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane`. Default `false`, the safe direction for a
 * reference page that embeds the widget.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderDurationParserBenchTemplate("duration-parser-bench").value;
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountDurationParserBench } from "../lib/duration-parser-bench-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    const seed = seedFromLocation("durationbench");
    document
      .querySelectorAll<HTMLElement>('[data-widget="duration-parser-bench"]')
      .forEach((el) => {
        mountDurationParserBench(el, seed, new AbortController().signal).catch(
          (error) => showUnavailable(el, error),
        );
      });
  }
</script>
