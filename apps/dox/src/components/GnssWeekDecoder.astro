---
/**
 * GNSS Week Decoder widget (MAR-16).
 *
 * A broadcast week, a RINEX week or a UTC instant, read on every era and every
 * counter. `gnssWeekToUtc`, `rinexWeekToUtc`, `utcToGnssWeek` and
 * `utcToRinexWeek` give every instant and week; the tool draws them.
 *
 * **The markup and the wiring both live in `lib/gnss-week-decoder-mount.ts`**,
 * so the chat rail mounts the same widget this page server-renders.
 */

import { renderGnssWeekDecoderTemplate } from "../lib/gnss-week-decoder-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane` and drop the max-width of every
 * `.sl-container` inside `main`. The marker goes on a wrapper here rather than
 * inside `renderTemplate()` so the widget's own markup is the same on a page
 * and in the chat rail.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderGnssWeekDecoderTemplate("gnss-week-decoder", {}).value;
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountGnssWeekDecoder } from "../lib/gnss-week-decoder-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    /* A `?w=gnssweek&wa=` permalink seeds the widget with the values it names;
       see lib/widget-permalink.ts. Absent or malformed, the widget opens on its
       first preset. */
    const seed = seedFromLocation("gnssweek");
    document
      .querySelectorAll<HTMLElement>('[data-widget="gnss-week-decoder"]')
      .forEach((el) => {
        mountGnssWeekDecoder(el, seed, new AbortController().signal).catch(
          (error) => showUnavailable(el, error),
        );
      });
  }
</script>
