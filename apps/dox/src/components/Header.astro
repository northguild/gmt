---
// Override of Starlight's Header. It adds two things to Starlight's own layout:
// the NorthGuild link (the mark and wordmark) before the "/ gmt" site title, which
// leads back to northguild.dev in the same tab; and a "Chat with Dox"
// link in the right-hand group, so the /dox chat is reachable from every page.
// Both are plain links with no JavaScript: no page but /dox hydrates React.
//
// The bar is northguild.dev's: the NorthGuild link at the left and GitHub and
// Discord at the far right sit on the same pixels on both sites, so going from
// one to the other changes only what lies between them. The right-hand group
// reads Dox, the theme, then GitHub and Discord.
//
// Structure copied from @astrojs/starlight/components/Header.astro. The
// NorthGuild link, the `<ButtonLink>` in `right-group`, the order of the
// group and the search box's place at the right are ours; the social and
// theme controls are Starlight's.
import config from "virtual:starlight/user-config";

import LanguageSelect from "virtual:starlight/components/LanguageSelect";
import Search from "virtual:starlight/components/Search";
import SiteTitle from "virtual:starlight/components/SiteTitle";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
import ButtonLink from "./ButtonLink.astro";
import DoxMark from "./DoxMark.astro";
import EscLayers from "./EscLayers.astro";
import NorthGuildMark from "./NorthGuildMark.astro";
import { LANDING_URL, stripBase, withBase } from "~/lib/site";

const onDox = stripBase(Astro.url.pathname).replace(/\/$/, "") === "/dox";

const shouldRenderSearch =
  config.pagefind ||
  config.components.Search !== "@astrojs/starlight/components/Search.astro";
---

<div class="header gmt-theme-dark">
  <div class="title-wrapper sl-flex">
    {/* Same site, one level up, so a plain same-tab link, not `ButtonLink`
        (which opens an absolute URL in a new tab and draws a chip). */}
    {/* The name starts with the visible text (WCAG 2.2 SC 2.5.3). */}
    <a href={LANDING_URL} class="gmt-ng-link gmt-sonar-focus" aria-label="NorthGuild home">
      <NorthGuildMark />
      <span class="gmt-ng-wordmark">NorthGuild</span>
    </a>
    <SiteTitle />
  </div>
  <div class="sl-flex print:hidden search-slot">
    {shouldRenderSearch && <Search />}
  </div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <div class="sl-flex social-icons">
      {/* The Dox crystal itself is the button — same mark the chat uses for
          every Dox turn and for its empty state, so the thing you click is
          the thing that answers you. Icon-only: `label` supplies the
          accessible name, `title` the hover tooltip. Lives in the same
          flex group as SocialIcons so it shares one gap value instead of
          stacking `right-group`'s gap on top of `social-icons`' own. */}
      <ButtonLink
        href={withBase("/dox/")}
        class="gmt-ask-dox-link"
        label="Chat with Dox"
        title="Chat with Dox"
        aria-current={onDox ? "page" : undefined}
      >
        <DoxMark id="header" />
      </ButtonLink>
      <ThemeSelect />
      <LanguageSelect />
      <SocialIcons />
    </div>
  </div>
</div>
<EscLayers />

<style>
  @layer starlight.core {
    .header {
      display: flex;
      gap: var(--sl-nav-gap);
      justify-content: space-between;
      align-items: center;
      block-size: 100%;
    }

    /* The wordmark's type is set here only so `ch` reads in it: "NorthGuild", the slash and
       the app name sit half a `0` apart, as in every NorthGuild app's header. */
    .title-wrapper {
      align-items: center;
      gap: 0.5ch;
      font-family: var(--gmt-font-display);
      font-size: var(--gmt-wordmark-size);
      overflow: clip;
      padding: 0.25rem;
      margin: -0.25rem;
      min-inline-size: 0;
    }

    .right-group,
    .social-icons {
      gap: 1rem;
      align-items: center;
    }

    /* The theme toggle's wrapper is an inline element, which set the button on the text
       baseline, 2 px above the row's centre. As a flex box it centres like its neighbours. */
    .social-icons > :global(starlight-theme-select) {
      display: flex;
    }

    /* On every page the search box sits at the right, just before the icons, at Starlight's
       22rem cap, as on northguild.dev. The middle column takes the slack, and the box gives
       way first when the bar runs short. */
    @media (width >= 50rem) {
      .header {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-content: center;
      }

      .search-slot {
        justify-content: end;
        min-inline-size: 0;
      }
    }
  }
</style>
