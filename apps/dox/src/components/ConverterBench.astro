---
/**
 * Converter + format bench + regex tester widget.
 *
 * Three sections sharing the same card/section/controls/output chrome as
 * DstInspector.astro and IntervalVisualizer.astro (styles/gmt-widget.css):
 * 1. Zone-to-zone conversion via convertZonedToZoned
 * 2. formatZonedToParts + formatRelativeZoned with locale switching
 * 3. Regex tester running input against all 22 exported regex consts
 *
 * **The markup and the wiring both live in `lib/converter-bench-mount.ts`.**
 * DOX-C3b mounts this same widget into the chat rail, and a rail cannot
 * instantiate an Astro component — so one `renderConverterTemplate()` serves
 * both surfaces, and this page still server-renders it. `scripts/html-diff.mjs`
 * asserts the built markup is unchanged by that move.
 */
import { renderConverterTemplate } from "../lib/converter-bench-mount";
---

<Fragment set:html={renderConverterTemplate()} />

<script>
  import { mountConverterBench } from "../lib/converter-bench-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  /* One mount per instance on the page. The rail passes a real AbortSignal;
     here nothing ever unmounts, so a never-aborted controller is honest about
     that rather than pretending there is a lifecycle to manage. */
  if (typeof window !== "undefined") {
    /* A `?w=&wa=` permalink seeds the widget with the state the link names —
       see lib/widget-permalink.ts. Absent or malformed, this is `{}` and the
       widget opens on its defaults, exactly as before. */
    const seed = seedFromLocation("converter");
    document.querySelectorAll<HTMLElement>(".gmt-converter").forEach((el) => {
      void mountConverterBench(el, seed, new AbortController().signal);
    });
  }
</script>
