---
/** Grid-cell wrapper for the landing's below-hero section grid (see
 * .gmt-home-grid in dox.css). Also carries the HUD bracket-corner treatment
 * so each panel reads as a targeting reticle. Each section is one page of
 * the hero's carousel: `page` is that page's name. */
interface Props {
	page?: string;
}

const { page } = Astro.props;
---

<div class="gmt-grid-section gmt-brackets" data-page={page}>
	<slot />
</div>
