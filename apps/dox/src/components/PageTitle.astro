---
import Default from "@astrojs/starlight/components/PageTitle.astro";
---
<div class="page-title-row">
  <Default />
  <copy-as-markdown></copy-as-markdown>
</div>

<script>
  class CopyAsMarkdown extends HTMLElement {
    connectedCallback() {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "copy-md";
      btn.textContent = "Copy as Markdown";
      btn.addEventListener("click", async () => {
        const url = location.pathname.replace(/\/$/, "") + ".md";
        try {
          const res = await fetch(url);
          if (!res.ok) throw new Error(String(res.status));
          await navigator.clipboard.writeText(await res.text());
          flash("Copied");
        } catch { flash("Copy failed"); }
      });
      const flash = (t: string) => {
        btn.textContent = t;
        setTimeout(() => (btn.textContent = "Copy as Markdown"), 2000);
      };
      this.append(btn);
    }
  }
  customElements.define("copy-as-markdown", CopyAsMarkdown);
</script>

<style>
  .page-title-row { display: flex; align-items: center; gap: var(--mg-space-4); flex-wrap: wrap; }
  .copy-md {
    /* mirror .theme-toggle in ThemeSelect.astro — tokens only, no literals */
    font: inherit; font-size: 0.8rem;
    padding: 0.25rem 0.6rem;
    background: transparent;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: var(--mg-radius-sm);
    color: var(--sl-color-gray-2);
    cursor: pointer;
    transition: color var(--mg-duration-fast) var(--mg-easing),
                border-color var(--mg-duration-fast) var(--mg-easing);
  }
  .copy-md:hover { color: var(--sl-color-white); border-color: var(--sl-color-gray-2); }
</style>
