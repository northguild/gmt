---
// Override of Starlight's PageTitle that puts a page's industry tags under its
// title. A page declares `industries` (content.config.ts), and a directory index
// takes the union of the pages under it (route-data.ts). The splash page has no
// title row and so shows none.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import IndustryTags from './IndustryTags.astro';

const { industries } = Astro.locals.starlightRoute.entry.data;
---

<Default />
{industries && <IndustryTags industries={industries} />}
