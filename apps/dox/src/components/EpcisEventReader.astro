---
/**
 * EPCIS Event Reader widget (INT-14).
 *
 * The two required time fields of a GS1 EPCIS 2.0 event, `eventTime` and
 * `eventTimeZoneOffset`: the library reads both, the widget shows whether the
 * offset is stated, the instant and the local clock, the same moment on a UTC
 * day rail and a local day rail, and the fields written back.
 *
 * **The markup and the wiring both live in `lib/epcis-event-reader-mount.ts`**,
 * so the chat rail mounts the same widget this page server-renders.
 */

import { renderEpcisEventReaderTemplate } from "../lib/epcis-event-reader-mount";

/**
 * `fullbleed` lets the page say the widget may use the whole main pane. It adds
 * `data-tools-fullbleed`, the self-declaring marker that dox.css's two `:has()`
 * rules read to widen `.main-pane` and drop the max-width of every
 * `.sl-container` inside `main`. That is all the marker does: how the prose
 * around the widget is laid out is ToolLayout.astro's job, not this one's.
 *
 * Default `false`, which is the safe direction: a page that embeds the widget
 * in prose keeps the prose column. Only the tools page opts in. The marker goes
 * on a wrapper here rather than inside `renderTemplate()`
 * so the mount's markup stays byte-identical and `scripts/html-diff.mjs` sees
 * the widget itself as unchanged.
 */
interface Props {
  fullbleed?: boolean;
}

const { fullbleed = false } = Astro.props;
const html = renderEpcisEventReaderTemplate();
---

{
  fullbleed ? (
    <div data-tools-fullbleed set:html={html} />
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  import { mountEpcisEventReader } from "../lib/epcis-event-reader-mount";
  import { showUnavailable } from "../lib/widget-mount";
  import { seedFromLocation } from "../lib/widget-permalink";

  if (typeof window !== "undefined") {
    /* A `?w=epcis&wa=` permalink seeds the widget with the values it names; see
       lib/widget-permalink.ts. Absent or malformed, the widget opens on its
       first preset. */
    const seed = seedFromLocation("epcis");
    document
      .querySelectorAll<HTMLElement>(".gmt-epcis-event-reader")
      .forEach((el) => {
        mountEpcisEventReader(el, seed, new AbortController().signal).catch(
          (error) => showUnavailable(el, error),
        );
      });
  }
</script>
