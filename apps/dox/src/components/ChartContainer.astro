---
interface Props {
  svg: string;
  title?: string;
  caption?: string;
}

const { svg, title, caption } = Astro.props;
---

<div class="gmt-chart-container">
  {title && <h3 class="gmt-chart-title">{title}</h3>}
  <div class="gmt-chart gmt-glass" set:html={svg} />
  {caption && <p class="gmt-chart-caption">{caption}</p>}
</div>
