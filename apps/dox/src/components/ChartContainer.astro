---
import {
  BAR_CHARTS,
  type BarChartId,
  type BarGradient,
} from "../lib/why-gmt-charts";

/**
 * One selectable view of a chart, e.g. "One run" vs "CI executions". Prose that belongs to one
 * view goes in the slot `after-<id>`, and is shown and hidden with it.
 */
interface ChartView {
  id: string;
  label: string;
  svg: string;
  chart?: BarChartId;
  caption?: string;
}

interface Props {
  /** Single-view charts: the static SVG. Ignored when `views` is given. */
  svg?: string;
  title?: string;
  caption?: string;
  /** A bar chart to mount live over the static `svg`, adding the hover tooltip. */
  chart?: BarChartId;
  /** Two or more views behind a toggle. The first is shown by default; each keeps its caption. */
  views?: readonly ChartView[];
  /** Accessible name for the toggle group. */
  toggleLabel?: string;
}

const { svg, title, caption, chart, views, toggleLabel } = Astro.props;

const panels: readonly ChartView[] =
  views && views.length > 0
    ? views
    : [{ id: "default", label: "", svg: svg ?? "", chart, caption }];
const hasToggle = panels.length > 1;

const afterSlots = await Promise.all(
  panels.map((panel) =>
    Astro.slots.has(`after-${panel.id}`)
      ? Astro.slots.render(`after-${panel.id}`)
      : undefined,
  ),
);

// Every view's gradients, once each: a hidden view's live mount still paints with them.
const gradients: BarGradient[] = [
  ...new Map(
    panels
      .flatMap((panel) => (panel.chart ? BAR_CHARTS[panel.chart].gradients : []))
      .map((g) => [g.id, g] as const),
  ).values(),
];
---

<div class="gmt-chart-container" data-gmt-chart-views={hasToggle ? "" : undefined}>
  {title && <h3 class="gmt-chart-title">{title}</h3>}
  {
    hasToggle && (
      <div
        class="gmt-chart-toggle not-content"
        role="group"
        aria-label={toggleLabel ?? "Chart view"}
      >
        {panels.map((panel, index) => (
          <button
            type="button"
            class="gmt-chart-toggle__button"
            data-gmt-chart-view={panel.id}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            {panel.label}
          </button>
        ))}
      </div>
    )
  }
  {
    gradients.length > 0 && (
      <svg class="gmt-chart-defs" aria-hidden="true" focusable="false">
        <defs>
          {gradients.map((g) => (
            <linearGradient id={g.id} x1="0" y1="0" x2="1" y2="1">
              <stop
                offset="0"
                style={`stop-color: var(--gmt-${g.hue}); stop-opacity: ${g.top}`}
              />
              <stop
                offset="1"
                style={`stop-color: var(--gmt-${g.hue}); stop-opacity: ${g.bottom}`}
              />
            </linearGradient>
          ))}
        </defs>
      </svg>
    )
  }
  {
    panels.map((panel, index) => (
      <div
        class="gmt-chart-view"
        data-gmt-chart-panel={panel.id}
        hidden={index === 0 ? undefined : true}
      >
        <div
          class="gmt-chart gmt-glass"
          data-gmt-chart={panel.chart}
          set:html={panel.svg}
        />
        {panel.caption && <p class="gmt-chart-caption">{panel.caption}</p>}
        {afterSlots[index] && (
          <div class="gmt-chart-after" set:html={afterSlots[index]} />
        )}
      </div>
    ))
  }
</div>

<script>
  import { mountChart } from "@tanstack/charts/dom";
  import { tooltip } from "@tanstack/charts/tooltip";
  import { BAR_CHARTS, isBarChartId } from "../lib/why-gmt-charts";

  // mountChart appends to its container rather than replacing it, so the build-time SVG is
  // cleared first. A host inside a hidden view is left as its static SVG until the view is first
  // shown: mounted at zero width it would lay out wrongly.
  function mount(host: HTMLElement): void {
    const id = host.dataset.gmtChart;
    if (!isBarChartId(id) || host.dataset.gmtChartMounted === "true") return;
    const chart = BAR_CHARTS[id];
    host.replaceChildren();
    mountChart(host, {
      definition: chart.definition(tooltip) as unknown as Parameters<
        typeof mountChart
      >[1]["definition"],
      ariaLabel: chart.ariaLabel,
      aspectRatio: chart.width / chart.height,
    });
    host.dataset.gmtChartMounted = "true";
  }

  for (const host of document.querySelectorAll<HTMLElement>("[data-gmt-chart]")) {
    if (!host.closest("[hidden]")) mount(host);
  }

  for (const container of document.querySelectorAll<HTMLElement>(
    "[data-gmt-chart-views]",
  )) {
    const buttons = container.querySelectorAll<HTMLButtonElement>(
      "[data-gmt-chart-view]",
    );
    const panels = container.querySelectorAll<HTMLElement>(
      "[data-gmt-chart-panel]",
    );
    for (const button of buttons) {
      button.addEventListener("click", () => {
        const view = button.dataset.gmtChartView;
        for (const other of buttons) {
          other.setAttribute(
            "aria-pressed",
            other === button ? "true" : "false",
          );
        }
        for (const panel of panels) {
          const shown = panel.dataset.gmtChartPanel === view;
          panel.hidden = !shown;
          if (shown) {
            for (const host of panel.querySelectorAll<HTMLElement>(
              "[data-gmt-chart]",
            )) {
              mount(host);
            }
          }
        }
      });
    }
  }
</script>
