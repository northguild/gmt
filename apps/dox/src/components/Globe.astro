---
/**
 * DOX-E1a — interactive globe island.
 *
 * Renders static chrome (heading, caption, empty stage + clock panel) so the
 * page is fully readable before any script runs. An IntersectionObserver
 * lazy-imports the mount module (which pulls d3-geo, world-atlas and the
 * @js-temporal polyfill) only once the stage scrolls into view.
 *
 * **The markup and the wiring both live in `lib/globe-mount.ts`.** DOX-C3b
 * mounts this same globe into the chat rail, and a rail cannot instantiate an
 * Astro component. Consolidating them also fixed a live inconsistency: this
 * file's markup carried `id="globe-stage"` while `mountGlobe` looks up
 * `[data-role="stage"]`, so the two had already drifted into disagreement about
 * the same widget. There is one template now, and it emits both.
 */
import { renderGlobeTemplate } from "../lib/globe-mount";

interface Props {
  heading?: string;
  caption?: string;
  /** Omits the internal heading/caption when embedded in HeroGlobe, whose
   * own title/tagline already carries that role. */
  embedded?: boolean;
}
const { heading, caption, embedded = false } = Astro.props;
---

<Fragment set:html={renderGlobeTemplate({ heading, caption, embedded })} />

<script>
  import { mountGlobe } from "../lib/globe-mount";

  /* Deferred until the stage is near the viewport: the mount pulls d3-geo,
     world-atlas and the Temporal polyfill, and this component sits on the
     landing page. The rail mounts eagerly instead — a reader who asked for a
     globe is already looking at it. */
  const stage = document.querySelector<HTMLElement>('[data-role="stage"]');
  const root = stage?.closest<HTMLElement>(".gmt-globe") ?? null;

  if (root && stage) {
    let started = false;
    const start = () => {
      if (started) return;
      started = true;
      void mountGlobe(root, {}, new AbortController().signal);
    };

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            observer.disconnect();
            start();
          }
        },
        { rootMargin: "200px" },
      );
      observer.observe(stage);
    } else {
      start();
    }
  }
</script>
